// Cytolab 2.0 — Prisma schema
// Phase 1: auth & identity (Lab, Account, Workspace, User, Role, Permission, AuthAttempt)
// Phase 2: lab intake (Patient, ClientType, Client, Requisition, Record, Specimen, Therapy, RecordStatusEvent)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Enums ----

enum Gender {
  Male
  Female
}

enum ClientTypeEnum {
  Doctor
  Laboratory
}

enum SpecimenType {
  URINE
  CSF
  PLEURAL_FLD
  BREAST_ASP
  JOINT_ASP
  SYNOVIAL_FLD
  OTHER
}

enum RecordStatus {
  Pending
  Submitted
  Processing
  Partial
  Completed
  Approved
  Billed
  Paid
  OnHold
  Disabled
  Failed
  Viewed
}

enum RequisitionStatus {
  Pending
  Active
  Completed
  Disabled
}

enum ResultSheetEventType {
  Authorized
  Deauthorized
  Reauthorized
}

// Legacy payment_type_enum.
enum PaymentType {
  Cash
  Cheque
  CreditCard
  DebitCard
  BankTransfer
}

enum BillStatus {
  Draft
  Issued
  PartiallyPaid
  Paid
}

// ---- F1: Multi-lab tenancy (every tenant-owned model carries labId) ----

model Lab {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  logoUrl      String?
  currency     String        @default("JMD")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  accounts     Account[]
  users        User[]
  workspaces   Workspace[]
  patients     Patient[]
  clientTypes  ClientType[]
  clients      Client[]
  requisitions Requisition[]
  records      Record[]
  specimens    Specimen[]
  requisitionLines   RequisitionLine[]
  recordStatusEvents RecordStatusEvent[]
  therapies          Therapy[]
  cabinets           Cabinet[]
  codeSheets         CodeSheet[]
  codeFindings       CodeFinding[]
  labCodes           LabCode[]
  resultSheets       ResultSheet[]
  resultEntries      ResultEntry[]
  resultLines        ResultLine[]
  reports            Report[]
  resultSheetEvents  ResultSheetEvent[]
  services           Service[]
  taxes              Tax[]
  bills              Bill[]
  billLines          BillLine[]
  billTaxes          BillTax[]
  payments           Payment[]
}

model Account {
  labId      String
  lab        Lab         @relation(fields: [labId], references: [id])
  id         String      @id @default(uuid())
  name       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  users      User[]
  workspaces Workspace[]
}

model Workspace {
  id           String        @id @default(uuid())
  labId        String
  lab          Lab           @relation(fields: [labId], references: [id])
  name         String
  accountId    String
  account      Account       @relation(fields: [accountId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  requisitions Requisition[]
  records      Record[]

  @@index([accountId])
}

model User {
  id                 String              @id @default(uuid())
  labId              String
  lab                Lab                 @relation(fields: [labId], references: [id])
  email              String
  passwordHash       String
  firstName          String
  lastName           String
  isActive           Boolean             @default(true)
  accountId          String
  account            Account             @relation(fields: [accountId], references: [id])
  workspaceId        String?
  workspace          Workspace?          @relation(fields: [workspaceId], references: [id])
  roles                  UserRole[]
  authAttempts           AuthAttempt[]
  recordStatusEvents     RecordStatusEvent[]
  authorizedResultSheets ResultSheet[]       @relation("ResultSheetAuthorizer")
  authoredReports        Report[]            @relation("ReportAuthor")
  resultSheetEvents      ResultSheetEvent[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@unique([labId, email])
  @@index([accountId])
  @@index([labId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid())
  code  String           @unique
  label String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuthAttempt {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// ---- Phase 2: Lab Intake ----

model Patient {
  id               String    @id @default(uuid())
  labId            String
  lab              Lab       @relation(fields: [labId], references: [id])
  registrationNo   String
  firstName        String
  lastName         String
  middleName       String?
  age              Int?
  phoneNumber      String?
  bloodGroup       String?
  gender           Gender?
  height           Float?
  weight           Float?
  email            String?
  dateOfBirth      DateTime?
  identityToken    String?
  motherMaidenName String?
  clientId         String?
  client           Client?   @relation(fields: [clientId], references: [id])
  records          Record[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([labId, registrationNo])
  @@index([labId])
  @@index([clientId])
}

model ClientType {
  id        String         @id @default(uuid())
  labId     String
  lab       Lab            @relation(fields: [labId], references: [id])
  name      String
  type      ClientTypeEnum
  clients   Client[]
  createdAt DateTime       @default(now())

  @@index([labId])
}

model Client {
  id           String        @id @default(uuid())
  labId        String
  lab          Lab           @relation(fields: [labId], references: [id])
  firstName    String
  lastName     String
  officeName   String?
  phoneNumber  String?
  mobileNumber String?
  officeNumber String?
  faxNumber    String?
  clientTypeId String?
  clientType   ClientType?   @relation(fields: [clientTypeId], references: [id])
  patients     Patient[]
  requisitions Requisition[]
  records      Record[]
  specimens    Specimen[]
  bills        Bill[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([labId])
}

model Requisition {
  id               String            @id @default(uuid())
  labId            String
  lab              Lab               @relation(fields: [labId], references: [id])
  status           RequisitionStatus @default(Pending)
  amount           Float             @default(0)
  entriesCompleted Boolean           @default(false)
  clientId         String?
  client           Client?           @relation(fields: [clientId], references: [id])
  workspaceId      String?
  workspace        Workspace?        @relation(fields: [workspaceId], references: [id])
  lines            RequisitionLine[]
  dateReceived     DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([labId])
  @@index([clientId])
}

model RequisitionLine {
  id            String      @id @default(uuid())
  labId         String
  lab           Lab         @relation(fields: [labId], references: [id])
  requisitionId String
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  isUrgent      Boolean     @default(false)
  isCompleted   Boolean     @default(false)
  description   String?
  amount        Float       @default(0)
  recordId      String?
  record        Record?     @relation(fields: [recordId], references: [id])

  @@index([labId])
  @@index([requisitionId])
  @@index([recordId])
}

model Record {
  id                String              @id @default(uuid())
  labId             String
  lab               Lab                 @relation(fields: [labId], references: [id])
  identifier        String
  clinicalDiagnosis String?
  labNumber         String?
  urgent            Boolean             @default(false)
  medicalEntry      String?
  billed            Boolean             @default(false)
  status            RecordStatus        @default(Pending)
  dateStatus        DateTime?
  patientId         String
  patient           Patient             @relation(fields: [patientId], references: [id])
  clientId          String?
  client            Client?             @relation(fields: [clientId], references: [id])
  workspaceId       String?
  workspace         Workspace?          @relation(fields: [workspaceId], references: [id])
  specimens         Specimen[]
  statusHistory     RecordStatusEvent[]
  requisitionLines  RequisitionLine[]
  therapy           Therapy?
  resultSheets      ResultSheet[]
  bills             Bill[]
  cabinetId         String?
  cabinet           Cabinet?            @relation(fields: [cabinetId], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([labId, identifier])
  @@index([labId])
  @@index([patientId])
  @@index([clientId])
  @@index([cabinetId])
  @@index([status])
}

// Append-only status history — feeds the client portal (F2) status timeline
model RecordStatusEvent {
  id        String       @id @default(uuid())
  labId     String
  lab       Lab          @relation(fields: [labId], references: [id])
  recordId  String
  record    Record       @relation(fields: [recordId], references: [id], onDelete: Cascade)
  status    RecordStatus
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  notes     String?
  createdAt DateTime     @default(now())

  @@index([labId])
  @@index([recordId])
  @@index([recordId, createdAt])
}

model Specimen {
  id           String       @id @default(uuid())
  labId        String
  lab          Lab          @relation(fields: [labId], references: [id])
  label        String?
  vialColour   String?
  antiserumA   String?
  antiserumB   String?
  rhSolution   String?
  type         SpecimenType
  bloodGroup   String?
  recordId     String
  record       Record       @relation(fields: [recordId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?      @relation(fields: [clientId], references: [id])
  dateReceived DateTime?
  resultEntries ResultEntry[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([labId])
  @@index([recordId])
}

model Therapy {
  id        String  @id @default(uuid())
  labId     String
  lab       Lab     @relation(fields: [labId], references: [id])
  recordId  String  @unique
  record    Record  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  hormone   Boolean @default(false)
  radiation Boolean @default(false)
  surgical  Boolean @default(false)
  other     String?

  @@index([labId])
}

// ---- Phase 3: Results & Coding ----

// Storage unit; records can be filed into a cabinet (GET /cabinet/records/:id).
model Cabinet {
  id         String   @id @default(uuid())
  labId      String
  lab        Lab      @relation(fields: [labId], references: [id])
  label      String
  identifier String?
  color      String?
  records    Record[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([labId])
}

// Reference list of diagnostic code sheets.
model CodeSheet {
  id           String   @id @default(uuid())
  labId        String
  lab          Lab      @relation(fields: [labId], references: [id])
  abbreviation String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([labId])
}

// Reference list of code findings (independent of CodeSheet, per legacy).
model CodeFinding {
  id           String   @id @default(uuid())
  labId        String
  lab          Lab      @relation(fields: [labId], references: [id])
  abbreviation String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([labId])
}

// Lab/region code.
model LabCode {
  id        String   @id @default(uuid())
  labId     String
  lab       Lab      @relation(fields: [labId], references: [id])
  code      String
  region    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId])
}

// A record's result sheet: filled with entries/lines, then authorized.
// Authorization (who/when) is the gate that allows a report to be released.
model ResultSheet {
  id             String        @id @default(uuid())
  labId          String
  lab            Lab           @relation(fields: [labId], references: [id])
  recordId       String
  record         Record        @relation(fields: [recordId], references: [id], onDelete: Cascade)
  viewed         Boolean       @default(false)
  // Authorization gate (Phase 3 critical rule): set by a user holding
  // resultsheet:authorize. Editing entries resets these (re-authorization required).
  authorized     Boolean       @default(false)
  authorizedAt   DateTime?
  authorizedById String?
  authorizedBy   User?         @relation("ResultSheetAuthorizer", fields: [authorizedById], references: [id])
  resultEntries  ResultEntry[]
  reports        Report[]
  events         ResultSheetEvent[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([labId])
  @@index([recordId])
}

// Append-only audit of authorization state changes (authorize / de-authorize on
// edit / re-authorize). The live gate stays on ResultSheet; this is the history,
// and will feed the client portal (F2) report timeline.
model ResultSheetEvent {
  id            String               @id @default(uuid())
  labId         String
  lab           Lab                  @relation(fields: [labId], references: [id])
  resultSheetId String
  resultSheet   ResultSheet          @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)
  type          ResultSheetEventType
  userId        String?
  user          User?                @relation(fields: [userId], references: [id])
  createdAt     DateTime             @default(now())

  @@index([labId])
  @@index([resultSheetId])
  @@index([resultSheetId, createdAt])
}

model ResultEntry {
  id            String       @id @default(uuid())
  labId         String
  lab           Lab          @relation(fields: [labId], references: [id])
  resultSheetId String
  resultSheet   ResultSheet  @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)
  specimenId    String?
  specimen      Specimen?    @relation(fields: [specimenId], references: [id])
  resultLines   ResultLine[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([labId])
  @@index([resultSheetId])
}

model ResultLine {
  id              String      @id @default(uuid())
  labId           String
  lab             Lab         @relation(fields: [labId], references: [id])
  resultEntryId   String
  resultEntry     ResultEntry @relation(fields: [resultEntryId], references: [id], onDelete: Cascade)
  abbreviation    String?
  result          String?
  findings        String?
  abnormalFinding Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([labId])
  @@index([resultEntryId])
}

// A released pathology report. Only created from an authorized result sheet.
model Report {
  id                  String      @id @default(uuid())
  labId               String
  lab                 Lab         @relation(fields: [labId], references: [id])
  resultSheetId       String
  resultSheet         ResultSheet @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)
  authorizerReference String?
  content             String?
  signature           String?
  digitalSignature    String?
  medicalEntry        String?
  writtenById         String?
  writtenBy           User?       @relation("ReportAuthor", fields: [writtenById], references: [id])
  releasedAt          DateTime    @default(now())
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([labId])
  @@index([resultSheetId])
}

// ---- Phase 4: Revenue ----
// All monetary amounts are integers in minor units (cents). Currency is the
// lab's (Lab.currency). Never store money as a float.

// Price-list entry a bill draws from.
model Service {
  id          String     @id @default(uuid())
  labId       String
  lab         Lab        @relation(fields: [labId], references: [id])
  name        String
  code        String
  description String?
  price       Int // minor units (cents)
  active      Boolean    @default(true)
  billLines   BillLine[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([labId])
}

// Tax rate stored as basis points (1% = 100 bps) — integer, no floats.
model Tax {
  id              String    @id @default(uuid())
  labId           String
  lab             Lab       @relation(fields: [labId], references: [id])
  name            String
  code            String?
  rateBasisPoints Int // basis points; 1% = 100
  isDefault       Boolean   @default(false)
  billTaxes       BillTax[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([labId])
}

// A bill for one lab case (Record), billed to a Client. Totals are computed at
// creation from snapshotted line/tax amounts and never recomputed from the
// live catalog.
model Bill {
  id          String     @id @default(uuid())
  labId       String
  lab         Lab        @relation(fields: [labId], references: [id])
  recordId    String
  record      Record     @relation(fields: [recordId], references: [id])
  clientId    String?
  client      Client?    @relation(fields: [clientId], references: [id])
  referenceNo String
  status      BillStatus @default(Draft)
  subtotal    Int        @default(0) // minor units (cents) — sum of line amounts
  taxTotal    Int        @default(0) // minor units (cents) — sum of applied tax amounts
  total       Int        @default(0) // minor units (cents) — subtotal + taxTotal
  amountPaid  Int        @default(0) // minor units (cents) — Σ of payments, recomputed on each payment
  dueDate     DateTime?
  viewed      Boolean    @default(false)
  lines       BillLine[]
  taxes       BillTax[]
  payments    Payment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([labId])
  @@index([recordId])
  @@index([clientId])
  @@index([status])
}

// A bill line; price + service identity are snapshotted at bill time so later
// catalog edits don't rewrite historical bills.
model BillLine {
  id          String   @id @default(uuid())
  labId       String
  lab         Lab      @relation(fields: [labId], references: [id])
  billId      String
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  serviceName String // snapshot of Service.name at bill time
  serviceCode String? // snapshot of Service.code at bill time
  description String?
  quantity    Int
  unitPrice   Int // minor units (cents) — snapshot of Service.price at bill time
  amount      Int // minor units (cents) — quantity * unitPrice
  createdAt   DateTime @default(now())

  @@index([labId])
  @@index([billId])
}

// A tax applied to a bill, snapshotted (name + rate) at bill time.
model BillTax {
  id              String   @id @default(uuid())
  labId           String
  lab             Lab      @relation(fields: [labId], references: [id])
  billId          String
  bill            Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  taxId           String?
  tax             Tax?     @relation(fields: [taxId], references: [id])
  name            String // snapshot of Tax.name
  rateBasisPoints Int // snapshot of Tax.rateBasisPoints
  amount          Int // minor units (cents) — round(subtotal * rate / 10000)
  createdAt       DateTime @default(now())

  @@index([labId])
  @@index([billId])
}

// A payment settling (part of) a bill. Multiple payments per bill = partial
// settlement. `verified` is an audit flag, not a settlement gate.
model Payment {
  id           String      @id @default(uuid())
  labId        String
  lab          Lab         @relation(fields: [labId], references: [id])
  billId       String
  bill         Bill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount       Int // minor units (cents)
  type         PaymentType
  referenceNo  String?
  bank         String?
  chequeNumber String?
  verified     Boolean     @default(false)
  datePaid     DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([labId])
  @@index([billId])
}
