model SupportAttachment {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  fileName  String
  fileUrl   String
  fileSize  Int
  createdAt DateTime      @default(now())

  @@index([ticketId])
}

model MaintenanceWindow {
  id              String         @id @default(cuid())
  labId           String
  title           String
  description     String?
  scheduledAt     DateTime
  durationMinutes Int
  affectedSystems String[] // e.g. ["API", "Database", "Portal"]
  status          String         @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  notifyUsers     Boolean        @default(true)
  ticketId        String?
  ticket          SupportTicket? @relation(fields: [ticketId], references: [id])
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([labId, scheduledAt])
}

model SystemAnnouncement {
  id          String    @id @default(cuid())
  labId       String
  title       String
  body        String
  type        String    @default("INFO") // INFO, WARNING, CRITICAL
  isActive    Boolean   @default(true)
  showFrom    DateTime  @default(now())
  showUntil   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([labId, isActive])
}

// ============================================================================
// Enterprise Security (Phase 1–5)
// Auth hardening, session/device tracking, login protection, MFA, and the
// Security Center. See docs/SECURITY.md for the operational runbook.
// ============================================================================

/// Opaque refresh tokens (hashed) — one row per active device session. Rotated
/// on every /auth/refresh; revoked on logout.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique // SHA-256 hash of the opaque token, never the raw value
  deviceId  String
  ipAddress String
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

/// A tracked login session (one per device). Powers the Security Center session
/// list, idle timeout, and impossible-travel detection.
model UserSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String
  deviceName   String?
  browser      String?
  os           String?
  ipAddress    String
  country      String?
  city         String?
  lat          Float?
  lng          Float?
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

/// Every login attempt (success or failure) — the audit source for brute-force,
/// credential-stuffing, and the login-history screen. Not tenant-scoped: attempts
/// are recorded before a lab is resolved.
model LoginAttempt {
  id         String   @id @default(cuid())
  email      String?
  username   String?
  ipAddress  String
  userAgent  String?
  browser    String?
  os         String?
  device     String?
  country    String?
  city       String?
  lat        Float?
  lng        Float?
  success    Boolean
  failReason String?
  userId     String?
  createdAt  DateTime @default(now())

  @@index([ipAddress])
  @@index([email])
  @@index([createdAt])
}

/// An active or historical account lock. Auto-expiring locks set autoUnlockAt;
/// permanent locks leave it null and require an admin unlock.
model AccountLock {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason       String
  lockedAt     DateTime  @default(now())
  lockedById   String?
  unlockedAt   DateTime?
  unlockedById String?
  autoUnlockAt DateTime?
}

/// A device the user has completed MFA on — future logins from it skip MFA
/// (unless impossible travel is detected).
model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String
  deviceName String?
  browser    String?
  os         String?
  ipAddress  String?
  trustedAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@unique([userId, deviceId])
}

/// Per-user MFA configuration. totpSecret is AES-256-GCM encrypted; backupCodes
/// are hashed. A missing row means MFA is not configured.
model MfaConfig {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totpEnabled  Boolean  @default(false)
  totpSecret   String? // encrypted
  emailEnabled Boolean  @default(false)
  backupCodes  String[] // hashed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A pending MFA challenge (email OTP or step-up). code is hashed for email OTP.
model MfaChallenge {
  id        String    @id @default(cuid())
  userId    String
  type      String // 'totp' | 'email'
  code      String? // hashed, for email OTP
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// The last N password hashes per user, enforcing no-reuse on password change.
model PasswordHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// An IP denylist entry. Auto-added on credential stuffing (24h expiry) or added
/// manually by an admin (optionally permanent).
model BlockedIp {
  id          String    @id @default(cuid())
  ipAddress   String    @unique
  reason      String
  blockedAt   DateTime  @default(now())
  blockedById String?
  expiresAt   DateTime?
  permanent   Boolean   @default(false)
}

/// A raised security signal surfaced in the Security Center. labId/userId are
/// nullable because some signals (e.g. credential stuffing) are pre-auth.
model SecurityAlert {
  id           String    @id @default(cuid())
  labId        String?
  userId       String?
  type         String // IMPOSSIBLE_TRAVEL | BRUTE_FORCE | CREDENTIAL_STUFFING | SUSPICIOUS_IP | AFTER_HOURS | MASS_EXPORT
  severity     String // LOW | MEDIUM | HIGH | CRITICAL
  title        String
  detail       String
  ipAddress    String?
  resolved     Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime  @default(now())

  @@index([createdAt])
  @@index([resolved])
}

/// Global key/value system configuration (e.g. the password policy). Not
/// tenant-scoped — these are platform-wide settings.
model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── Knowledge Base (Resources) ──────────────────────────────────────────────

enum KbArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A grouping of knowledge-base articles. Lab-scoped (tenancy extension stamps
/// and filters labId automatically — never filter it by hand).
model KbCategory {
  id          String      @id @default(cuid())
  labId       String
  name        String
  description String?
  icon        String?
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  articles    KbArticle[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([labId])
}

/// A single Markdown knowledge-base article. `slug` is unique per lab.
model KbArticle {
  id             String          @id @default(cuid())
  labId          String
  categoryId     String
  category       KbCategory      @relation(fields: [categoryId], references: [id])
  title          String
  slug           String
  content        String // Markdown
  excerpt        String?
  status         KbArticleStatus @default(DRAFT)
  isPinned       Boolean         @default(false)
  viewCount      Int             @default(0)
  authorId       String
  lastEditedById String?
  tags           String[]
  attachments    KbAttachment[]
  feedback       KbFeedback[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  publishedAt    DateTime?

  @@unique([labId, slug])
  @@index([labId, status])
  @@index([labId, categoryId])
}

model KbAttachment {
  id        String    @id @default(cuid())
  articleId String
  article   KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  fileSize  Int
  createdAt DateTime  @default(now())
}

model KbFeedback {
  id        String    @id @default(cuid())
  articleId String
  article   KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String?
  helpful   Boolean
  comment   String?
  createdAt DateTime  @default(now())
}

// ---- Digital Requisition Portal (DRP) ----
// Clients assemble a batch of digital cytology requisition forms in the portal
// (manual entry or AI-scanned paper forms), sign, pay, and submit. On submit the
// forms become real Requisition/Record chains in the lab. Both models carry
// clientId so the portal tenancy layer can client-scope direct operations.

model RequisitionBatch {
  id               String                   @id @default(cuid())
  labId            String
  lab              Lab                      @relation(fields: [labId], references: [id])
  batchNumber      String                   @unique // BATCH-2026-XXXX
  clientId         String
  client           Client                   @relation(fields: [clientId], references: [id])
  submittedById    String
  status           BatchStatus              @default(DRAFT)
  totalForms       Int                      @default(0)
  totalAmountCents Int                      @default(0)
  paymentMethod    PaymentMethod?
  paymentStatus    PaymentStatus            @default(PENDING)
  paymentRef       String?
  paymentPaidAt    DateTime?
  notes            String?
  manifestUrl      String? // PDF manifest
  forms            DigitalRequisitionForm[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  submittedAt      DateTime?

  @@index([labId, status])
  @@index([clientId])
}

model DigitalRequisitionForm {
  id         String           @id @default(cuid())
  labId      String
  lab        Lab              @relation(fields: [labId], references: [id])
  clientId   String?
  client     Client?          @relation(fields: [clientId], references: [id])
  batchId    String
  batch      RequisitionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  formNumber Int // position in batch 1,2,3...

  // Scan data
  scanStatus    ScanStatus?
  rawScanUrl    String? // uploaded PDF/image
  extractedData Json? // raw OCR output
  ocrConfidence Float? // 0-1

  // Patient info
  patientName   String?
  patientDob    DateTime?
  hospRegNumber String?

  // Doctor/Lab info
  doctorName    String?
  doctorAddress String?

  // Specimen info
  specimenDate DateTime?
  specimenType String? // ENDOCERV_ASP | VAG_POOL | CERV_SCRAP | SPECIMEN_16

  // Clinical features
  routineCheck        Boolean?
  lmp                 String?
  lengthOfCycle       String?
  abnormalBleeding    Boolean?
  leucorrhoea         Boolean?
  specialType         String?
  noPregnancies       String?
  nowPregnant         Boolean?
  menopauseDate       DateTime?
  clinicalAppearance  String?
  pelvicAbnormalities String?
  otherClinicalData   String?
  clinicalDiagnosis   String?
  previousCytology    Boolean?

  // Therapy
  hormone      String?
  radiation    String?
  surgical     String?
  otherTherapy String?

  // Signature
  signatureDataUrl String? // base64 canvas signature
  signedAt         DateTime?
  signedByName     String?

  // Internal
  accessionNumber String? // assigned on submission
  requisitionId   String? // linked requisition after processing
  needsReview     Boolean @default(false)
  reviewNotes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId, batchId])
  @@index([clientId])
}

// ─── Ancillary & IHC Ordering (Phase 4.1A) ───────────────────────────────────
// A record-scoped ancillary / IHC work order — a new owner-controlled capability
// (Phase 4.1A). It records a REQUESTED dependency on a case. Order existence is
// not completion; completion is not a clinical conclusion. This model does NOT
// own the Record, Result Sheet, Sign-Out, Bethesda, Coding, Specimen, Slide,
// Report, or Requisition lifecycles — it only records the order.

enum AncillaryKind {
  IHC // immunohistochemistry
  SpecialStain // histochemical special stain
  Molecular // molecular / genetic assay
  Cytochemistry // cytochemical stain
  Other // other ancillary work (real, entered)
}

// State VOCABULARY only. B1 does NOT establish which transitions are legal —
// transition legality belongs to the owner service (B3). Cancelled and Completed
// are deliberately distinct; there is intentionally no separate rejected /
// resulted / reviewed state (an order is not a result and not a review).
enum AncillaryStatus {
  Ordered // requested, not yet started
  InProcess // work underway
  Completed // work finished — NOT a clinical conclusion
  Cancelled // withdrawn before completion
}

model AncillaryOrder {
  id       String @id @default(cuid())
  labId    String
  lab      Lab    @relation(fields: [labId], references: [id])
  recordId String
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  kind   AncillaryKind
  target String // real entered marker/antibody/stain name (never inferred)
  status AncillaryStatus @default(Ordered)

  // Recorded, never inferred: whether this dependency blocks sign-out. Whether to
  // warn vs. hard-block at sign-out is a later owner/UI concern (B4); here it is
  // only recorded data.
  blocksSignOut Boolean @default(true)

  // Requester provenance. Scalar-only actor id (matches the Record.assignedById /
  // QCFailureAlert.resolvedById precedent) to keep this schema checkpoint surgical
  // and avoid touching the User model; may be promoted to a User relation later.
  orderedById String?

  orderedAt   DateTime  @default(now()) // request time (also serves as creation time)
  updatedAt   DateTime  @updatedAt // last recorded change
  completedAt DateTime? // set only when status → Completed (truthful timestamp)
  notes       String? // free-text request/handling note (no structured payload/JSON)

  @@index([labId, status])
  @@index([recordId])
}

// ─── Screening Batch (Phase 4.2 — Screening Batch Management) ────────────────
// A cytotechnologist primary-screening batch: a persisted, screener-owned grouping
// of cases. `ScreeningBatchService` (added in C3) is the SOLE owner of this
// aggregate's lifecycle, membership, batch→screener assignment, and completion
// state (D-002/D-014). It references Record and Lab but writes ONLY its own tables;
// it never writes Record.status, Record.assignedTo* (workload), QC, AI, Result
// Sheet, or Sign-Out (D-004/D-019). Plan: docs/platform/OSIERI_SCREENING_BATCH_IMPLEMENTATION_PLAN.md (C1).

enum ScreeningBatchStatus {
  Draft // membership being assembled
  Ready // membership frozen, awaiting a screener
  Assigned // screener assigned, not yet started
  InScreening // screener working the batch
  Completed // every member case dispositioned by the screener — NOT a diagnosis/QC-pass/release
  Closed // administratively archived (terminal)
  Cancelled // withdrawn before completion (terminal)
}

// Per-case screening-workflow disposition — NEVER a clinical finding. The batch
// records only that a screener handled the case; Bethesda / Result Sheet owners
// hold the actual diagnosis (truthfulness, D-005/D-007).
enum ScreeningDisposition {
  Pending // not yet screened by the cytotechnologist
  Screened // screener completed a routine screen (unremarkable) — not a diagnosis
  Flagged // flagged for pathologist review
  QCSelected // selected for QC rescreen/rapid review (the QC act itself belongs to qc)
}

model ScreeningBatch {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id])

  batchNumber String // human label (e.g. SCR-2026-XXXX); assigned by the owner, unique per lab
  status      ScreeningBatchStatus @default(Draft)

  // Batch → screener (cytotechnologist) assignment. Distinct granularity from
  // workload's case→pathologist assignment (Record.assignedTo*); the batch NEVER
  // writes those fields. Scalar-only actor ids (AncillaryOrder.orderedById /
  // Record.assignedById precedent) keep this checkpoint surgical — the User model
  // is untouched; they may be promoted to User relations later.
  assignedToId String? // the screener
  assignedById String? // the manager who assigned
  assignedAt   DateTime?

  createdById String? // creator provenance (scalar-only)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime? // set only when status → InScreening (truthful)
  completedAt DateTime? // set only when status → Completed (truthful; screening only)
  closedAt    DateTime? // set only when status → Closed
  notes       String? // free-text batch note (no structured payload/JSON)

  cases ScreeningBatchCase[]

  @@unique([labId, batchNumber])
  @@index([labId, status])
  @@index([assignedToId])
}

model ScreeningBatchCase {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id])

  batchId  String
  batch    ScreeningBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  recordId String
  record   Record         @relation(fields: [recordId], references: [id], onDelete: Cascade)

  disposition  ScreeningDisposition @default(Pending)
  screenedById String? // scalar-only actor id (the screener who dispositioned)
  screenedAt   DateTime? // set only when disposition leaves Pending (truthful)
  notes        String?

  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([batchId, recordId]) // a case appears at most once within a batch
  @@index([labId])
  @@index([recordId])
  @@index([batchId, disposition])
}

// ============================================================================
// Program 2 · P2-1 — Enterprise Audit bounded context (append-only ledger).
// Binding authority: docs/architecture/AUDIT_EVENT_CONTRACT.md.
// Owned exclusively by the Audit module; NO domain owner may reference AuditEvent
// directly (enforced by audit-architecture.spec.ts). The scope column is deliberately
// named `scopeLabId`, NOT `labId`, so the global tenancy extension — which auto-scopes
// every model carrying a `labId` column — never forces a lab onto SYSTEM/CROSS_LAB
// events. The Audit owner performs its own scope filtering in the P2-6 query API.
// Enum values are SCREAMING_SNAKE registry/wire codes (not the PascalCase used by older
// domain enums) to match the contract document.
// ============================================================================

enum AuditCategory {
  AUTHENTICATION
  AUTHORIZATION
  PHI_ACCESS
  RECORD_LIFECYCLE
  CLINICAL_WORKFLOW
  ADMINISTRATIVE
  CONFIGURATION
  DATA_EXPORT
  SECURITY
  DATA_MAINTENANCE
  SYSTEM
}

enum AuditActorType {
  STAFF
  PORTAL
  SERVICE
  SYSTEM
  ANONYMOUS
}

enum AuditOrganizationScope {
  LAB
  SYSTEM
  CROSS_LAB
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
  ERROR
}

enum AuditSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

enum AuditDataClass {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  PHI
}

enum AuditRetentionClass {
  SHORT
  STANDARD
  EXTENDED
  PERMANENT
}

enum AuditDurabilityClass {
  CRITICAL_TRANSACTIONAL
  REQUIRED_DURABLE
  OPERATIONAL
}

model AuditEvent {
  // --- Identity (platform-owned; producers never set these) ---
  id            String   @id @default(cuid()) // eventId
  occurredAt    DateTime // when the fact happened (may precede recordedAt)
  recordedAt    DateTime @default(now()) // when the ledger persisted it
  sequence      BigInt? // per-chain monotonic order; assigned by the P2-4 chain-head, null until then
  schemaVersion Int      @default(1) // storage-envelope version
  eventVersion  Int // semantic payload version, resolved from the registry

  // --- Classification (resolved from the registry) ---
  category        AuditCategory
  severity        AuditSeverity
  phiIndicator    Boolean              @default(false)
  dataClass       AuditDataClass
  retentionClass  AuditRetentionClass
  durabilityClass AuditDurabilityClass

  // --- Actor (identifiers only; never a name/email) ---
  actorType         AuditActorType
  actorId           String?
  onBehalfOfActorId String?
  servicePrincipal  String?

  // --- Organization / scope (see class comment: scopeLabId, not labId) ---
  organizationScope AuditOrganizationScope
  scopeLabId        String? // required iff scope = LAB; absent for SYSTEM / CROSS_LAB
  organizationId    String?

  // --- Request context (OPTIONAL at the envelope level; policy is registry-driven) ---
  requestId     String?
  correlationId String?
  ipAddress     String?
  userAgent     String?
  deviceId      String?
  route         String?
  httpMethod    String?

  // --- Session context (OPTIONAL) ---
  sessionId   String?
  sessionKind String?

  // --- Resource (patientRef is an opaque pseudonymous token; no free-text field) ---
  resourceType       String
  resourceId         String?
  resourceLabId      String?
  parentResourceType String?
  parentResourceId   String?
  patientRef         String?

  // --- Action (verb lives ONLY here) + outcome ---
  actionCode String
  detailCode String?
  outcome    AuditOutcome
  statusCode Int?
  errorCode  String?
  reasonCode String?

  // --- Change evidence (names + hashes only; raw values prohibited) ---
  changedFields String[]
  beforeHash    String?
  afterHash     String?

  // --- Integrity (P2-4; INACTIVE in P2-1, explicit nullable — no tamper claim yet) ---
  chainId       String?
  prevHash      String?
  selfHash      String?
  hashAlgorithm String?

  // --- Producer attribution + typed metadata ---
  producerModule String
  executionId    String?
  metadata       Json? // typed/bounded per registry contract; validated at the write boundary

  // P2-4B: (chainId, sequence) uniquely identifies every chained event. Legacy pre-P2-4
  // rows carry chainId = NULL; Postgres treats NULL index keys as distinct (NULLS DISTINCT,
  // the PG16 default), so unlimited legacy NULL-chainId rows coexist under this standard
  // UNIQUE with no partial predicate. Allocation/wiring is P2-4C, not here.
  @@unique([chainId, sequence])
  @@index([scopeLabId, recordedAt])
  @@index([category, recordedAt])
  @@index([actorId, recordedAt])
  @@index([resourceType, resourceId])
  @@index([correlationId])
  @@index([recordedAt])
}

/// P2-4B — Audit chain head (integrity infrastructure; NOT yet allocated/wired).
/// One row per chain. `chainId` encodes the scope partition (e.g. "lab:<id>", "system",
/// "cross-lab") and is derived by the Audit owner from the trusted organization scope —
/// never producer-supplied. Deliberately named `chainId` (not `labId`) so it stays outside
/// the tenancy auto-scoping. In P2-4C this row is locked FOR UPDATE inside the append
/// transaction to allocate a gapless per-chain sequence and carry the prevHash forward.
model AuditChainHead {
  chainId      String   @id
  lastSequence BigInt
  lastSelfHash String
  updatedAt    DateTime @updatedAt
}

/// R-016b — an authorized, APPEND-ONLY seal for a FROZEN prior chain generation. A sealed generation
/// is not required to verify as a live chain; instead the integrity monitor proves it is UNCHANGED
/// since sealing by recomputing `snapshotDigest` (a full-generation fingerprint over every event) and
/// matching it here. There is deliberately NO update/delete path — seals are immutable, and the
/// monitor never creates them (sealing is an explicit, authorized, fail-closed operation).
model AuditChainSeal {
  chainId          String   @id
  reason           String
  sealedAt         DateTime @default(now())
  sealedBy         String?
  eventCount       Int
  terminalSequence BigInt
  terminalSelfHash String
  /// sha256 over EVERY event of the generation in canonical sequence order (canonical content + the
  /// stored selfHash of each). The AUTHORITATIVE immutability check — detects any interior-row change
  /// that the terminal fingerprint (count + terminal sequence/selfHash) cannot.
  snapshotDigest   String
}

// ─────────────────────────────────────────────────────────────────────────────
// PLATFORM BILLING — the platform invoicing a Lab as its customer.
// Distinct from Bill/BillLine/Payment (which is a lab billing ITS OWN clients
// for a case). Configured by a superuser in the control center; a daily cron
// generates invoices for labs whose billingDayOfMonth matches today.
// ─────────────────────────────────────────────────────────────────────────────

enum LabInvoiceStatus {
  Draft
  Sent
  Paid
  Overdue
  Void
}

/// One recurring-billing configuration per lab. The template line items live on
/// LabBillingItem. A flat monthly fee is simply a single line item.
model LabBillingProfile {
  id                String           @id @default(uuid())
  labId             String           @unique
  lab               Lab              @relation(fields: [labId], references: [id])
  active            Boolean          @default(false)
  // Day of month (1–28) the invoice auto-generates. Capped at 28 so it exists in
  // every month.
  billingDayOfMonth Int              @default(1)
  // Net terms: invoice is due this many days after it is issued.
  dueDays           Int              @default(14)
  // When true, generation marks the invoice Sent + notifies the lab immediately;
  // otherwise it lands as Draft for the superuser to review/send.
  autoSend          Boolean          @default(true)
  // Snapshot of the billing currency (defaults from Lab.currency at creation).
  currency          String           @default("JMD")
  notes             String?
  // Idempotency guard: the "YYYY-MM" period the cron last generated for.
  lastRunPeriod     String?
  lastRunAt         DateTime?
  items             LabBillingItem[]
  invoices          LabInvoice[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([active, billingDayOfMonth])
}

/// A recurring template line on a lab's billing profile. Copied (snapshotted)
/// onto each generated invoice's LabInvoiceLine rows.
model LabBillingItem {
  id          String            @id @default(uuid())
  labId       String
  lab         Lab               @relation(fields: [labId], references: [id])
  profileId   String
  profile     LabBillingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  description String
  quantity    Int               @default(1)
  // Unit price in minor units (cents). Never a float.
  unitPrice   Int               @default(0)
  sortOrder   Int               @default(0)

  @@index([labId])
  @@index([profileId])
}

/// A generated platform invoice billed to a lab.
model LabInvoice {
  id          String             @id @default(uuid())
  labId       String
  lab         Lab                @relation(fields: [labId], references: [id])
  profileId   String?
  profile     LabBillingProfile? @relation(fields: [profileId], references: [id])
  // Human invoice number, e.g. INV-202607-0001 (per-lab seeded sequence).
  number      String
  periodLabel String // "July 2026"
  periodStart DateTime
  periodEnd   DateTime
  status      LabInvoiceStatus   @default(Draft)
  currency    String
  // Amounts in minor units (cents). subtotal == total for now (no platform tax).
  subtotal    Int                @default(0)
  total       Int                @default(0)
  issueDate   DateTime           @default(now())
  dueDate     DateTime?
  sentAt      DateTime?
  paidAt      DateTime?
  voidedAt    DateTime?
  // "system" (cron) or a superuser userId.
  generatedBy String             @default("system")
  notes       String?
  lines       LabInvoiceLine[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([labId, number])
  @@index([labId])
  @@index([status])
  @@index([profileId])
}

/// A snapshot line on a generated invoice.
model LabInvoiceLine {
  id          String     @id @default(uuid())
  labId       String
  lab         Lab        @relation(fields: [labId], references: [id])
  invoiceId   String
  invoice     LabInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int        @default(1)
  unitPrice   Int        @default(0)
  amount      Int        @default(0)

  @@index([labId])
  @@index([invoiceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Program 5B · Stage B1 — Automated Ingestion: persistence & contracts.
// New models ONLY (no change to existing WSI tables). The tenancy extension
// auto-scopes both (they carry `labId`), so tenant isolation is structural.
// ─────────────────────────────────────────────────────────────────────────────

// B1 constrains source kind to the filesystem/watch-folder contract actually being
// implemented (local directory or a mounted/network share exposed as a filesystem path).
// Object-storage-prefix / scanner kinds are intentionally NOT added here (5B-later / 5C).
enum IngestionSourceKind {
  FILESYSTEM
  // P5C-C1 — additive: a remote DICOMweb endpoint (QIDO/WADO import transport; used from C3). NOTE:
  // PostgreSQL cannot DROP an enum value, so a C1 rollback may leave this value harmlessly present
  // (see the SlideDicomMetadata migration note). SCANNER is intentionally NOT added in C1.
  DICOMWEB
}

// Program 5C · C1 — the truthful verdict of DICOM WSI conformance validation. Persisted on
// SlideDicomMetadata (for accepted VALID series) and echoed on the intake discovery for rejected input.
// VALID = a supported, conformant VL Whole Slide Microscopy Image series; UNSUPPORTED = well-formed but not
// a supported SOP class / transfer syntax; NONCONFORMANT = malformed / inconsistent required metadata.
enum DicomConformanceStatus {
  VALID
  UNSUPPORTED
  NONCONFORMANT
}

// Truthful intake state machine. Distinguishes discovery/matching/handoff/reconciliation
// concepts WITHOUT implying discovered=ingested, matched=processed, ingested=READY, or READY=PUBLISHED.
enum IngestionDiscoveryStatus {
  DISCOVERED // a source object/path has been observed
  STABILIZING // observed but not yet size/mtime-stable (partial write guard)
  MATCHED // uniquely matched to an authoritative record (not yet handed off)
  UNMATCHED // no authoritative accession match → reconciliation-required
  AMBIGUOUS // more than one authoritative candidate → reconciliation-required
  DUPLICATE // same bytes (sourceChecksum) already known in this lab → skipped
  INGESTED // handed off to the accepted 5A ingestion pipeline (slide+ingestion created)
  FAILED // terminal failure (checksum/unsupported/etc.) → reconciliation-required
  RECONCILED // a human resolved a non-automatic outcome (B4)
}

// P5C-C3 — the outbound-endpoint authentication scheme for a DICOMWEB source. A small enum (not a free-form
// string) so config is compile-time-validated and future schemes (OAuth2/mTLS) are explicit additive changes.
enum DicomWebAuthType {
  BEARER
  BASIC
}

// P5C-C4 — vendor-neutral scanner ADAPTER selection for an IngestionSource. An adapter is a translation/
// routing layer over the ACCEPTED transports (never a new transport/pipeline): FILESYSTEM_IMAGE + FILESYSTEM_DICOM
// require kind=FILESYSTEM; DICOMWEB requires kind=DICOMWEB (enforced in service code). Additive; null = the
// legacy FILESYSTEM_IMAGE watch-folder behaviour (unchanged).
enum IngestionAdapterType {
  FILESYSTEM_IMAGE
  FILESYSTEM_DICOM
  DICOMWEB
}

// Source configuration = the SOLE tenant authority for background discovery. `labId` is
// authoritative; tenant is NEVER derived from filename/accession/path/patient metadata.
// P5C-C3 (additive): a DICOMWEB source carries an endpoint base URL + auth type + an AES-256-GCM-encrypted
// credential (never plaintext, never returned to any API/UI) instead of a filesystem rootPath.
model IngestionSource {
  id               String                 @id @default(cuid())
  labId            String
  lab              Lab                    @relation(fields: [labId], references: [id])
  kind             IngestionSourceKind    @default(FILESYSTEM)
  rootPath         String? // FILESYSTEM: configured root (local dir/mounted share). Null for a DICOMWEB source.
  matchConfig      Json? // accession-extraction convention for B3 (opaque in B1); non-secret endpoint config for C3
  enabled          Boolean                @default(true)
  // ── P5C-C3 DICOMweb endpoint (all null for a FILESYSTEM source) ──
  endpointBaseUrl  String? // https base URL of the DICOMweb (QIDO/WADO) endpoint (infra-sensitive; never in monitoring)
  authType         DicomWebAuthType? // BEARER | BASIC (null = no auth)
  credentialCipher String? // AES-256-GCM ciphertext of the credential (EncryptionService); decrypted in-process only
  // ── P5C-C4 scanner adapter selection (null = legacy FILESYSTEM_IMAGE watch-folder behaviour) ──
  adapterType      IngestionAdapterType?
  discoveries      IngestionDiscovery[]
  health           IngestionSourceHealth? // P5C-C5 — 1:1 current health snapshot (import-connection health)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([labId, rootPath]) // one FILESYSTEM source config per (lab, path); nulls (DICOMWEB) don't collide
  @@unique([labId, endpointBaseUrl]) // one DICOMWEB source per (lab, endpoint); nulls (FILESYSTEM) don't collide
  @@index([labId, enabled])
}

// P5C-C5 — the operational health of an ACCEPTED import connection/intake path (NOT scanner hardware). A small
// deterministic enum; DISABLED reflects source.enabled=false; DEGRADED is a reachable-but-failing operational
// signal; STALE is NOT here (it is derived from lastSuccessfulCheckAt + cadence).
enum SourceHealthState {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNREACHABLE
  AUTH_REJECTED
  MISCONFIGURED
  DISABLED
}

// P5C-C5 — a 1:1 CURRENT health snapshot per IngestionSource (no history table; current-snapshot-only). Never
// stores a raw error message / endpoint URL / credential / patient-bearing path — only a structured error CODE.
model IngestionSourceHealth {
  id                    String            @id @default(cuid())
  labId                 String
  lab                   Lab               @relation(fields: [labId], references: [id])
  sourceId              String            @unique
  source                IngestionSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  state                 SourceHealthState @default(UNKNOWN)
  checkedAt             DateTime?
  lastSuccessfulCheckAt DateTime?
  lastFailedCheckAt     DateTime?
  lastErrorCode         String? // STRUCTURED HealthCheckErrorCode only — never a raw message/URL/credential/path
  consecutiveFailures   Int               @default(0)
  responseTimeMs        Int?
  nextEligibleCheckAt   DateTime? // scheduler claim + backoff
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([labId, state])
  @@index([labId, nextEligibleCheckAt]) // multi-instance-safe claim scan
}

// Pre-ingestion intake record. Exists so unmatched/ambiguous bytes can be represented
// truthfully BEFORE a DigitalSlide exists — a discovery never fabricates a slide/association.
// Cross-references to record/specimen/slide/ingestion/user are plain ids (validity enforced at
// match/handoff time in B3/B4) so B1 touches no existing WSI/Record/Specimen/User table.
model IngestionDiscovery {
  id             String                   @id @default(cuid())
  labId          String
  lab            Lab                      @relation(fields: [labId], references: [id])
  sourceId       String
  source         IngestionSource          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceRef      String // path/key relative to the source root — the idempotency key
  discoveredAt   DateTime                 @default(now())
  sizeBytes      Int?
  sourceChecksum String? // sha256 of bytes (lab-scoped, byte-based dedup identity), when computed
  status         IngestionDiscoveryStatus @default(DISCOVERED)

  // Authoritative associations — set ONLY on a genuine unique match/handoff; null = truthful no-association.
  matchedRecordId      String?
  matchedSpecimenId    String? // default null (record-level anchoring; P5-7 unassigned semantics)
  matchEvidence        Json? // which key matched / why ambiguous (B3)
  resultingSlideId     String? // set after successful pipeline handoff (INGESTED)
  resultingIngestionId String?

  // Reconciliation provenance (used by B4) — human actor + action, persisted not logged.
  reconciledById       String?
  reconciliationAction String?
  reconciledAt         DateTime?

  retryCount    Int      @default(0)
  failureReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([labId, sourceId, sourceRef]) // idempotency: one intake row per discovered object
  @@index([labId, status])
  @@index([labId, sourceChecksum]) // byte-based dedup lookup
  @@index([sourceId])
}

// Program 5C · C1 — DICOM WSI identity, geometry, and conformance for a DICOM-sourced DigitalSlide.
//
// SERIES-GRAIN: one DICOM WSI series (the whole-slide image; many SOP instances = pyramid levels/frames)
// maps to one Osieri slide (one sealed DZI derivative under the convert-to-DZI architecture). Tenancy is
// ALWAYS labId (auto-scoped by the extension) — a DICOM UID is NEVER a tenant key, so the same Study+Series
// may legitimately exist in two different labs, while a duplicate within one lab is rejected.
//
// PHI BOUNDARY: only operational / geometry / conformance / provenance metadata is persisted. There is NO
// PatientName/PatientID/PatientBirthDate/PatientSex/StudyDate/ReferringPhysicianName/InstitutionName and NO
// raw-header blob — existing Osieri Patient/Record identity remains authoritative and is never created or
// overwritten from DICOM. Acquisition scale (objectivePower/mpp) + source dimensions stay on DigitalSlide;
// this model does not duplicate them.
model SlideDicomMetadata {
  id      String       @id @default(cuid())
  labId   String
  lab     Lab          @relation(fields: [labId], references: [id])
  slideId String       @unique // 1:1 with the DICOM-sourced slide
  slide   DigitalSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)

  // ── Identity (series-grain). UIDs identify the DICOM object; labId is the tenant authority, not the UID. ──
  studyInstanceUID             String // (0020,000D)
  seriesInstanceUID            String // (0020,000E) — the WSI image; the slide's DICOM identity
  representativeSopInstanceUID String? // (0008,0018) — a primary instance ref (a series has many)
  sopClassUID                  String // (0008,0016) — must be VL Whole Slide Microscopy Image Storage
  transferSyntaxUID            String // (0002,0010) — decode/conformance classification
  frameOfReferenceUID          String? // (0020,0052) — geometry/conformance

  // ── Geometry (conformance + tiling sanity; NOT a duplicate of DigitalSlide.sourceWidth/Height semantics). ──
  totalPixelMatrixColumns Int? // (0048,0006) — full-resolution matrix width
  totalPixelMatrixRows    Int? // (0048,0007) — full-resolution matrix height
  numberOfFrames          Int? // (0028,0008)
  frameColumns            Int? // (0028,0011) — per-frame tile width
  frameRows               Int? // (0028,0010) — per-frame tile height
  opticalPaths            Json? // (0048,0105) seq — structured optical-path descriptors (multi-channel)
  containerIdentifier     String? // (0040,0512) — specimen container provenance

  // ── Conformance verdict (structured; never a free-form log string). ──
  conformanceStatus  DicomConformanceStatus
  conformanceReasons Json? // structured [{ code, tag?, expected?, actual?, message }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Series-grain tenant-scoped identity: duplicate Study+Series within a lab is rejected; different labs coexist.
  @@unique([labId, studyInstanceUID, seriesInstanceUID])
  @@index([labId, studyInstanceUID])
}

// ============================================================================
// Program 7 · Phase 7A — Enterprise Authentication foundation (7A.1).
// ADDITIVE, lab-scoped, provenance FKs onDelete: Restrict. Identity is a platform
// service (Principle 9): these are the canonical-principal + provider-isolation
// seam foundations. IdentityProvider + FederatedIdentity are INERT in 7A.1 (no
// protocol adapter ships until 7A.2/7A.3); ServicePrincipal is the non-human
// principal CLASS (Principle 11) — its machine-auth runtime lands with 7A.2. Each
// record carries a STABLE internal identifier (GG7) that never changes as external
// attributes change. Nothing here touches the live login path, tenancy, the clinical
// path, or AI evidence.
// ============================================================================

// Federation protocol a provider speaks. Reserved in 7A.1; adapters ship in 7A.2 (OIDC/OAUTH) and 7A.3 (SAML).
enum IdentityProviderProtocol {
  OIDC
  OAUTH
  SAML
}

// Per-lab enterprise identity-provider CONFIGURATION (administrative; never a tenancy key — Principle 4/ET3).
// Inert in 7A.1: registering a provider does not yet enable a federated login flow.
model IdentityProvider {
  id           String                   @id @default(cuid())
  providerUuid String                   @unique @default(uuid()) // stable internal identifier (GG7)
  labId        String
  lab          Lab                      @relation(fields: [labId], references: [id])
  key          String // lab-unique administrative handle
  displayName  String
  protocol     IdentityProviderProtocol
  issuer       String? // issuer / entityID; protocol-specific config fields land with each adapter increment
  // 7A.2a OIDC public-client config (PKCE; NO stored client secret in this increment). Nullable until OIDC-enabled.
  clientId     String?
  redirectUri  String?
  isEnabled    Boolean                  @default(false) // inert until an adapter activates it
  createdById  String? // actor; no FK
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  federatedIdentities FederatedIdentity[]
  oidcTransactions    OidcAuthTransaction[]

  @@unique([labId, key])
  @@index([labId])
}

// Non-human principal CLASS (Principle 11) — a machine/service identity, structurally distinct from a human User.
// It can NEVER hold clinical/diagnostic/sign-out/AI-approval authority. The machine-auth (client-credentials) runtime
// is deferred to 7A.2; 7A.1 establishes the entity + its stable identifier + canonical-principal resolution.
model ServicePrincipal {
  id            String   @id @default(cuid())
  principalUuid String   @unique @default(uuid()) // stable internal identifier (GG7)
  labId         String
  lab           Lab      @relation(fields: [labId], references: [id])
  key           String // lab-unique client handle
  displayName   String
  isActive      Boolean  @default(true)
  createdById   String? // actor; no FK
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Program 7 · Phase 7A.2b — machine credential lifecycle + scopes (child entities; ServicePrincipal shape unchanged)
  credentials ServicePrincipalCredential[]
  scopes      ServicePrincipalScope[]

  @@unique([labId, key])
  @@index([labId])
}

// Durable linkage from an external federated subject to an internal human principal (the User). INERT in 7A.1 —
// written/consumed by the federation adapters in 7A.2/7A.3. Binds to the stable internal principal (User.id), never to
// mutable external attributes (GG7). Provenance FKs onDelete: Restrict.
model FederatedIdentity {
  id                    String           @id @default(cuid())
  federatedIdentityUuid String           @unique @default(uuid()) // stable internal identifier (GG7)
  labId                 String
  lab                   Lab              @relation(fields: [labId], references: [id])
  identityProviderId    String
  identityProvider      IdentityProvider @relation(fields: [identityProviderId], references: [id], onDelete: Restrict)
  externalSubject       String // the provider's subject/nameID — a mutable external attribute, never the durable key
  userId                String
  user                  User             @relation("FederatedIdentityUser", fields: [userId], references: [id], onDelete: Restrict)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([labId, identityProviderId, externalSubject])
  @@index([labId])
  @@index([userId])
}

// Program 7 · Phase 7A.2a — server-side OIDC authorization transaction. Short-lived, single-use state that survives the
// IdP redirect. Binds the trusted provider configuration at INITIATION (configFingerprint) so a config change before
// the callback fails closed (OIDC configuration-immutability invariant). Carries the CSRF `state`, the replay `nonce`,
// and the PKCE verifier (needed to complete the code exchange). Lab-scoped; provider FK onDelete: Restrict. No PHI.
model OidcAuthTransaction {
  id                 String           @id @default(cuid())
  transactionUuid    String           @unique @default(uuid())
  labId              String
  lab                Lab              @relation(fields: [labId], references: [id])
  identityProviderId String
  identityProvider   IdentityProvider @relation(fields: [identityProviderId], references: [id], onDelete: Restrict)

  state             String // CSRF binding + callback lookup key (single-use)
  nonce             String // replay binding — compared to the ID-token nonce
  pkceVerifier      String // PKCE S256 verifier — sent to the token endpoint on callback
  redirectUri       String // exact redirect URI bound at initiation
  expectedIssuer    String // the issuer bound at initiation
  clientId          String // the client id bound at initiation
  configFingerprint String // digest over the trusted config at initiation (immutability invariant)

  expiresAt  DateTime
  consumedAt DateTime? // set when the transaction is completed/validated (single-use)
  createdAt  DateTime  @default(now())

  @@unique([labId, state])
  @@index([labId])
  @@index([identityProviderId])
}

// ============================================================================
// Program 7 · Phase 7A.2b — Service-Principal OAuth (machine authentication).
// ADDITIVE, lab-scoped, provenance FKs onDelete: Restrict. The frozen 7A.1
// ServicePrincipal is UNCHANGED (D1/D6): credentials + scopes are CHILD entities.
// Machine identity is immutable (D6): stable identifiers, no key rename, no hard
// delete (deactivation only). Nothing here touches the human login path, tenancy,
// the clinical path, or AI evidence.
// ============================================================================

enum ServiceCredentialStatus {
  ACTIVE
  REVOKED
}

// A machine credential for a ServicePrincipal. Argon2id HASH ONLY — the plaintext secret is shown once at
// issuance/rotation and NEVER persisted/logged/audited (D1). Rotation issues a new credential; revocation flips status.
model ServicePrincipalCredential {
  id                 String                  @id @default(cuid())
  credentialUuid     String                  @unique @default(uuid()) // stable internal identifier
  labId              String
  lab                Lab                     @relation(fields: [labId], references: [id])
  servicePrincipalId String
  servicePrincipal   ServicePrincipal        @relation(fields: [servicePrincipalId], references: [id], onDelete: Restrict)
  secretHash         String // Argon2id hash of the client secret — never the plaintext
  status             ServiceCredentialStatus @default(ACTIVE)
  rotatedAt          DateTime?
  expiresAt          DateTime? // optional secret expiry
  createdById        String? // actor; no FK
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([labId])
  @@index([labId, servicePrincipalId])
  @@index([servicePrincipalId])
}

// Scope grant: a ServicePrincipal is granted an EXISTING catalogue Permission (D5 — one authorization vocabulary,
// enforced by the single existing PermissionsGuard). No second scope language.
model ServicePrincipalScope {
  id                 String           @id @default(cuid())
  labId              String
  lab                Lab              @relation(fields: [labId], references: [id])
  servicePrincipalId String
  servicePrincipal   ServicePrincipal @relation(fields: [servicePrincipalId], references: [id], onDelete: Restrict)
  permissionId       String
  permission         Permission       @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  createdById        String? // actor; no FK
  createdAt          DateTime         @default(now())

  @@unique([labId, servicePrincipalId, permissionId])
  @@index([labId])
  @@index([servicePrincipalId])
}
