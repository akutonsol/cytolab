// Cytolab 2.0 — Prisma schema
// Phase 1: auth & identity (Lab, Account, Workspace, User, Role, Permission, AuthAttempt)
// Phase 2: lab intake (Patient, ClientType, Client, Requisition, Record, Specimen, Therapy, RecordStatusEvent)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Enums ----

enum Gender {
  Male
  Female
}

enum ClientTypeEnum {
  Doctor
  Laboratory
}

enum SpecimenType {
  // Gynecology specimen types.
  ENDOCERV_ASP
  CERV_SCRAP
  VAG_POOL
  // Non-gynecology specimen types.
  URINE
  CSF
  PLEURAL_FLD
  BREAST_ASP
  JOINT_ASP
  SYNOVIAL_FLD
  OTHER
  SPUTUM
  BRONCHIAL_WASH
  THYROID_FNA
  LYMPH_NODE
  BONE_MARROW
  SKIN_SCRAPING
}

enum RecordStatus {
  Pending
  Submitted
  Processing
  Partial
  Completed
  // Record has a result sheet but is not yet authorized (between Completed and
  // Approved).
  Resulted
  Approved
  Billed
  Paid
  OnHold
  Disabled
  Failed
  Viewed
}

enum RequisitionStatus {
  Pending
  Active
  Partial
  Completed
  Disabled
}

// Cytology test CLASS on a requisition line — orthogonal to SpecimenType
// (which is the specimen material). Legacy Gynecology/Nongynecology toggle.
enum RequisitionFormType {
  Gynecology
  NonGynecology
}

enum ResultSheetEventType {
  Authorized
  Deauthorized
  Reauthorized
  // F4 AI-assist audit trail (assistive only — never an authorization).
  AiDrafted
  AiAccepted
}

// Legacy authorizer_enum: a staff authorizer's professional designation, stamped
// on released reports next to their name (e.g. "Dr. Jane Doe — CYTOLOGIST").
enum AuthorizerDesignation {
  Pathologist
  Cytologist
}

// Legacy payment_type_enum.
enum PaymentType {
  Cash
  Cheque
  CreditCard
  DebitCard
  BankTransfer
}

enum BillStatus {
  Draft
  Issued
  PartiallyPaid
  Paid
}

// ---- Phase 5: Client Portal (F2) ----

enum ChangeRequestType {
  DemographicsCorrection
  AddTest
  CancelRequest
  GeneralQuery
}

enum ChangeRequestStatus {
  Open
  InReview
  Actioned
  Declined
}

// Credential token kind: initial invite (set first password) or password reset.
enum PortalTokenType {
  Invite
  Reset
}

// ---- F1: Multi-lab tenancy (every tenant-owned model carries labId) ----

model Lab {
  id                     String                   @id @default(uuid())
  name                   String
  slug                   String                   @unique
  logoUrl                String?
  // Branding shown on rendered report PDFs (Phase 3.5).
  address                String?
  phone                  String?
  email                  String?
  currency               String                   @default("JMD")
  isActive               Boolean                  @default(true)
  // Analytics targets. targetTatDays: expected turnaround (Submitted->Approved);
  // monthlyVolumeTarget: expected specimens/month (null -> derived from history).
  targetTatDays          Int                      @default(3)
  monthlyVolumeTarget    Int?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  accounts               Account[]
  users                  User[]
  workspaces             Workspace[]
  patients               Patient[]
  clientTypes            ClientType[]
  clients                Client[]
  requisitions           Requisition[]
  records                Record[]
  specimens              Specimen[]
  requisitionLines       RequisitionLine[]
  recordStatusEvents     RecordStatusEvent[]
  therapies              Therapy[]
  cabinets               Cabinet[]
  codeSheets             CodeSheet[]
  codeFindings           CodeFinding[]
  labCodes               LabCode[]
  aiSettings             LabAiSettings?
  aiDrafts               AiDraft[]
  resultSheets           ResultSheet[]
  resultEntries          ResultEntry[]
  resultLines            ResultLine[]
  reports                Report[]
  resultSheetEvents      ResultSheetEvent[]
  services               Service[]
  taxes                  Tax[]
  bills                  Bill[]
  billLines              BillLine[]
  billTaxes              BillTax[]
  payments               Payment[]
  portalUsers            PortalUser[]
  portalAccessTokens     PortalAccessToken[]
  changeRequests         ChangeRequest[]
  changeRequestMessages  ChangeRequestMessage[]
  changeRequestEvents    ChangeRequestEvent[]
  patientAddresses       PatientAddress[]
  clientAddresses        ClientAddress[]
  sequences              LabSequence[]
  gynClinicalFeatures    GynClinicalFeatures[]
  nonGynClinicalFeatures NonGynClinicalFeatures[]
  specimenImages         SpecimenImage[]
  recordAttachments      RecordAttachment[]
  threads                Thread[]
  appointments           Appointment[]
  formConfigs            FormConfig[]
  notifications          Notification[]
}

model Account {
  labId      String
  lab        Lab         @relation(fields: [labId], references: [id])
  id         String      @id @default(uuid())
  name       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  users      User[]
  workspaces Workspace[]
}

model Workspace {
  id           String        @id @default(uuid())
  labId        String
  lab          Lab           @relation(fields: [labId], references: [id])
  name         String
  accountId    String
  account      Account       @relation(fields: [accountId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  requisitions Requisition[]
  records      Record[]
  clients      Client[]

  @@index([accountId])
}

model User {
  id                     String                 @id @default(uuid())
  labId                  String
  lab                    Lab                    @relation(fields: [labId], references: [id])
  email                  String
  passwordHash           String
  firstName              String
  lastName               String
  // Authorizer signature image for rendered reports (Phase 3.5). Typed name
  // (firstName lastName) is the fallback when this is absent.
  signatureUrl           String?
  // Professional designation for staff who authorize result sheets (legacy
  // Authorizer.type). Null for non-authorizer staff; rendered on the report.
  authorizerDesignation  AuthorizerDesignation?
  isActive               Boolean                @default(true)
  accountId              String
  account                Account                @relation(fields: [accountId], references: [id])
  workspaceId            String?
  workspace              Workspace?             @relation(fields: [workspaceId], references: [id])
  roles                  UserRole[]
  authAttempts           AuthAttempt[]
  recordStatusEvents     RecordStatusEvent[]
  authorizedResultSheets ResultSheet[]          @relation("ResultSheetAuthorizer")
  authoredReports        Report[]               @relation("ReportAuthor")
  resultSheetEvents      ResultSheetEvent[]
  aiDraftsCreated        AiDraft[]              @relation("AiDraftCreatedBy")
  aiDraftsAccepted       AiDraft[]              @relation("AiDraftAcceptedBy")
  assignedChangeRequests ChangeRequest[]        @relation("ChangeRequestAssignee")
  changeRequestMessages  ChangeRequestMessage[] @relation("ChangeRequestMessageStaffAuthor")
  changeRequestEvents    ChangeRequestEvent[]   @relation("ChangeRequestEventStaffActor")
  threadParticipants     ThreadParticipant[]
  authoredMessages       Message[]
  assignedAppointments   Appointment[]
  notifications          Notification[]
  typingIndicators       TypingIndicator[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([labId, email])
  @@index([accountId])
  @@index([labId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  // When true, holders bypass all permission checks (the permissions guard
  // checks this flag, not a hardcoded role name) — legacy super_role parity, so
  // a lab can have multiple named super roles.
  isSuperRole Boolean          @default(false)
  // Legacy User/Workspace role toggle. Workspace-CONSTRAINED enforcement is
  // deferred (future RBAC) — the column only preserves the scope and lets the
  // admin UI show the selector. All roles are User-scoped today.
  scope       RoleScope        @default(User)
  users       UserRole[]
  permissions RolePermission[]
}

enum RoleScope {
  User
  Workspace
}

model Permission {
  id    String           @id @default(uuid())
  code  String           @unique
  label String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuthAttempt {
  id           String      @id @default(uuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  // Set for portal logins so portal lockouts never conflate with staff lockouts
  // even when a portal email collides with a staff email in the same lab.
  portalUserId String?
  portalUser   PortalUser? @relation(fields: [portalUserId], references: [id])
  portal       Boolean     @default(false)
  email        String
  ip           String?
  success      Boolean
  createdAt    DateTime    @default(now())

  @@index([email, createdAt])
  @@index([portal, email, createdAt])
}

// ---- Phase 2: Lab Intake ----

model Patient {
  id               String           @id @default(uuid())
  labId            String
  lab              Lab              @relation(fields: [labId], references: [id])
  registrationNo   String
  firstName        String
  lastName         String
  middleName       String?
  // Age is DERIVED from dateOfBirth (read-only), never stored — see DATA_MIGRATION_PLAN.md.
  phoneNumber      String?
  bloodGroup       String?
  gender           Gender?
  height           Float?
  weight           Float?
  email            String?
  dateOfBirth      DateTime?
  identityToken    String?
  motherMaidenName String?
  // Nullable stub — actual upload/serving deferred to Phase 6 file storage.
  avatarUrl        String?
  clientId         String?
  client           Client?          @relation(fields: [clientId], references: [id])
  addresses        PatientAddress[]
  records          Record[]
  appointments     Appointment[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([labId, registrationNo])
  @@index([labId])
  @@index([clientId])
}

model ClientType {
  id        String         @id @default(uuid())
  labId     String
  lab       Lab            @relation(fields: [labId], references: [id])
  name      String
  type      ClientTypeEnum
  clients   Client[]
  createdAt DateTime       @default(now())

  @@index([labId])
}

model Client {
  id                    String                 @id @default(uuid())
  labId                 String
  lab                   Lab                    @relation(fields: [labId], references: [id])
  firstName             String
  lastName              String
  officeName            String?
  // Client account number (legacy AC#, e.g. CYLB-577071) — lab-code prefix +
  // seeded LabSequence counter; imported verbatim. Nullable at the column level
  // but always set on create.
  accountNo             String?
  // Supports the patient form's "choose client by name OR email" search.
  email                 String?
  phoneNumber           String?
  mobileNumber          String?
  officeNumber          String?
  faxNumber             String?
  // Active/blocked toggles from the legacy Client form.
  active                Boolean                @default(true)
  blocked               Boolean                @default(false)
  // Nullable stub — actual upload/serving deferred to Phase 6 file storage.
  avatarUrl             String?
  // The client's assigned lab code/region (legacy "Labcode" dropdown). Closes
  // the Phase 3 "LabCode <-> Client" tracked debt.
  labCodeId             String?
  labCode               LabCode?               @relation(fields: [labCodeId], references: [id])
  // Optional workspace the client belongs to (legacy "Workspace" section).
  workspaceId           String?
  workspace             Workspace?             @relation(fields: [workspaceId], references: [id])
  clientTypeId          String?
  clientType            ClientType?            @relation(fields: [clientTypeId], references: [id])
  patients              Patient[]
  requisitions          Requisition[]
  records               Record[]
  specimens             Specimen[]
  cabinets              Cabinet[]
  bills                 Bill[]
  addresses             ClientAddress[]
  portalUsers           PortalUser[]
  changeRequests        ChangeRequest[]
  changeRequestMessages ChangeRequestMessage[]
  changeRequestEvents   ChangeRequestEvent[]
  threads               Thread[]
  appointments          Appointment[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([labId, accountNo])
  @@index([labCodeId])
  @@index([workspaceId])
  @@index([labId])
}

model Requisition {
  id           String            @id @default(uuid())
  labId        String
  lab          Lab               @relation(fields: [labId], references: [id])
  // Human-facing requisition number (legacy Ref#, e.g. 1460). Auto-generated
  // per lab via a seeded LabSequence; imported verbatim during migration.
  // Nullable at the column level (survives existing rows) but always set on
  // create — mirrors PortalUser.username.
  referenceNo  String?
  status       RequisitionStatus @default(Pending)
  // Batch total = Σ line costs, in minor units (cents). Never a float.
  amount       Int               @default(0)
  clientId     String?
  client       Client?           @relation(fields: [clientId], references: [id])
  workspaceId  String?
  workspace    Workspace?        @relation(fields: [workspaceId], references: [id])
  lines        RequisitionLine[]
  dateReceived DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([labId, referenceNo])
  @@index([labId])
  @@index([clientId])
}

model RequisitionLine {
  id            String              @id @default(uuid())
  labId         String
  lab           Lab                 @relation(fields: [labId], references: [id])
  requisitionId String
  requisition   Requisition         @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  // Cytology test class (Gyn/NonGyn), separate from the specimen material.
  formType      RequisitionFormType @default(Gynecology)
  isUrgent      Boolean             @default(false)
  // Cached fulfillment flag: true once the linked record reaches Completed+.
  // The parent requisition's Partial/Completed status is recomputed from these.
  isCompleted   Boolean             @default(false)
  notes         String?
  // Line cost in minor units (cents). Never a float.
  amount        Int                 @default(0)
  recordId      String?
  record        Record?             @relation(fields: [recordId], references: [id])

  @@index([labId])
  @@index([requisitionId])
  @@index([recordId])
}

model Record {
  id                String                  @id @default(uuid())
  labId             String
  lab               Lab                     @relation(fields: [labId], references: [id])
  // Internal, stable system id (never human-edited). Generated at create.
  identifier        String
  // Human-facing case number (legacy Lab No., e.g. CBL26-06-465). Generated per
  // lab via a MONTHLY-reset LabSequence; imported verbatim. Nullable at the
  // column level (survives existing rows) but always set on create.
  labNumber         String?
  // Which clinical form this case uses — the discriminator for which
  // *ClinicalFeatures relation applies. Reuses RequisitionFormType (flows
  // requisition-line -> record); one shared enum.
  formType          RequisitionFormType?
  // Referring/requesting doctor (free-text on the record form).
  doctor            String?
  clinicalDiagnosis String?
  specimenDate      DateTime?
  urgent            Boolean                 @default(false)
  medicalEntry      String?
  billed            Boolean                 @default(false)
  status            RecordStatus            @default(Pending)
  dateStatus        DateTime?
  patientId         String
  patient           Patient                 @relation(fields: [patientId], references: [id])
  clientId          String?
  client            Client?                 @relation(fields: [clientId], references: [id])
  workspaceId       String?
  workspace         Workspace?              @relation(fields: [workspaceId], references: [id])
  specimens         Specimen[]
  statusHistory     RecordStatusEvent[]
  requisitionLines  RequisitionLine[]
  therapy           Therapy?
  gynFeatures       GynClinicalFeatures?
  nonGynFeatures    NonGynClinicalFeatures?
  resultSheets      ResultSheet[]
  bills             Bill[]
  changeRequests    ChangeRequest[]
  attachments       RecordAttachment[]
  cabinetId         String?
  cabinet           Cabinet?                @relation(fields: [cabinetId], references: [id])
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([labId, identifier])
  @@unique([labId, labNumber])
  @@index([labId])
  @@index([patientId])
  @@index([clientId])
  @@index([cabinetId])
  @@index([status])
}

// Append-only status history — feeds the client portal (F2) status timeline
model RecordStatusEvent {
  id        String       @id @default(uuid())
  labId     String
  lab       Lab          @relation(fields: [labId], references: [id])
  recordId  String
  record    Record       @relation(fields: [recordId], references: [id], onDelete: Cascade)
  status    RecordStatus
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  notes     String?
  createdAt DateTime     @default(now())

  @@index([labId])
  @@index([recordId])
  @@index([recordId, createdAt])
}

model Specimen {
  id            String          @id @default(uuid())
  labId         String
  lab           Lab             @relation(fields: [labId], references: [id])
  label         String?
  vialColour    String?
  antiserumA    String?
  antiserumB    String?
  rhSolution    String?
  type          SpecimenType
  bloodGroup    String?
  recordId      String
  record        Record          @relation(fields: [recordId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?         @relation(fields: [clientId], references: [id])
  dateReceived  DateTime?
  resultEntries ResultEntry[]
  images        SpecimenImage[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([labId])
  @@index([recordId])
}

model Therapy {
  id        String  @id @default(uuid())
  labId     String
  lab       Lab     @relation(fields: [labId], references: [id])
  recordId  String  @unique
  record    Record  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  hormone   Boolean @default(false)
  radiation Boolean @default(false)
  surgical  Boolean @default(false)
  other     String?

  @@index([labId])
}

// ---- Phase 3: Results & Coding ----

// A named, colored filing folder linked to a Client. Its contents are that
// client's specimen records (automatic-by-client: records where clientId =
// cabinet.clientId), NOT the legacy per-record Record.cabinetId assignment,
// which is now deprecated (kept as a column, no longer written/read here).
// `identifier` holds the reference code CB{accountNo}-{RAND4}, generated when a
// client is linked.
model Cabinet {
  id         String   @id @default(uuid())
  labId      String
  lab        Lab      @relation(fields: [labId], references: [id])
  label      String
  identifier String?
  color      String?
  // The linked client. At most one cabinet per client (nullable → many unlinked
  // cabinets allowed, since Postgres treats NULLs as distinct).
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id])
  records    Record[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([labId, clientId])
  @@index([labId])
  @@index([clientId])
}

// Reference list of diagnostic code sheets.
model CodeSheet {
  id           String   @id @default(uuid())
  labId        String
  lab          Lab      @relation(fields: [labId], references: [id])
  abbreviation String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([labId])
}

// Reference list of code findings (independent of CodeSheet, per legacy).
model CodeFinding {
  id           String   @id @default(uuid())
  labId        String
  lab          Lab      @relation(fields: [labId], references: [id])
  abbreviation String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([labId])
}

// Lab/region code.
model LabCode {
  id        String   @id @default(uuid())
  labId     String
  lab       Lab      @relation(fields: [labId], references: [id])
  code      String
  region    String?
  clients   Client[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Legacy enforced a unique code; per-lab uniqueness is the multi-tenant form.
  @@unique([labId, code])
  @@index([labId])
}

// A record's result sheet: filled with entries/lines, then authorized.
// Authorization (who/when) is the gate that allows a report to be released.
model ResultSheet {
  id             String             @id @default(uuid())
  labId          String
  lab            Lab                @relation(fields: [labId], references: [id])
  recordId       String
  record         Record             @relation(fields: [recordId], references: [id], onDelete: Cascade)
  // External uploaded result sheet (stub — populated when Phase 6 file storage
  // lands; the in-system entry path uses resultEntries below).
  fileUrl        String?
  viewed         Boolean            @default(false)
  // Authorization gate (Phase 3 critical rule): set by a user holding
  // resultsheet:authorize. Editing entries resets these (re-authorization required).
  authorized     Boolean            @default(false)
  authorizedAt   DateTime?
  authorizedById String?
  authorizedBy   User?              @relation("ResultSheetAuthorizer", fields: [authorizedById], references: [id])
  // Human-owned working narrative the Authorizer edits and signs. An accepted AI
  // draft (F4) is copied here; at report release this becomes Report.content.
  // Owned by the human — the AiDraft keeps the provenance separately.
  narrative      String?
  resultEntries  ResultEntry[]
  reports        Report[]
  events         ResultSheetEvent[]
  aiDrafts       AiDraft[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([labId])
  @@index([recordId])
}

// Append-only audit of authorization state changes (authorize / de-authorize on
// edit / re-authorize). The live gate stays on ResultSheet; this is the history,
// and will feed the client portal (F2) report timeline.
model ResultSheetEvent {
  id            String               @id @default(uuid())
  labId         String
  lab           Lab                  @relation(fields: [labId], references: [id])
  resultSheetId String
  resultSheet   ResultSheet          @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)
  type          ResultSheetEventType
  userId        String?
  user          User?                @relation(fields: [userId], references: [id])
  createdAt     DateTime             @default(now())

  @@index([labId])
  @@index([resultSheetId])
  @@index([resultSheetId, createdAt])
}

model ResultEntry {
  id            String       @id @default(uuid())
  labId         String
  lab           Lab          @relation(fields: [labId], references: [id])
  resultSheetId String
  resultSheet   ResultSheet  @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)
  specimenId    String?
  specimen      Specimen?    @relation(fields: [specimenId], references: [id])
  resultLines   ResultLine[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([labId])
  @@index([resultSheetId])
}

model ResultLine {
  id              String      @id @default(uuid())
  labId           String
  lab             Lab         @relation(fields: [labId], references: [id])
  resultEntryId   String
  resultEntry     ResultEntry @relation(fields: [resultEntryId], references: [id], onDelete: Cascade)
  abbreviation    String?
  result          String?
  findings        String?
  abnormalFinding Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([labId])
  @@index([resultEntryId])
}

// A released pathology report. Only created from an authorized result sheet.
model Report {
  id                  String      @id @default(uuid())
  labId               String
  lab                 Lab         @relation(fields: [labId], references: [id])
  resultSheetId       String
  resultSheet         ResultSheet @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)
  authorizerReference String?
  content             String?
  signature           String?
  digitalSignature    String?
  medicalEntry        String?
  writtenById         String?
  writtenBy           User?       @relation("ReportAuthor", fields: [writtenById], references: [id])
  releasedAt          DateTime    @default(now())
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([labId])
  @@index([resultSheetId])
}

// ---- F4: AI-assisted reporting ----
// AI is strictly ASSISTIVE. Nothing here authorizes or bypasses the auth gate;
// every AI call is best-effort and degrades gracefully. See docs/F4_AI_REPORTING_DESIGN.md.

// Per-lab AI configuration. Off by default (opt-in, compliance-gated).
model LabAiSettings {
  id              String          @id @default(uuid())
  labId           String          @unique
  lab             Lab             @relation(fields: [labId], references: [id])
  enabled         Boolean         @default(false)
  houseStyle      String? // lab's narrative template / style guidance
  redactionPolicy RedactionPolicy @default(Strict)
  model           String? // optional model override; else the server default
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum RedactionPolicy {
  Strict // clinical data only — NO demographics
  Standard // adds de-identified sex + age BAND (never DOB / exact age)
}

// Provenance record for every AI generation, kept forever. Never overwritten:
// a result sheet accumulates drafts over time.
model AiDraft {
  id              String          @id @default(uuid())
  labId           String
  lab             Lab             @relation(fields: [labId], references: [id])
  resultSheetId   String
  resultSheet     ResultSheet     @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)
  kind            AiDraftKind
  status          AiDraftStatus   @default(Generated)
  // What the model produced: narrative text, or a JSON string for codes/consistency.
  output          String
  // Provenance
  model           String // exact model id used
  promptVersion   String // e.g. "narrative-v1" — bumped when the prompt changes
  redactionPolicy RedactionPolicy // policy snapshot applied at generation
  inputDigest     String // sha256 of the exact redacted payload (proves input class w/o storing PHI)
  createdById     String?
  createdBy       User?           @relation("AiDraftCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())
  // Human review (Narrative kind): the edited final text + diff at acceptance.
  finalText       String?
  editedDiff      Json? // structured diff: AI output -> finalText
  acceptedAt      DateTime?
  acceptedById    String?
  acceptedBy      User?           @relation("AiDraftAcceptedBy", fields: [acceptedById], references: [id])

  @@index([labId])
  @@index([resultSheetId])
}

enum AiDraftKind {
  Narrative
  CodeSuggestion
  ConsistencyCheck
}

enum AiDraftStatus {
  Generated
  Accepted
  Rejected
  Superseded
}

// ---- Phase 4: Revenue ----
// All monetary amounts are integers in minor units (cents). Currency is the
// lab's (Lab.currency). Never store money as a float.

// Price-list entry a bill draws from.
model Service {
  id          String     @id @default(uuid())
  labId       String
  lab         Lab        @relation(fields: [labId], references: [id])
  name        String
  code        String
  description String?
  price       Int // minor units (cents)
  active      Boolean    @default(true)
  billLines   BillLine[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Legacy enforced a unique service name; per-lab uniqueness is the tenant form.
  @@unique([labId, name])
  @@index([labId])
}

// Tax rate stored as basis points (1% = 100 bps) — integer, no floats.
model Tax {
  id              String    @id @default(uuid())
  labId           String
  lab             Lab       @relation(fields: [labId], references: [id])
  name            String
  code            String?
  rateBasisPoints Int // basis points; 1% = 100
  isDefault       Boolean   @default(false)
  billTaxes       BillTax[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Legacy enforced a unique tax name; per-lab uniqueness is the tenant form.
  @@unique([labId, name])
  @@index([labId])
}

// A bill for one lab case (Record), billed to a Client. Totals are computed at
// creation from snapshotted line/tax amounts and never recomputed from the
// live catalog.
model Bill {
  id          String     @id @default(uuid())
  labId       String
  lab         Lab        @relation(fields: [labId], references: [id])
  recordId    String
  record      Record     @relation(fields: [recordId], references: [id])
  clientId    String?
  client      Client?    @relation(fields: [clientId], references: [id])
  referenceNo String
  status      BillStatus @default(Draft)
  subtotal    Int        @default(0) // minor units (cents) — sum of line amounts
  taxTotal    Int        @default(0) // minor units (cents) — sum of applied tax amounts
  total       Int        @default(0) // minor units (cents) — subtotal + taxTotal
  amountPaid  Int        @default(0) // minor units (cents) — Σ of payments, recomputed on each payment
  dueDate     DateTime?
  viewed      Boolean    @default(false)
  lines       BillLine[]
  taxes       BillTax[]
  payments    Payment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([labId])
  @@index([recordId])
  @@index([clientId])
  @@index([status])
}

// A bill line; price + service identity are snapshotted at bill time so later
// catalog edits don't rewrite historical bills.
model BillLine {
  id          String   @id @default(uuid())
  labId       String
  lab         Lab      @relation(fields: [labId], references: [id])
  billId      String
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  serviceName String // snapshot of Service.name at bill time
  serviceCode String? // snapshot of Service.code at bill time
  description String?
  quantity    Int
  unitPrice   Int // minor units (cents) — snapshot of Service.price at bill time
  amount      Int // minor units (cents) — quantity * unitPrice
  createdAt   DateTime @default(now())

  @@index([labId])
  @@index([billId])
}

// A tax applied to a bill, snapshotted (name + rate) at bill time.
model BillTax {
  id              String   @id @default(uuid())
  labId           String
  lab             Lab      @relation(fields: [labId], references: [id])
  billId          String
  bill            Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  taxId           String?
  tax             Tax?     @relation(fields: [taxId], references: [id])
  name            String // snapshot of Tax.name
  rateBasisPoints Int // snapshot of Tax.rateBasisPoints
  amount          Int // minor units (cents) — round(subtotal * rate / 10000)
  createdAt       DateTime @default(now())

  @@index([labId])
  @@index([billId])
}

// A payment settling (part of) a bill. Multiple payments per bill = partial
// settlement. `verified` is an audit flag, not a settlement gate.
model Payment {
  id           String      @id @default(uuid())
  labId        String
  lab          Lab         @relation(fields: [labId], references: [id])
  billId       String
  bill         Bill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount       Int // minor units (cents)
  type         PaymentType
  referenceNo  String?
  bank         String?
  chequeNumber String?
  verified     Boolean     @default(false)
  datePaid     DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([labId])
  @@index([billId])
}

// ---- Phase 5: Client Portal (F2) ----
// External identity for referring doctors/labs. Completely separate from staff
// User: separate table, separate JWT (own secret + audience). Lab-scoped AND
// client-scoped — carries clientId, which the tenancy guard injects into every
// portal query so a portal user can only ever reach its own client's data.
model PortalUser {
  id                    String                 @id @default(uuid())
  labId                 String
  lab                   Lab                    @relation(fields: [labId], references: [id])
  clientId              String
  client                Client                 @relation(fields: [clientId], references: [id])
  // Auto-generated at invite time (legacy "Generated" username). Unique per lab.
  username              String?
  email                 String
  // Null until the invite is accepted (first password set via emailed token).
  // Staff never set an external user's password (Finding 2, option B).
  passwordHash          String?
  firstName             String
  lastName              String
  isActive              Boolean                @default(true)
  // 2FA is toggled on the client form; actual enrollment happens later in the
  // portal (the staff form never sees the secret).
  twoFactorEnabled      Boolean                @default(false)
  // The client's main login. Soft flag (a client may have more than one contact
  // login); the service keeps at most one primary per client.
  isPrimary             Boolean                @default(false)
  // F2 notification preferences.
  notifyByEmail         Boolean                @default(true)
  notifyInApp           Boolean                @default(true)
  lastLoginAt           DateTime?
  tokens                PortalAccessToken[]
  authAttempts          AuthAttempt[]
  changeRequests        ChangeRequest[]        @relation("ChangeRequestCreator")
  changeRequestMessages ChangeRequestMessage[] @relation("ChangeRequestMessagePortalAuthor")
  changeRequestEvents   ChangeRequestEvent[]   @relation("ChangeRequestEventPortalActor")
  threadParticipants    ThreadParticipant[]
  authoredMessages      Message[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([labId, email])
  @@unique([labId, username])
  @@index([labId])
  @@index([clientId])
}

// Single-use, time-limited credential token for staff-invite onboarding and
// password reset. Only the SHA-256 hash is stored; the raw token is emailed.
// No clientId column: it is consumed unauthenticated (system scope), never in a
// portal-scoped request, so Rule B never applies to it.
model PortalAccessToken {
  id           String          @id @default(uuid())
  labId        String
  lab          Lab             @relation(fields: [labId], references: [id])
  portalUserId String
  portalUser   PortalUser      @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  type         PortalTokenType
  tokenHash    String          @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime        @default(now())

  @@index([labId])
  @@index([portalUserId])
}

// A structured request a client raises against a record (or generally). Carries
// clientId so the tenancy guard auto-scopes portal access to the client's own
// requests. Status lifecycle Open -> InReview -> Actioned|Declined.
model ChangeRequest {
  id                    String                 @id @default(uuid())
  labId                 String
  lab                   Lab                    @relation(fields: [labId], references: [id])
  clientId              String
  client                Client                 @relation(fields: [clientId], references: [id])
  recordId              String?
  record                Record?                @relation(fields: [recordId], references: [id])
  type                  ChangeRequestType
  subject               String
  status                ChangeRequestStatus    @default(Open)
  createdByPortalUserId String
  createdByPortalUser   PortalUser             @relation("ChangeRequestCreator", fields: [createdByPortalUserId], references: [id])
  assignedToUserId      String?
  assignedToUser        User?                  @relation("ChangeRequestAssignee", fields: [assignedToUserId], references: [id])
  messages              ChangeRequestMessage[]
  events                ChangeRequestEvent[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([labId])
  @@index([clientId])
  @@index([recordId])
  @@index([status])
}

// Append-only message thread between a portal user and lab staff. Exactly one of
// authorPortalUserId / authorUserId is set per row.
model ChangeRequestMessage {
  id                 String        @id @default(uuid())
  labId              String
  lab                Lab           @relation(fields: [labId], references: [id])
  clientId           String
  client             Client        @relation(fields: [clientId], references: [id])
  changeRequestId    String
  changeRequest      ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  body               String
  authorPortalUserId String?
  authorPortalUser   PortalUser?   @relation("ChangeRequestMessagePortalAuthor", fields: [authorPortalUserId], references: [id])
  authorUserId       String?
  authorUser         User?         @relation("ChangeRequestMessageStaffAuthor", fields: [authorUserId], references: [id])
  createdAt          DateTime      @default(now())

  @@index([labId])
  @@index([clientId])
  @@index([changeRequestId])
  @@index([changeRequestId, createdAt])
}

// Append-only audit of change-request status transitions (mirrors
// ResultSheetEvent). Exactly one of byPortalUserId / byUserId is set per row.
model ChangeRequestEvent {
  id              String              @id @default(uuid())
  labId           String
  lab             Lab                 @relation(fields: [labId], references: [id])
  clientId        String
  client          Client              @relation(fields: [clientId], references: [id])
  changeRequestId String
  changeRequest   ChangeRequest       @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  status          ChangeRequestStatus
  note            String?
  byPortalUserId  String?
  byPortalUser    PortalUser?         @relation("ChangeRequestEventPortalActor", fields: [byPortalUserId], references: [id])
  byUserId        String?
  byUser          User?               @relation("ChangeRequestEventStaffActor", fields: [byUserId], references: [id])
  createdAt       DateTime            @default(now())

  @@index([labId])
  @@index([clientId])
  @@index([changeRequestId])
  @@index([changeRequestId, createdAt])
}

// ---- Patient form rebuild (legacy parity) ----

// A patient can have one or more addresses ("Add Address" on the form).
model PatientAddress {
  id         String   @id @default(uuid())
  labId      String
  lab        Lab      @relation(fields: [labId], references: [id])
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  // Optional label (e.g. Home, Work) when the source distinguishes addresses.
  label      String?
  line1      String
  line2      String?
  city       String?
  region     String?
  postalCode String?
  country    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([labId])
  @@index([patientId])
}

// A client can have one or more addresses ("Add Address" on the client form).
model ClientAddress {
  id         String   @id @default(uuid())
  labId      String
  lab        Lab      @relation(fields: [labId], references: [id])
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  line2      String?
  city       String?
  region     String?
  postalCode String?
  country    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([labId])
  @@index([clientId])
}

// Per-lab monotonic counters for human-facing identifiers (currently the
// patient registration number). Allocation is atomic via an incrementing update
// that returns the new value; the seed is set during data migration to
// max(numeric imported registrationNo) so generated numbers never collide with
// imported ones (see DATA_MIGRATION_PLAN.md).
model LabSequence {
  id        String   @id @default(uuid())
  labId     String
  lab       Lab      @relation(fields: [labId], references: [id])
  name      String // e.g. "patientRegNo"
  value     BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@unique([labId, name])
  @@index([labId])
}

// ---- Record clinical features (two forms, chosen up front) ----
// A record is EITHER a Gynecology case OR a Non-Gynecology case (Record.formType
// discriminator). Each form's clinical fields live in its own typed 1:1 model so
// invalid states are unrepresentable (no pregnancy data on a urine sample).

model GynClinicalFeatures {
  id                         String    @id @default(uuid())
  labId                      String
  lab                        Lab       @relation(fields: [labId], references: [id])
  recordId                   String    @unique
  record                     Record    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  routineCheck               Boolean   @default(false)
  previousCytology           Boolean   @default(false)
  lmp                        DateTime? // last menstrual period
  clinicalAppearanceOfCervix String?
  nowPregnant                Boolean   @default(false)
  pregnancies                Int?
  leucorrhea                 String?
  menopause                  Boolean   @default(false)
  dateOfMenopause            DateTime?
  lengthOfCycle              String?
  pelvicAbnormalities        String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([labId])
}

model NonGynClinicalFeatures {
  id                String   @id @default(uuid())
  labId             String
  lab               Lab      @relation(fields: [labId], references: [id])
  recordId          String   @unique
  record            Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  sampleDescription String?
  natureAndSource   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([labId])
}

// General file attached to a record ("Attach File" row action). STUB — the
// actual upload/serving is deferred to Phase 6 file storage.
model RecordAttachment {
  id         String   @id @default(uuid())
  labId      String
  lab        Lab      @relation(fields: [labId], references: [id])
  recordId   String
  record     Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  storageUrl String
  filename   String?
  kind       String?
  createdAt  DateTime @default(now())

  @@index([labId])
  @@index([recordId])
}

// Slide (Gyn) / Vial (NonGyn) specimen images. STUB — actual upload/serving is
// deferred to Phase 6 file storage; the label is derived from Record.formType.
model SpecimenImage {
  id         String   @id @default(uuid())
  labId      String
  lab        Lab      @relation(fields: [labId], references: [id])
  specimenId String
  specimen   Specimen @relation(fields: [specimenId], references: [id], onDelete: Cascade)
  storageUrl String
  caption    String?
  createdAt  DateTime @default(now())

  @@index([labId])
  @@index([specimenId])
}

// ─── Messaging (Phase 6) ─────────────────────────────────────────────────────
// Threads carry messages between staff (INTERNAL) or staff↔client (CLIENT).
// Lab-scoped via labId; participants gate read access.

model Thread {
  id           String              @id @default(cuid())
  labId        String
  type         ThreadType          @default(INTERNAL)
  subject      String?
  clientId     String?
  client       Client?             @relation(fields: [clientId], references: [id])
  participants ThreadParticipant[]
  messages     Message[]
  typingIndicators TypingIndicator[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  lab          Lab                 @relation(fields: [labId], references: [id])

  @@index([labId])
  @@index([clientId])
  @@index([labId, updatedAt])
}

// Ephemeral "user is typing" signal, one row per (thread, user), refreshed on
// each keystroke burst and expiring ~5s later. Rows are upserted and read with
// an expiry filter, so stale indicators simply age out.
model TypingIndicator {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime // typing indicators expire after 5 seconds

  @@unique([threadId, userId])
  @@index([threadId])
}

model ThreadParticipant {
  id           String      @id @default(cuid())
  threadId     String
  thread       Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  portalUserId String?
  portalUser   PortalUser? @relation(fields: [portalUserId], references: [id])
  joinedAt     DateTime    @default(now())

  @@index([threadId])
  @@index([userId])
  @@index([portalUserId])
}

model Message {
  id                 String      @id @default(cuid())
  threadId           String
  thread             Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  body               String
  authorUserId       String?
  authorUser         User?       @relation(fields: [authorUserId], references: [id])
  authorPortalUserId String?
  authorPortalUser   PortalUser? @relation(fields: [authorPortalUserId], references: [id])
  readAt             DateTime? // set when the recipient reads the message
  deliveredAt        DateTime? // set when the message is fetched by the recipient
  createdAt          DateTime    @default(now())

  @@index([threadId])
  @@index([threadId, createdAt])
}

enum ThreadType {
  INTERNAL
  CLIENT
}

// ─── Appointments (Phase 6) ──────────────────────────────────────────────────
// Scheduled patient/client visits: specimen collections, callbacks, consults and
// follow-ups. Lab-scoped via labId; optionally linked to a patient/client and an
// assigned staff member.

model Appointment {
  id             String            @id @default(cuid())
  labId          String
  lab            Lab               @relation(fields: [labId], references: [id])
  patientId      String?
  patient        Patient?          @relation(fields: [patientId], references: [id])
  clientId       String?
  client         Client?           @relation(fields: [clientId], references: [id])
  title          String
  type           AppointmentType   @default(COLLECTION)
  status         AppointmentStatus @default(SCHEDULED)
  scheduledAt    DateTime
  duration       Int               @default(30)
  notes          String?
  assignedUserId String?
  assignedUser   User?             @relation(fields: [assignedUserId], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([labId])
  @@index([labId, scheduledAt])
  @@index([patientId])
  @@index([clientId])
}

enum AppointmentType {
  COLLECTION
  CALLBACK
  CONSULTATION
  FOLLOWUP
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELLED
}

// ─── System Health (internal) ────────────────────────────────────────────────
// Audit trail of automated-maintenance runs (superuser dashboard + nightly cron).
// Global (not lab-scoped): maintenance operates across every lab.

model MaintenanceLog {
  id       String   @id @default(cuid())
  ranAt    DateTime @default(now())
  ranBy    String? // userId, or 'system' for the cron run
  duration Int // ms
  results  Json // { flagged, archived, missedClosed, ... }
  notes    String?

  @@index([ranAt])
}

// ─── Form Setup (Path A: UI config layer over hardcoded clinical features) ────
// Configures labels/ordering/print-grouping of the existing GynClinicalFeatures
// + NonGynClinicalFeatures columns. Never alters those columns — fieldKey maps
// to an existing Prisma column name.

model FormConfig {
  id          String              @id @default(cuid())
  labId       String
  lab         Lab                 @relation(fields: [labId], references: [id])
  formType    RequisitionFormType
  fields      FormFieldConfig[]
  printGroups FormPrintGroup[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([labId, formType])
  @@index([labId])
}

model FormFieldConfig {
  id               String          @id @default(cuid())
  labId            String
  formConfigId     String
  formConfig       FormConfig      @relation(fields: [formConfigId], references: [id], onDelete: Cascade)
  fieldKey         String
  label            String
  fieldType        FormFieldType   @default(TEXT)
  showWhenPrinting Boolean         @default(true)
  printGroupId     String?
  printGroup       FormPrintGroup? @relation(fields: [printGroupId], references: [id])
  sortOrder        Int             @default(0)
  enabled          Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([formConfigId, fieldKey])
  @@index([labId])
}

model FormPrintGroup {
  id           String            @id @default(cuid())
  labId        String
  formConfigId String
  formConfig   FormConfig        @relation(fields: [formConfigId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int               @default(0)
  fields       FormFieldConfig[]
  createdAt    DateTime          @default(now())

  @@index([labId])
}

enum FormFieldType {
  TEXT
  CHECKBOX
}

// ─── Notifications (Phase 6) ──────────────────────────────────────────────────
// Per-user, lab-scoped in-app notifications. Created internally by services when
// lifecycle events occur (never via a public create endpoint); read/marked-read
// by the owning user.
model Notification {
  id         String           @id @default(cuid())
  labId      String
  lab        Lab              @relation(fields: [labId], references: [id])
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  type       NotificationType
  title      String
  body       String
  read       Boolean          @default(false)
  readAt     DateTime?
  link       String? // e.g. /records/xxx or /authorizer
  entityId   String? // recordId, changeRequestId etc
  entityType String? // 'record', 'changerequest', 'appointment'
  createdAt  DateTime         @default(now())

  @@index([labId, userId])
  @@index([labId, userId, read])
}

enum NotificationType {
  RECORD_SUBMITTED
  RECORD_RESULTED
  RECORD_APPROVED
  RECORD_FAILED
  AUTHORIZATION_NEEDED
  CHANGE_REQUEST_RECEIVED
  CHANGE_REQUEST_REPLIED
  PAYMENT_RECEIVED
  APPOINTMENT_REMINDER
  SYSTEM_ALERT
}
