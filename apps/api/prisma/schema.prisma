// Cytolab 2.0 — Prisma schema
// Phase 1 models (auth & identity), derived from the legacy entities:
// User, Account, Role, Permission, Workspace, AuthAttempt.
// Lab-domain models (Patient, Client, Requisition, Specimen, ResultSheet, ...)
// are added in Phase 2+ once the requirements baseline doc is approved.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- F1: Multi-lab tenancy (every tenant-owned model carries labId) ----
model Lab {
  id        String      @id @default(uuid())
  name      String
  slug      String      @unique // used in portal URLs, e.g. portal.cytolab.app/{slug}
  logoUrl   String?
  currency  String      @default("JMD")
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  accounts  Account[]
  users     User[]
  workspaces Workspace[]
}

model Account {
  labId      String
  lab        Lab         @relation(fields: [labId], references: [id])

  id         String      @id @default(uuid())
  name       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  users      User[]
  workspaces Workspace[]
}

model Workspace {
  id        String   @id @default(uuid())
  labId     String
  lab       Lab      @relation(fields: [labId], references: [id])
  name      String
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@index([accountId])
}

model User {
  id           String        @id @default(uuid())
  labId        String
  lab          Lab           @relation(fields: [labId], references: [id])
  email        String
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean       @default(true)
  accountId    String
  account      Account       @relation(fields: [accountId], references: [id])
  workspaceId  String?
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id])
  roles        UserRole[]
  authAttempts AuthAttempt[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([labId, email])
  @@index([accountId])
  @@index([labId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(uuid())
  code  String           @unique // e.g. "requisition:create", "resultsheet:sign"
  label String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuthAttempt {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}
