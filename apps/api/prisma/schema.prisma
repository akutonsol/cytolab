// ---- Digital Requisition Portal (DRP) ----
// Clients assemble a batch of digital cytology requisition forms in the portal
// (manual entry or AI-scanned paper forms), sign, pay, and submit. On submit the
// forms become real Requisition/Record chains in the lab. Both models carry
// clientId so the portal tenancy layer can client-scope direct operations.

model RequisitionBatch {
  id               String                   @id @default(cuid())
  labId            String
  lab              Lab                      @relation(fields: [labId], references: [id])
  batchNumber      String                   @unique // BATCH-2026-XXXX
  clientId         String
  client           Client                   @relation(fields: [clientId], references: [id])
  submittedById    String
  status           BatchStatus              @default(DRAFT)
  totalForms       Int                      @default(0)
  totalAmountCents Int                      @default(0)
  paymentMethod    PaymentMethod?
  paymentStatus    PaymentStatus            @default(PENDING)
  paymentRef       String?
  paymentPaidAt    DateTime?
  notes            String?
  manifestUrl      String? // PDF manifest
  forms            DigitalRequisitionForm[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  submittedAt      DateTime?

  @@index([labId, status])
  @@index([clientId])
}

model DigitalRequisitionForm {
  id         String           @id @default(cuid())
  labId      String
  lab        Lab              @relation(fields: [labId], references: [id])
  clientId   String?
  client     Client?          @relation(fields: [clientId], references: [id])
  batchId    String
  batch      RequisitionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  formNumber Int // position in batch 1,2,3...

  // Scan data
  scanStatus    ScanStatus?
  rawScanUrl    String? // uploaded PDF/image
  extractedData Json? // raw OCR output
  ocrConfidence Float? // 0-1

  // Patient info
  patientName   String?
  patientDob    DateTime?
  hospRegNumber String?

  // Doctor/Lab info
  doctorName    String?
  doctorAddress String?

  // Specimen info
  specimenDate DateTime?
  specimenType String? // ENDOCERV_ASP | VAG_POOL | CERV_SCRAP | SPECIMEN_16

  // Clinical features
  routineCheck        Boolean?
  lmp                 String?
  lengthOfCycle       String?
  abnormalBleeding    Boolean?
  leucorrhoea         Boolean?
  specialType         String?
  noPregnancies       String?
  nowPregnant         Boolean?
  menopauseDate       DateTime?
  clinicalAppearance  String?
  pelvicAbnormalities String?
  otherClinicalData   String?
  clinicalDiagnosis   String?
  previousCytology    Boolean?

  // Therapy
  hormone      String?
  radiation    String?
  surgical     String?
  otherTherapy String?

  // Signature
  signatureDataUrl String? // base64 canvas signature
  signedAt         DateTime?
  signedByName     String?

  // Internal
  accessionNumber String? // assigned on submission
  requisitionId   String? // linked requisition after processing
  needsReview     Boolean @default(false)
  reviewNotes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId, batchId])
  @@index([clientId])
}

// ─── Ancillary & IHC Ordering (Phase 4.1A) ───────────────────────────────────
// A record-scoped ancillary / IHC work order — a new owner-controlled capability
// (Phase 4.1A). It records a REQUESTED dependency on a case. Order existence is
// not completion; completion is not a clinical conclusion. This model does NOT
// own the Record, Result Sheet, Sign-Out, Bethesda, Coding, Specimen, Slide,
// Report, or Requisition lifecycles — it only records the order.

enum AncillaryKind {
  IHC // immunohistochemistry
  SpecialStain // histochemical special stain
  Molecular // molecular / genetic assay
  Cytochemistry // cytochemical stain
  Other // other ancillary work (real, entered)
}

// State VOCABULARY only. B1 does NOT establish which transitions are legal —
// transition legality belongs to the owner service (B3). Cancelled and Completed
// are deliberately distinct; there is intentionally no separate rejected /
// resulted / reviewed state (an order is not a result and not a review).
enum AncillaryStatus {
  Ordered // requested, not yet started
  InProcess // work underway
  Completed // work finished — NOT a clinical conclusion
  Cancelled // withdrawn before completion
}

model AncillaryOrder {
  id       String @id @default(cuid())
  labId    String
  lab      Lab    @relation(fields: [labId], references: [id])
  recordId String
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  kind   AncillaryKind
  target String // real entered marker/antibody/stain name (never inferred)
  status AncillaryStatus @default(Ordered)

  // Recorded, never inferred: whether this dependency blocks sign-out. Whether to
  // warn vs. hard-block at sign-out is a later owner/UI concern (B4); here it is
  // only recorded data.
  blocksSignOut Boolean @default(true)

  // Requester provenance. Scalar-only actor id (matches the Record.assignedById /
  // QCFailureAlert.resolvedById precedent) to keep this schema checkpoint surgical
  // and avoid touching the User model; may be promoted to a User relation later.
  orderedById String?

  orderedAt   DateTime  @default(now()) // request time (also serves as creation time)
  updatedAt   DateTime  @updatedAt // last recorded change
  completedAt DateTime? // set only when status → Completed (truthful timestamp)
  notes       String? // free-text request/handling note (no structured payload/JSON)

  @@index([labId, status])
  @@index([recordId])
}

// ─── Screening Batch (Phase 4.2 — Screening Batch Management) ────────────────
// A cytotechnologist primary-screening batch: a persisted, screener-owned grouping
// of cases. `ScreeningBatchService` (added in C3) is the SOLE owner of this
// aggregate's lifecycle, membership, batch→screener assignment, and completion
// state (D-002/D-014). It references Record and Lab but writes ONLY its own tables;
// it never writes Record.status, Record.assignedTo* (workload), QC, AI, Result
// Sheet, or Sign-Out (D-004/D-019). Plan: docs/platform/PATHOS_SCREENING_BATCH_IMPLEMENTATION_PLAN.md (C1).

enum ScreeningBatchStatus {
  Draft // membership being assembled
  Ready // membership frozen, awaiting a screener
  Assigned // screener assigned, not yet started
  InScreening // screener working the batch
  Completed // every member case dispositioned by the screener — NOT a diagnosis/QC-pass/release
  Closed // administratively archived (terminal)
  Cancelled // withdrawn before completion (terminal)
}

// Per-case screening-workflow disposition — NEVER a clinical finding. The batch
// records only that a screener handled the case; Bethesda / Result Sheet owners
// hold the actual diagnosis (truthfulness, D-005/D-007).
enum ScreeningDisposition {
  Pending // not yet screened by the cytotechnologist
  Screened // screener completed a routine screen (unremarkable) — not a diagnosis
  Flagged // flagged for pathologist review
  QCSelected // selected for QC rescreen/rapid review (the QC act itself belongs to qc)
}

model ScreeningBatch {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id])

  batchNumber String // human label (e.g. SCR-2026-XXXX); assigned by the owner, unique per lab
  status      ScreeningBatchStatus @default(Draft)

  // Batch → screener (cytotechnologist) assignment. Distinct granularity from
  // workload's case→pathologist assignment (Record.assignedTo*); the batch NEVER
  // writes those fields. Scalar-only actor ids (AncillaryOrder.orderedById /
  // Record.assignedById precedent) keep this checkpoint surgical — the User model
  // is untouched; they may be promoted to User relations later.
  assignedToId String? // the screener
  assignedById String? // the manager who assigned
  assignedAt   DateTime?

  createdById String? // creator provenance (scalar-only)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  startedAt   DateTime? // set only when status → InScreening (truthful)
  completedAt DateTime? // set only when status → Completed (truthful; screening only)
  closedAt    DateTime? // set only when status → Closed
  notes       String? // free-text batch note (no structured payload/JSON)

  cases ScreeningBatchCase[]

  @@unique([labId, batchNumber])
  @@index([labId, status])
  @@index([assignedToId])
}

model ScreeningBatchCase {
  id    String @id @default(cuid())
  labId String
  lab   Lab    @relation(fields: [labId], references: [id])

  batchId  String
  batch    ScreeningBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  recordId String
  record   Record         @relation(fields: [recordId], references: [id], onDelete: Cascade)

  disposition  ScreeningDisposition @default(Pending)
  screenedById String? // scalar-only actor id (the screener who dispositioned)
  screenedAt   DateTime? // set only when disposition leaves Pending (truthful)
  notes        String?

  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([batchId, recordId]) // a case appears at most once within a batch
  @@index([labId])
  @@index([recordId])
  @@index([batchId, disposition])
}

// ============================================================================
// Program 2 · P2-1 — Enterprise Audit bounded context (append-only ledger).
// Binding authority: docs/architecture/AUDIT_EVENT_CONTRACT.md.
// Owned exclusively by the Audit module; NO domain owner may reference AuditEvent
// directly (enforced by audit-architecture.spec.ts). The scope column is deliberately
// named `scopeLabId`, NOT `labId`, so the global tenancy extension — which auto-scopes
// every model carrying a `labId` column — never forces a lab onto SYSTEM/CROSS_LAB
// events. The Audit owner performs its own scope filtering in the P2-6 query API.
// Enum values are SCREAMING_SNAKE registry/wire codes (not the PascalCase used by older
// domain enums) to match the contract document.
// ============================================================================

enum AuditCategory {
  AUTHENTICATION
  AUTHORIZATION
  PHI_ACCESS
  RECORD_LIFECYCLE
  CLINICAL_WORKFLOW
  ADMINISTRATIVE
  CONFIGURATION
  DATA_EXPORT
  SECURITY
  DATA_MAINTENANCE
  SYSTEM
}

enum AuditActorType {
  STAFF
  PORTAL
  SERVICE
  SYSTEM
  ANONYMOUS
}

enum AuditOrganizationScope {
  LAB
  SYSTEM
  CROSS_LAB
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
  ERROR
}

enum AuditSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

enum AuditDataClass {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  PHI
}

enum AuditRetentionClass {
  SHORT
  STANDARD
  EXTENDED
  PERMANENT
}

enum AuditDurabilityClass {
  CRITICAL_TRANSACTIONAL
  REQUIRED_DURABLE
  OPERATIONAL
}

model AuditEvent {
  // --- Identity (platform-owned; producers never set these) ---
  id            String   @id @default(cuid()) // eventId
  occurredAt    DateTime // when the fact happened (may precede recordedAt)
  recordedAt    DateTime @default(now()) // when the ledger persisted it
  sequence      BigInt? // per-chain monotonic order; assigned by the P2-4 chain-head, null until then
  schemaVersion Int      @default(1) // storage-envelope version
  eventVersion  Int // semantic payload version, resolved from the registry

  // --- Classification (resolved from the registry) ---
  category        AuditCategory
  severity        AuditSeverity
  phiIndicator    Boolean             @default(false)
  dataClass       AuditDataClass
  retentionClass  AuditRetentionClass
  durabilityClass AuditDurabilityClass

  // --- Actor (identifiers only; never a name/email) ---
  actorType         AuditActorType
  actorId           String?
  onBehalfOfActorId String?
  servicePrincipal  String?

  // --- Organization / scope (see class comment: scopeLabId, not labId) ---
  organizationScope AuditOrganizationScope
  scopeLabId        String? // required iff scope = LAB; absent for SYSTEM / CROSS_LAB
  organizationId    String?

  // --- Request context (OPTIONAL at the envelope level; policy is registry-driven) ---
  requestId     String?
  correlationId String?
  ipAddress     String?
  userAgent     String?
  deviceId      String?
  route         String?
  httpMethod    String?

  // --- Session context (OPTIONAL) ---
  sessionId   String?
  sessionKind String?

  // --- Resource (patientRef is an opaque pseudonymous token; no free-text field) ---
  resourceType       String
  resourceId         String?
  resourceLabId      String?
  parentResourceType String?
  parentResourceId   String?
  patientRef         String?

  // --- Action (verb lives ONLY here) + outcome ---
  actionCode String
  detailCode String?
  outcome    AuditOutcome
  statusCode Int?
  errorCode  String?
  reasonCode String?

  // --- Change evidence (names + hashes only; raw values prohibited) ---
  changedFields String[]
  beforeHash    String?
  afterHash     String?

  // --- Integrity (P2-4; INACTIVE in P2-1, explicit nullable — no tamper claim yet) ---
  chainId       String?
  prevHash      String?
  selfHash      String?
  hashAlgorithm String?

  // --- Producer attribution + typed metadata ---
  producerModule String
  executionId    String?
  metadata       Json? // typed/bounded per registry contract; validated at the write boundary

  @@index([scopeLabId, recordedAt])
  @@index([category, recordedAt])
  @@index([actorId, recordedAt])
  @@index([resourceType, resourceId])
  @@index([correlationId])
  // P2-4B: (chainId, sequence) uniquely identifies every chained event. Legacy pre-P2-4
  // rows carry chainId = NULL; Postgres treats NULL index keys as distinct (NULLS DISTINCT,
  // the PG16 default), so unlimited legacy NULL-chainId rows coexist under this standard
  // UNIQUE with no partial predicate. Allocation/wiring is P2-4C, not here.
  @@unique([chainId, sequence])
  @@index([recordedAt])
}

/// P2-4B — Audit chain head (integrity infrastructure; NOT yet allocated/wired).
/// One row per chain. `chainId` encodes the scope partition (e.g. "lab:<id>", "system",
/// "cross-lab") and is derived by the Audit owner from the trusted organization scope —
/// never producer-supplied. Deliberately named `chainId` (not `labId`) so it stays outside
/// the tenancy auto-scoping. In P2-4C this row is locked FOR UPDATE inside the append
/// transaction to allocate a gapless per-chain sequence and carry the prevHash forward.
model AuditChainHead {
  chainId      String   @id
  lastSequence BigInt
  lastSelfHash String
  updatedAt    DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// PLATFORM BILLING — the platform invoicing a Lab as its customer.
// Distinct from Bill/BillLine/Payment (which is a lab billing ITS OWN clients
// for a case). Configured by a superuser in the control center; a daily cron
// generates invoices for labs whose billingDayOfMonth matches today.
// ─────────────────────────────────────────────────────────────────────────────

enum LabInvoiceStatus {
  Draft
  Sent
  Paid
  Overdue
  Void
}

/// One recurring-billing configuration per lab. The template line items live on
/// LabBillingItem. A flat monthly fee is simply a single line item.
model LabBillingProfile {
  id                String           @id @default(uuid())
  labId             String           @unique
  lab               Lab              @relation(fields: [labId], references: [id])
  active            Boolean          @default(false)
  // Day of month (1–28) the invoice auto-generates. Capped at 28 so it exists in
  // every month.
  billingDayOfMonth Int              @default(1)
  // Net terms: invoice is due this many days after it is issued.
  dueDays           Int              @default(14)
  // When true, generation marks the invoice Sent + notifies the lab immediately;
  // otherwise it lands as Draft for the superuser to review/send.
  autoSend          Boolean          @default(true)
  // Snapshot of the billing currency (defaults from Lab.currency at creation).
  currency          String           @default("JMD")
  notes             String?
  // Idempotency guard: the "YYYY-MM" period the cron last generated for.
  lastRunPeriod     String?
  lastRunAt         DateTime?
  items             LabBillingItem[]
  invoices          LabInvoice[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([active, billingDayOfMonth])
}

/// A recurring template line on a lab's billing profile. Copied (snapshotted)
/// onto each generated invoice's LabInvoiceLine rows.
model LabBillingItem {
  id          String            @id @default(uuid())
  labId       String
  lab         Lab               @relation(fields: [labId], references: [id])
  profileId   String
  profile     LabBillingProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  description String
  quantity    Int               @default(1)
  // Unit price in minor units (cents). Never a float.
  unitPrice   Int               @default(0)
  sortOrder   Int               @default(0)

  @@index([labId])
  @@index([profileId])
}

/// A generated platform invoice billed to a lab.
model LabInvoice {
  id          String             @id @default(uuid())
  labId       String
  lab         Lab                @relation(fields: [labId], references: [id])
  profileId   String?
  profile     LabBillingProfile? @relation(fields: [profileId], references: [id])
  // Human invoice number, e.g. INV-202607-0001 (per-lab seeded sequence).
  number      String
  periodLabel String // "July 2026"
  periodStart DateTime
  periodEnd   DateTime
  status      LabInvoiceStatus   @default(Draft)
  currency    String
  // Amounts in minor units (cents). subtotal == total for now (no platform tax).
  subtotal    Int                @default(0)
  total       Int                @default(0)
  issueDate   DateTime           @default(now())
  dueDate     DateTime?
  sentAt      DateTime?
  paidAt      DateTime?
  voidedAt    DateTime?
  // "system" (cron) or a superuser userId.
  generatedBy String             @default("system")
  notes       String?
  lines       LabInvoiceLine[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([labId, number])
  @@index([labId])
  @@index([status])
  @@index([profileId])
}

/// A snapshot line on a generated invoice.
model LabInvoiceLine {
  id          String     @id @default(uuid())
  labId       String
  lab         Lab        @relation(fields: [labId], references: [id])
  invoiceId   String
  invoice     LabInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int        @default(1)
  unitPrice   Int        @default(0)
  amount      Int        @default(0)

  @@index([labId])
  @@index([invoiceId])
}
