// Cytolab 2.0 — Prisma schema
// Phase 1: auth & identity (Lab, Account, Workspace, User, Role, Permission, AuthAttempt)
// Phase 2: lab intake (Patient, ClientType, Client, Requisition, Record, Specimen, Therapy, RecordStatusEvent)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection — restricted `cytolab_api` user (SELECT/INSERT/UPDATE/DELETE).
  url       = env("DATABASE_URL")
  // Migrations / introspection — privileged `cytolab_migrate` user. Prisma CLI
  // (migrate deploy, db pull) uses this; the running client always uses `url`.
  directUrl = env("DATABASE_MIGRATION_URL")
}

// ---- Enums ----

enum Gender {
  Male
  Female
}

enum ClientTypeEnum {
  Doctor
  Laboratory
}

enum SpecimenType {
  // Gynecology specimen types.
  ENDOCERV_ASP
  CERV_SCRAP
  VAG_POOL
  // Non-gynecology specimen types.
  URINE
  CSF
  PLEURAL_FLD
  BREAST_ASP
  JOINT_ASP
  SYNOVIAL_FLD
  OTHER
  SPUTUM
  BRONCHIAL_WASH
  THYROID_FNA
  LYMPH_NODE
  BONE_MARROW
  SKIN_SCRAPING
}

enum RecordStatus {
  Pending
  Submitted
  Processing
  Partial
  Completed
  // Record has a result sheet but is not yet authorized (between Completed and
  // Approved).
  Resulted
  Approved
  Billed
  Paid
  OnHold
  Disabled
  Failed
  Viewed
}

enum RequisitionStatus {
  Pending
  Active
  Partial
  Completed
  Disabled
}

// Cytology test CLASS on a requisition line — orthogonal to SpecimenType
// (which is the specimen material). Legacy Gynecology/Nongynecology toggle.
enum RequisitionFormType {
  Gynecology
  NonGynecology
}

enum ResultSheetEventType {
  Authorized
  Deauthorized
  Reauthorized
  // F4 AI-assist audit trail (assistive only — never an authorization).
  AiDrafted
  AiAccepted
}

// Legacy authorizer_enum: a staff authorizer's professional designation, stamped
// on released reports next to their name (e.g. "Dr. Jane Doe — CYTOLOGIST").
enum AuthorizerDesignation {
  Pathologist
  Cytologist
}

// Legacy payment_type_enum.
enum PaymentType {
  Cash
  Cheque
  CreditCard
  DebitCard
  BankTransfer
}

enum BillStatus {
  Draft
  Issued
  PartiallyPaid
  Paid
}

// ---- Phase 5: Client Portal (F2) ----

enum ChangeRequestType {
  DemographicsCorrection
  AddTest
  CancelRequest
  GeneralQuery
}

enum ChangeRequestStatus {
  Open
  InReview
  Actioned
  Declined
}

// Credential token kind: initial invite (set first password) or password reset.
enum PortalTokenType {
  Invite
  Reset
}

// ---- Digital Requisition Portal (DRP) ----

enum BatchStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  SUBMITTED
  PROCESSING
  COMPLETED
  REJECTED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CHEQUE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ScanStatus {
  UPLOADING
  PROCESSING
  EXTRACTED
  NEEDS_REVIEW
  CONFIRMED
}

// ---- F1: Multi-lab tenancy (every tenant-owned model carries labId) ----

model Lab {
  id                               String                             @id @default(uuid())
  name                             String
  slug                             String                             @unique
  logoUrl                          String?
  // Short brand tagline shown beside the lab name on the dashboard/login shell
  // (Settings > General > Company). Falls back to a default when unset.
  tagline                          String?
  // Branding shown on rendered report PDFs (Phase 3.5).
  address                          String?
  phone                            String?
  email                            String?
  currency                         String                             @default("JMD")
  isActive                         Boolean                            @default(true)
  // Analytics targets. targetTatDays: expected turnaround (Submitted->Approved);
  // monthlyVolumeTarget: expected specimens/month (null -> derived from history).
  targetTatDays                    Int                                @default(3)
  monthlyVolumeTarget              Int?
  // --- Hybrid tenancy (pool + silo). Additive + BEHAVIOR-NEUTRAL: every existing
  // lab defaults to POOL, so nothing changes until a lab is flipped to SILO.
  // See docs/architecture/HYBRID_TENANCY_AND_CUSTOM_DOMAINS.md.
  tenancyMode                      TenancyMode                        @default(POOL)
  // SILO only: a *reference* (e.g. GCP Secret Manager resource name) to the lab's
  // dedicated DB connection secret — NEVER the raw connection string. Null for POOL.
  databaseSecretRef                String?
  migrationSecretRef               String?
  // Optional data-residency / instance placement hint.
  dataRegion                       String?
  domains                          LabDomain[]
  createdAt                        DateTime                           @default(now())
  updatedAt                        DateTime                           @updatedAt
  accounts                         Account[]
  users                            User[]
  workspaces                       Workspace[]
  patients                         Patient[]
  clientTypes                      ClientType[]
  clients                          Client[]
  requisitions                     Requisition[]
  records                          Record[]
  specimens                        Specimen[]
  ingestionSources                 IngestionSource[] // P5B-B1 — automated-ingestion source config
  ingestionDiscoveries             IngestionDiscovery[] // P5B-B1 — automated-ingestion intake records
  slideDicomMetadata               SlideDicomMetadata[] // P5C-C1 — DICOM WSI identity/conformance (tenant-scoped)
  ingestionSourceHealth            IngestionSourceHealth[] // P5C-C5 — per-source import-connection health snapshots
  aiModels                         AiModel[] // P6-6A — lab-scoped AI model registry
  aiModelVersions                  AiModelVersion[] // P6-6A — versioned AI model records
  aiModelLifecycleEvents           AiModelLifecycleEvent[] // P6-6A — append-only lifecycle transitions
  inferenceRecords                 InferenceRecord[] // P6-6A — immutable inference-record shell (populated at terminalization by 6C)
  inferenceJobs                    InferenceJob[] // P6-6C — mutable inference execution/queue rows
  inferenceEvents                  InferenceEvent[] // P6-6C — append-only inference audit trail
  explainabilityGenerations        ExplainabilityGeneration[] // P6-6D — explainability artifact-set generations
  explainabilityArtifacts          ExplainabilityArtifact[] // P6-6D — immutable explainability artifacts
  explainabilityRegions            ExplainabilityRegion[] // P6-6D — explainability feature-region geometry
  explainabilityProbabilities      ExplainabilityProbability[] // P6-6D — explainability probability-distribution entries
  humanReviewRequests              HumanReviewRequest[] // P6-6E — human-review workflow requests
  humanReviewDecisions             HumanReviewDecision[] // P6-6E — immutable human-review decisions
  humanReviewModifiedFindings      HumanReviewModifiedFinding[] // P6-6E — structured MODIFY findings
  humanReviewRequestEvents         HumanReviewRequestEvent[] // P6-6E — append-only request-state audit
  validationRuns                   ValidationRun[] // P6-6F — immutable validation-evidence runs
  validationMetrics                ValidationMetric[] // P6-6F — structured validation metrics
  validationConfusionCells         ValidationConfusionCell[] // P6-6F — confusion-matrix cells
  validationCurvePoints            ValidationCurvePoint[] // P6-6F — ROC/calibration curve points
  evaluationWindows                EvaluationWindow[] // P6-6G — immutable continuous-evaluation windows
  evaluationWindowMembers          EvaluationWindowMember[] // P6-6G — window membership snapshot
  evaluationMetrics                EvaluationMetric[] // P6-6G — structured evaluation metrics
  evaluationRecommendations        EvaluationRecommendation[] // P6-6G — advisory lifecycle-review recommendations
  evaluationRecommendationEvidence EvaluationRecommendationEvidence[] // P6-6G — recommendation→metric provenance links
  clinicalPerfWindows              ClinicalPerfWindow[] // P6-6H — immutable clinical-performance measurement windows
  clinicalPerfWindowMembers        ClinicalPerfWindowMember[] // P6-6H — window membership snapshot
  clinicalPerfMetrics              ClinicalPerfMetric[] // P6-6H — structured measurement metrics
  datasets                         Dataset[] // P6-6B — governed datasets
  datasetVersions                  DatasetVersion[] // P6-6B — immutable dataset versions
  datasetSlides                    DatasetSlide[] // P6-6B — dataset membership (slide refs)
  groundTruthLabels                GroundTruthLabel[] // P6-6B — structured ground-truth labels
  annotationLineageEvents          AnnotationLineageEvent[] // P6-6B — append-only label lineage
  trainingDatasetRefs              TrainingDatasetReference[] // P6-6B — external training-corpus references
  requisitionLines                 RequisitionLine[]
  recordStatusEvents               RecordStatusEvent[]
  therapies                        Therapy[]
  cabinets                         Cabinet[]
  codeSheets                       CodeSheet[]
  codeFindings                     CodeFinding[]
  labCodes                         LabCode[]
  aiSettings                       LabAiSettings?
  aiDrafts                         AiDraft[]
  resultSheets                     ResultSheet[]
  resultEntries                    ResultEntry[]
  resultLines                      ResultLine[]
  reports                          Report[]
  resultSheetEvents                ResultSheetEvent[]
  services                         Service[]
  taxes                            Tax[]
  bills                            Bill[]
  billLines                        BillLine[]
  billTaxes                        BillTax[]
  payments                         Payment[]
  portalUsers                      PortalUser[]
  portalAccessTokens               PortalAccessToken[]
  changeRequests                   ChangeRequest[]
  changeRequestMessages            ChangeRequestMessage[]
  changeRequestEvents              ChangeRequestEvent[]
  requisitionBatches               RequisitionBatch[]
  digitalRequisitionForms          DigitalRequisitionForm[]
  patientAddresses                 PatientAddress[]
  clientAddresses                  ClientAddress[]
  sequences                        LabSequence[]
  gynClinicalFeatures              GynClinicalFeatures[]
  nonGynClinicalFeatures           NonGynClinicalFeatures[]
  specimenImages                   SpecimenImage[]
  recordAttachments                RecordAttachment[]
  threads                          Thread[]
  appointments                     Appointment[]
  formConfigs                      FormConfig[]
  notifications                    Notification[]
  notificationPreferences          UserNotificationPreference[]
  departments                      Department[]
  employees                        Employee[]
  payrollRuns                      PayrollRun[]
  payAdvices                       PayAdvice[]
  resultTemplates                  ResultTemplate[]
  bethesdaResults                  BethesdaResult[]
  tatConfigs                       TATConfig[]
  tatAlerts                        TATAlert[]
  features                         LabFeature[]
  escalations                      EscalationRecord[]
  workloadTargets                  WorkloadTarget[]
  qcChecks                         QCCheck[]
  equipment                        Equipment[]
  ancillaryOrders                  AncillaryOrder[]
  screeningBatches                 ScreeningBatch[]
  screeningBatchCases              ScreeningBatchCase[]
  qcFailureAlerts                  QCFailureAlert[]
  requisitionTrackings             RequisitionTracking[]
  trackingEvents                   TrackingEvent[]
  correlationCases                 CorrelationCase[]
  proficiencyTests                 ProficiencyTest[]
  proficiencyCases                 ProficiencyCase[]
  proficiencyResponses             ProficiencyResponse[]
  reagentLots                      ReagentLot[]
  reagentUsages                    ReagentUsage[]
  recalls                          RecallRecord[]
  digitalSlides                    DigitalSlide[]
  slideAnnotations                 SlideAnnotation[]
  slideIngestions                  SlideIngestion[]
  slideProcessingJobs              SlideProcessingJob[]
  derivativeGenerations            DerivativeGeneration[]
  slideAssets                      SlideAsset[]
  generationVerifications          GenerationVerification[]
  generationPublications           GenerationPublication[]
  deliverySessions                 DeliverySession[]
  aiScreenings                     AIScreeningResult[]
  consultRequests                  ConsultRequest[]
  medicalCodes                     MedicalCode[]
  recordCodings                    RecordCoding[]
  fhirEndpoints                    FHIREndpoint[]
  fhirTransmissions                FHIRTransmission[]
  // Platform-level billing: the platform invoicing THIS lab as a customer
  // (distinct from Bill/Payment, which is the lab billing its own clients).
  billingProfile                   LabBillingProfile?
  billingItems                     LabBillingItem[]
  labInvoices                      LabInvoice[]
  labInvoiceLines                  LabInvoiceLine[]
  // Program 7 · Phase 7A — Enterprise Authentication foundation (additive; identity is a platform service)
  identityProviders                IdentityProvider[]
  servicePrincipals                ServicePrincipal[]
  federatedIdentities              FederatedIdentity[]
  oidcAuthTransactions             OidcAuthTransaction[]
  servicePrincipalCredentials      ServicePrincipalCredential[]
  servicePrincipalScopes           ServicePrincipalScope[]
}

/// How a lab's DATA-PLANE storage is provisioned. Control-plane rows (Lab, LabDomain,
/// auth/identity needed to route a request) always live in the shared pool database.
enum TenancyMode {
  POOL // clinical data in the shared pool DB, isolated by labId (default)
  SILO // clinical data in the lab's OWN dedicated database (still labId-governed)
}

/// Custom domains that route to a lab (a lab may have several: apex, www, app subdomain).
/// The domain resolver maps an inbound Host header -> labId (-> its DB + branding).
model LabDomain {
  id         String       @id @default(uuid())
  labId      String
  lab        Lab          @relation(fields: [labId], references: [id], onDelete: Cascade)
  /// Fully-qualified host, lowercased, no scheme/port. Globally unique across ALL labs.
  hostname   String       @unique
  /// Canonical domain for this lab (redirect target, cookie domain, branding origin).
  isPrimary  Boolean      @default(false)
  status     DomainStatus @default(PENDING)
  verifiedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([labId])
  @@index([status])
}

enum DomainStatus {
  PENDING // added, ownership/TLS not yet confirmed
  VERIFYING // DNS/ACME challenge in flight
  ACTIVE // serving with a valid cert
  DISABLED
}

model Account {
  labId      String
  lab        Lab         @relation(fields: [labId], references: [id])
  id         String      @id @default(uuid())
  name       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  users      User[]
  workspaces Workspace[]
}

model Workspace {
  id           String        @id @default(uuid())
  labId        String
  lab          Lab           @relation(fields: [labId], references: [id])
  name         String
  accountId    String
  account      Account       @relation(fields: [accountId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  requisitions Requisition[]
  records      Record[]
  clients      Client[]

  @@index([accountId])
}

model User {
  id                      String                      @id @default(uuid())
  labId                   String
  lab                     Lab                         @relation(fields: [labId], references: [id])
  email                   String
  passwordHash            String
  firstName               String
  lastName                String
  // Authorizer signature image for rendered reports (Phase 3.5). Typed name
  // (firstName lastName) is the fallback when this is absent.
  signatureUrl            String?
  // Professional designation for staff who authorize result sheets (legacy
  // Authorizer.type). Null for non-authorizer staff; rendered on the report.
  authorizerDesignation   AuthorizerDesignation?
  isActive                Boolean                     @default(true)
  accountId               String
  account                 Account                     @relation(fields: [accountId], references: [id])
  workspaceId             String?
  workspace               Workspace?                  @relation(fields: [workspaceId], references: [id])
  roles                   UserRole[]
  authAttempts            AuthAttempt[]
  recordStatusEvents      RecordStatusEvent[]
  authorizedResultSheets  ResultSheet[]               @relation("ResultSheetAuthorizer")
  authoredReports         Report[]                    @relation("ReportAuthor")
  resultSheetEvents       ResultSheetEvent[]
  aiDraftsCreated         AiDraft[]                   @relation("AiDraftCreatedBy")
  aiDraftsAccepted        AiDraft[]                   @relation("AiDraftAcceptedBy")
  aiScreeningsReviewed    AIScreeningResult[]         @relation("AIScreeningReviewer")
  consultRequests         ConsultRequest[]            @relation("ConsultRequester")
  recordCodings           RecordCoding[]
  assignedChangeRequests  ChangeRequest[]             @relation("ChangeRequestAssignee")
  changeRequestMessages   ChangeRequestMessage[]      @relation("ChangeRequestMessageStaffAuthor")
  changeRequestEvents     ChangeRequestEvent[]        @relation("ChangeRequestEventStaffActor")
  threadParticipants      ThreadParticipant[]
  authoredMessages        Message[]
  assignedAppointments    Appointment[]               @relation("AppointmentAssignee")
  createdAppointments     Appointment[]               @relation("AppointmentCreator")
  notifications           Notification[]
  notificationPreference  UserNotificationPreference?
  typingIndicators        TypingIndicator[]
  // HR / Payroll (Phase 7)
  employeeProfile         Employee?                   @relation("EmployeeUser")
  managedDepartments      Department[]                @relation("DepartmentManager")
  processedPayrollRuns    PayrollRun[]                @relation("PayrollProcessor")
  approvedPayrollRuns     PayrollRun[]                @relation("PayrollApprover")
  resultTemplates         ResultTemplate[]            @relation("ResultTemplateCreator")
  bethesdaResults         BethesdaResult[]            @relation("BethesdaReporter")
  acknowledgedTatAlerts   TATAlert[]                  @relation("TATAcknowledger")
  toggledFeatures         LabFeature[]                @relation("LabFeatureToggler")
  escalationsAssigned     EscalationRecord[]          @relation("EscalationAssignee")
  escalationsReviewed     EscalationRecord[]          @relation("EscalationReviewer")
  assignedRecords         Record[]                    @relation("RecordAssignee")
  workloadTarget          WorkloadTarget?
  qcChecks                QCCheck[]
  formsReceived           RequisitionTracking[]       @relation("FormReceiver")
  benchReceived           RequisitionTracking[]       @relation("BenchReceiver")
  formsVerified           RequisitionTracking[]       @relation("FormVerifier")
  formsFiled              RequisitionTracking[]       @relation("FormFiler")
  trackingEvents          TrackingEvent[]             @relation("TrackingEventActor")
  correlationsReviewed    CorrelationCase[]           @relation("CorrelationReviewer")
  correlationsCreated     CorrelationCase[]           @relation("CorrelationCreator")
  proficiencyTests        ProficiencyTest[]           @relation("ProfTestCreator")
  proficiencyResponses    ProficiencyResponse[]       @relation("ProfResponder")
  reagentLotsCreated      ReagentLot[]                @relation("ReagentCreator")
  reagentUsages           ReagentUsage[]              @relation("ReagentUser")
  clockEventEdits         ClockEvent[]                @relation("ClockEventEditor")
  timesheetsReviewed      Timesheet[]                 @relation("TimesheetReviewer")
  leaveRequestsApproved   LeaveRequest[]              @relation("LeaveApprover")
  overtimeRecordsApproved OvertimeRecord[]            @relation("OvertimeApprover")
  workforceNotifications  WorkforceNotification[]     @relation("WorkforceNotificationRecipient")
  payrollPeriodsProcessed PayrollPeriod[]             @relation("PayrollPeriodProcessor")
  performanceReviewsGiven PerformanceReview[]         @relation("PerformanceReviewer")
  humanReviewsSubmitted   HumanReviewDecision[]       @relation("HumanReviewReviewer") // P6-6E — decisions this human authored
  humanReviewsAssigned    HumanReviewRequest[]        @relation("HumanReviewAssignee") // P6-6E — review requests assigned to this human
  // Enterprise security (Phase 1) — password lifecycle, MFA, login protection.
  passwordChangedAt       DateTime?
  passwordExpiresAt       DateTime?
  mfaRequired             Boolean                     @default(false)
  // Per-user UI preference: the guided-assistance coach (follows the user across
  // devices). Off by default.
  guidedAssistanceEnabled Boolean                     @default(false)
  lastLoginAt             DateTime?
  lastLoginIp             String?
  failedLoginCount        Int                         @default(0)
  failedLoginAt           DateTime?
  refreshTokens           RefreshToken[]
  userSessions            UserSession[]
  accountLock             AccountLock?
  trustedDevices          TrustedDevice[]
  mfaConfig               MfaConfig?
  passwordHistory         PasswordHistory[]
  federatedIdentities     FederatedIdentity[]         @relation("FederatedIdentityUser")
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  @@unique([labId, email])
  @@index([accountId])
  @@index([labId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  // When true, holders bypass all permission checks (the permissions guard
  // checks this flag, not a hardcoded role name) — legacy super_role parity, so
  // a lab can have multiple named super roles.
  isSuperRole Boolean          @default(false)
  // Legacy User/Workspace role toggle. Workspace-CONSTRAINED enforcement is
  // deferred (future RBAC) — the column only preserves the scope and lets the
  // admin UI show the selector. All roles are User-scoped today.
  scope       RoleScope        @default(User)
  users       UserRole[]
  permissions RolePermission[]
}

enum RoleScope {
  User
  Workspace
}

model Permission {
  id                     String                  @id @default(uuid())
  code                   String                  @unique
  label                  String
  roles                  RolePermission[]
  // Program 7 · Phase 7A.2b — service-principal scopes reuse the EXISTING permission catalogue (one authz vocabulary)
  servicePrincipalScopes ServicePrincipalScope[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuthAttempt {
  id           String      @id @default(uuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  // Set for portal logins so portal lockouts never conflate with staff lockouts
  // even when a portal email collides with a staff email in the same lab.
  portalUserId String?
  portalUser   PortalUser? @relation(fields: [portalUserId], references: [id])
  portal       Boolean     @default(false)
  email        String
  ip           String?
  success      Boolean
  createdAt    DateTime    @default(now())

  @@index([email, createdAt])
  @@index([portal, email, createdAt])
}

// ---- Phase 2: Lab Intake ----

model Patient {
  id               String            @id @default(uuid())
  labId            String
  lab              Lab               @relation(fields: [labId], references: [id])
  registrationNo   String
  firstName        String
  lastName         String
  middleName       String?
  // Age is DERIVED from dateOfBirth (read-only), never stored — see DATA_MIGRATION_PLAN.md.
  phoneNumber      String?
  bloodGroup       String?
  gender           Gender?
  height           Float?
  weight           Float?
  email            String?
  dateOfBirth      DateTime?
  identityToken    String?
  motherMaidenName String?
  // Deterministic identity fingerprint used to prevent duplicate patients (one
  // patient, many records). HMAC-SHA256 over national ID when present, else over
  // normalized last|first|dob|gender — see common/util/patient-identity.ts.
  // Nullable: rows without enough identity info skip dedup (Postgres treats NULLs
  // as distinct, so many null-key patients coexist). Backfilled for legacy rows.
  identityKey      String?
  // Nullable stub — actual upload/serving deferred to Phase 6 file storage.
  avatarUrl        String?
  clientId         String?
  client           Client?           @relation(fields: [clientId], references: [id])
  addresses        PatientAddress[]
  records          Record[]
  appointments     Appointment[]
  correlationCases CorrelationCase[]
  recalls          RecallRecord[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([labId, registrationNo])
  @@unique([labId, identityKey])
  @@index([labId])
  @@index([clientId])
}

model ClientType {
  id        String         @id @default(uuid())
  labId     String
  lab       Lab            @relation(fields: [labId], references: [id])
  name      String
  type      ClientTypeEnum
  clients   Client[]
  createdAt DateTime       @default(now())

  @@index([labId])
}

model Client {
  id                      String                   @id @default(uuid())
  labId                   String
  lab                     Lab                      @relation(fields: [labId], references: [id])
  firstName               String
  lastName                String
  officeName              String?
  // Client account number (legacy AC#, e.g. CYLB-577071) — lab-code prefix +
  // seeded LabSequence counter; imported verbatim. Nullable at the column level
  // but always set on create.
  accountNo               String?
  // Supports the patient form's "choose client by name OR email" search.
  email                   String?
  phoneNumber             String?
  mobileNumber            String?
  officeNumber            String?
  faxNumber               String?
  // Active/blocked toggles from the legacy Client form.
  active                  Boolean                  @default(true)
  blocked                 Boolean                  @default(false)
  // Nullable stub — actual upload/serving deferred to Phase 6 file storage.
  avatarUrl               String?
  // The client's assigned lab code/region (legacy "Labcode" dropdown). Closes
  // the Phase 3 "LabCode <-> Client" tracked debt.
  labCodeId               String?
  labCode                 LabCode?                 @relation(fields: [labCodeId], references: [id])
  // Optional workspace the client belongs to (legacy "Workspace" section).
  workspaceId             String?
  workspace               Workspace?               @relation(fields: [workspaceId], references: [id])
  clientTypeId            String?
  clientType              ClientType?              @relation(fields: [clientTypeId], references: [id])
  patients                Patient[]
  requisitions            Requisition[]
  records                 Record[]
  specimens               Specimen[]
  cabinets                Cabinet[]
  bills                   Bill[]
  addresses               ClientAddress[]
  portalUsers             PortalUser[]
  changeRequests          ChangeRequest[]
  changeRequestMessages   ChangeRequestMessage[]
  changeRequestEvents     ChangeRequestEvent[]
  threads                 Thread[]
  appointments            Appointment[]
  requisitionBatches      RequisitionBatch[]
  digitalRequisitionForms DigitalRequisitionForm[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@unique([labId, accountNo])
  @@index([labCodeId])
  @@index([workspaceId])
  @@index([labId])
}

model Requisition {
  id             String               @id @default(uuid())
  labId          String
  lab            Lab                  @relation(fields: [labId], references: [id])
  // Human-facing requisition number (legacy Ref#, e.g. 1460). Auto-generated
  // per lab via a seeded LabSequence; imported verbatim during migration.
  // Nullable at the column level (survives existing rows) but always set on
  // create — mirrors PortalUser.username.
  referenceNo    String?
  status         RequisitionStatus    @default(Pending)
  // Batch total = Σ line costs, in minor units (cents). Never a float.
  amount         Int                  @default(0)
  clientId       String?
  client         Client?              @relation(fields: [clientId], references: [id])
  workspaceId    String?
  workspace      Workspace?           @relation(fields: [workspaceId], references: [id])
  lines          RequisitionLine[]
  dateReceived   DateTime?
  tracking       RequisitionTracking?
  trackingEvents TrackingEvent[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([labId, referenceNo])
  @@index([labId])
  @@index([clientId])
}

model RequisitionLine {
  id            String              @id @default(uuid())
  labId         String
  lab           Lab                 @relation(fields: [labId], references: [id])
  requisitionId String
  requisition   Requisition         @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  // Per-item reference number (legacy: the clickable 12-digit accession on each
  // requisition row). Generated per-line at requisition create via a seeded
  // per-lab counter; unique per lab. This is the item's stable identity — the
  // link that opens the patient form — and exists before the line is accessioned
  // into a Record.
  referenceNo   String?
  // Cytology test class (Gyn/NonGyn), separate from the specimen material.
  formType      RequisitionFormType @default(Gynecology)
  isUrgent      Boolean             @default(false)
  // Cached fulfillment flag: true once the linked record reaches Completed+.
  // The parent requisition's Partial/Completed status is recomputed from these.
  isCompleted   Boolean             @default(false)
  notes         String?
  // Line cost in minor units (cents). Never a float.
  amount        Int                 @default(0)
  recordId      String?
  record        Record?             @relation(fields: [recordId], references: [id])

  @@unique([labId, referenceNo])
  @@index([labId])
  @@index([requisitionId])
  @@index([recordId])
}

model Record {
  id                   String                  @id @default(uuid())
  labId                String
  lab                  Lab                     @relation(fields: [labId], references: [id])
  // Internal, stable system id (never human-edited). Generated at create.
  identifier           String
  // Human-facing case number (legacy Lab No., e.g. CBL26-06-465). Generated per
  // lab via a MONTHLY-reset LabSequence; imported verbatim. Nullable at the
  // column level (survives existing rows) but always set on create.
  labNumber            String?
  // Which clinical form this case uses — the discriminator for which
  // *ClinicalFeatures relation applies. Reuses RequisitionFormType (flows
  // requisition-line -> record); one shared enum.
  formType             RequisitionFormType?
  // Referring/requesting doctor (free-text on the record form).
  doctor               String?
  clinicalDiagnosis    String?
  specimenDate         DateTime?
  urgent               Boolean                 @default(false)
  medicalEntry         String?
  billed               Boolean                 @default(false)
  status               RecordStatus            @default(Pending)
  dateStatus           DateTime?
  patientId            String
  patient              Patient                 @relation(fields: [patientId], references: [id])
  clientId             String?
  client               Client?                 @relation(fields: [clientId], references: [id])
  workspaceId          String?
  workspace            Workspace?              @relation(fields: [workspaceId], references: [id])
  specimens            Specimen[]
  statusHistory        RecordStatusEvent[]
  requisitionLines     RequisitionLine[]
  therapy              Therapy?
  gynFeatures          GynClinicalFeatures?
  nonGynFeatures       NonGynClinicalFeatures?
  resultSheets         ResultSheet[]
  bethesdaResult       BethesdaResult?
  tatAlerts            TATAlert[]
  escalations          EscalationRecord[]
  qcChecks             QCCheck[]
  cytologyCorrelations CorrelationCase[]       @relation("CytologyRecord")
  reagentUsages        ReagentUsage[]
  recalls              RecallRecord[]
  digitalSlides        DigitalSlide[]
  aiScreening          AIScreeningResult?
  consultRequests      ConsultRequest[]
  codings              RecordCoding[]
  fhirTransmissions    FHIRTransmission[]
  ancillaryOrders      AncillaryOrder[]
  screeningBatchCases  ScreeningBatchCase[]
  // Case assignment (Tier 2 — workload balancing). Fields are unconditional in
  // the schema; only the UI is feature-gated.
  assignedToId         String?
  assignedTo           User?                   @relation("RecordAssignee", fields: [assignedToId], references: [id])
  assignedAt           DateTime?
  assignedById         String?
  bills                Bill[]
  changeRequests       ChangeRequest[]
  attachments          RecordAttachment[]
  cabinetId            String?
  cabinet              Cabinet?                @relation(fields: [cabinetId], references: [id])
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([labId, identifier])
  @@unique([labId, labNumber])
  @@index([labId])
  @@index([patientId])
  @@index([clientId])
  @@index([cabinetId])
  @@index([status])
}

// Append-only status history — feeds the client portal (F2) status timeline
model RecordStatusEvent {
  id        String       @id @default(uuid())
  labId     String
  lab       Lab          @relation(fields: [labId], references: [id])
  recordId  String
  record    Record       @relation(fields: [recordId], references: [id], onDelete: Cascade)
  status    RecordStatus
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  notes     String?
  createdAt DateTime     @default(now())

  @@index([labId])
  @@index([recordId])
  @@index([recordId, createdAt])
}

model Specimen {
  id            String          @id @default(uuid())
  labId         String
  lab           Lab             @relation(fields: [labId], references: [id])
  label         String?
  vialColour    String?
  antiserumA    String?
  antiserumB    String?
  rhSolution    String?
  type          SpecimenType
  bloodGroup    String?
  recordId      String
  record        Record          @relation(fields: [recordId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?         @relation(fields: [clientId], references: [id])
  dateReceived  DateTime?
  resultEntries ResultEntry[]
  images        SpecimenImage[]
  digitalSlides DigitalSlide[] // P5-1 optional specimen-anchored slides (nullable link)
  datasetSlides DatasetSlide[] // P6-6B — dataset membership (specimen refs)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([labId])
  @@index([recordId])
}

model Therapy {
  id        String  @id @default(uuid())
  labId     String
  lab       Lab     @relation(fields: [labId], references: [id])
  recordId  String  @unique
  record    Record  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  hormone   Boolean @default(false)
  radiation Boolean @default(false)
  surgical  Boolean @default(false)
  other     String?

  @@index([labId])
}

// ---- Phase 3: Results & Coding ----

// A named, colored filing folder linked to a Client. Its contents are that
// client's specimen records (automatic-by-client: records where clientId =
// cabinet.clientId), NOT the legacy per-record Record.cabinetId assignment,
// which is now deprecated (kept as a column, no longer written/read here).
// `identifier` holds the reference code CB{accountNo}-{RAND4}, generated when a
// client is linked.
model Cabinet {
  id         String   @id @default(uuid())
  labId      String
  lab        Lab      @relation(fields: [labId], references: [id])
  label      String
  identifier String?
  color      String?
  // The linked client. At most one cabinet per client (nullable → many unlinked
  // cabinets allowed, since Postgres treats NULLs as distinct).
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id])
  records    Record[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([labId, clientId])
  @@index([labId])
  @@index([clientId])
}

// Reference list of diagnostic code sheets.
model CodeSheet {
  id           String   @id @default(uuid())
  labId        String
  lab          Lab      @relation(fields: [labId], references: [id])
  abbreviation String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([labId])
}

// Reference list of code findings (independent of CodeSheet, per legacy).
model CodeFinding {
  id           String   @id @default(uuid())
  labId        String
  lab          Lab      @relation(fields: [labId], references: [id])
  abbreviation String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([labId])
}

// Lab/region code.
model LabCode {
  id        String   @id @default(uuid())
  labId     String
  lab       Lab      @relation(fields: [labId], references: [id])
  code      String
  region    String?
  clients   Client[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Legacy enforced a unique code; per-lab uniqueness is the multi-tenant form.
  @@unique([labId, code])
  @@index([labId])
}

// A record's result sheet: filled with entries/lines, then authorized.
// Authorization (who/when) is the gate that allows a report to be released.
model ResultSheet {
  id             String             @id @default(uuid())
  labId          String
  lab            Lab                @relation(fields: [labId], references: [id])
  recordId       String
  record         Record             @relation(fields: [recordId], references: [id], onDelete: Cascade)
  // External uploaded result sheet (stub — populated when Phase 6 file storage
  // lands; the in-system entry path uses resultEntries below).
  fileUrl        String?
  viewed         Boolean            @default(false)
  // Authorization gate (Phase 3 critical rule): set by a user holding
  // resultsheet:authorize. Editing entries resets these (re-authorization required).
  authorized     Boolean            @default(false)
  authorizedAt   DateTime?
  authorizedById String?
  authorizedBy   User?              @relation("ResultSheetAuthorizer", fields: [authorizedById], references: [id])
  // Human-owned working narrative the Authorizer edits and signs. An accepted AI
  // draft (F4) is copied here; at report release this becomes Report.content.
  // Owned by the human — the AiDraft keeps the provenance separately.
  narrative      String?
  resultEntries  ResultEntry[]
  reports        Report[]
  events         ResultSheetEvent[]
  aiDrafts       AiDraft[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([labId])
  @@index([recordId])
}

// Append-only audit of authorization state changes (authorize / de-authorize on
// edit / re-authorize). The live gate stays on ResultSheet; this is the history,
// and will feed the client portal (F2) report timeline.
model ResultSheetEvent {
  id            String               @id @default(uuid())
  labId         String
  lab           Lab                  @relation(fields: [labId], references: [id])
  resultSheetId String
  resultSheet   ResultSheet          @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)
  type          ResultSheetEventType
  userId        String?
  user          User?                @relation(fields: [userId], references: [id])
  createdAt     DateTime             @default(now())

  @@index([labId])
  @@index([resultSheetId])
  @@index([resultSheetId, createdAt])
}

model ResultEntry {
  id            String       @id @default(uuid())
  labId         String
  lab           Lab          @relation(fields: [labId], references: [id])
  resultSheetId String
  resultSheet   ResultSheet  @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)
  specimenId    String?
  specimen      Specimen?    @relation(fields: [specimenId], references: [id])
  resultLines   ResultLine[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([labId])
  @@index([resultSheetId])
}

model ResultLine {
  id              String      @id @default(uuid())
  labId           String
  lab             Lab         @relation(fields: [labId], references: [id])
  resultEntryId   String
  resultEntry     ResultEntry @relation(fields: [resultEntryId], references: [id], onDelete: Cascade)
  abbreviation    String?
  result          String?
  findings        String?
  abnormalFinding Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([labId])
  @@index([resultEntryId])
}

// A released pathology report. Only created from an authorized result sheet.
model Report {
  id                  String      @id @default(uuid())
  labId               String
  lab                 Lab         @relation(fields: [labId], references: [id])
  resultSheetId       String
  resultSheet         ResultSheet @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)
  authorizerReference String?
  content             String?
  signature           String?
  digitalSignature    String?
  medicalEntry        String?
  writtenById         String?
  writtenBy           User?       @relation("ReportAuthor", fields: [writtenById], references: [id])
  releasedAt          DateTime    @default(now())
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([labId])
  @@index([resultSheetId])
}

// ---- F4: AI-assisted reporting ----
// AI is strictly ASSISTIVE. Nothing here authorizes or bypasses the auth gate;
// every AI call is best-effort and degrades gracefully. See docs/F4_AI_REPORTING_DESIGN.md.

// Per-lab AI configuration. Off by default (opt-in, compliance-gated).
model LabAiSettings {
  id              String          @id @default(uuid())
  labId           String          @unique
  lab             Lab             @relation(fields: [labId], references: [id])
  enabled         Boolean         @default(false)
  houseStyle      String? // lab's narrative template / style guidance
  redactionPolicy RedactionPolicy @default(Strict)
  model           String? // optional model override; else the server default
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum RedactionPolicy {
  Strict // clinical data only — NO demographics
  Standard // adds de-identified sex + age BAND (never DOB / exact age)
}

// Provenance record for every AI generation, kept forever. Never overwritten:
// a result sheet accumulates drafts over time.
model AiDraft {
  id              String          @id @default(uuid())
  labId           String
  lab             Lab             @relation(fields: [labId], references: [id])
  resultSheetId   String
  resultSheet     ResultSheet     @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)
  kind            AiDraftKind
  status          AiDraftStatus   @default(Generated)
  // What the model produced: narrative text, or a JSON string for codes/consistency.
  output          String
  // Provenance
  model           String // exact model id used
  promptVersion   String // e.g. "narrative-v1" — bumped when the prompt changes
  redactionPolicy RedactionPolicy // policy snapshot applied at generation
  inputDigest     String // sha256 of the exact redacted payload (proves input class w/o storing PHI)
  createdById     String?
  createdBy       User?           @relation("AiDraftCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())
  // Human review (Narrative kind): the edited final text + diff at acceptance.
  finalText       String?
  editedDiff      Json? // structured diff: AI output -> finalText
  acceptedAt      DateTime?
  acceptedById    String?
  acceptedBy      User?           @relation("AiDraftAcceptedBy", fields: [acceptedById], references: [id])

  @@index([labId])
  @@index([resultSheetId])
}

enum AiDraftKind {
  Narrative
  CodeSuggestion
  ConsistencyCheck
}

enum AiDraftStatus {
  Generated
  Accepted
  Rejected
  Superseded
}

// ============================================================================
// Program 6 · Phase 6A — AI model registry, versioning & lifecycle governance.
// ARCHITECTURE ONLY: a LAB-SCOPED clinical/image AI model registry, versioned
// metadata with a PERMANENT immutable UUID identity, an append-only lifecycle
// transition log, and an immutable InferenceRecord SHELL. There is NO image
// inference / prediction / execution / queue / worker / runtime model call in
// 6A (those arrive in 6C). This is a PARALLEL subsystem to the text-reporting
// AiService/AiDraft path (which is untouched) and is unrelated to the simulated
// AIScreeningResult (a Legacy Demonstration Component). No PHI is stored: slides
// are referenced by id only; provenance is a digest/reference, never patient
// data and never model weights/binaries.
// ============================================================================

enum AiModelLifecycleState {
  DRAFT
  VALIDATION
  APPROVED
  DEPRECATED
  RETIRED
}

// A logical clinical/image AI model in a lab's registry. `modelUuid` is the
// permanent identity that never changes as key/displayName evolve.
model AiModel {
  id          String   @id @default(cuid())
  modelUuid   String   @unique @default(uuid())
  labId       String
  lab         Lab      @relation(fields: [labId], references: [id])
  key         String // stable human slug (unique per lab)
  displayName String
  task        String // descriptive purpose — NEVER a clinical/diagnostic claim
  description String?
  createdById String? // actor; no FK so provenance survives user deletion
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions AiModelVersion[]

  @@unique([labId, key])
  @@index([labId])
}

// A versioned, lifecycle-bearing, provenance-bearing model version. Content and
// provenance are immutable after creation; only `lifecycleState` transitions,
// each recorded append-only in AiModelLifecycleEvent. `versionUuid` is the
// permanent identity, independent of key/semver.
model AiModelVersion {
  id          String  @id @default(cuid())
  versionUuid String  @unique @default(uuid())
  labId       String
  lab         Lab     @relation(fields: [labId], references: [id])
  modelId     String
  model       AiModel @relation(fields: [modelId], references: [id], onDelete: Restrict)

  semverMajor Int
  semverMinor Int
  semverPatch Int

  lifecycleState AiModelLifecycleState @default(DRAFT)

  // Provenance — a REFERENCE/DIGEST only; never model weights/binaries, never PHI.
  artifactDigest String? // sha256 of an artifact reference (not the artifact itself)
  provenanceRef  String? // URI / opaque provenance reference; no PHI

  createdById String? // actor; no FK
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Latest transition-into-state stamps (the append-only log is authoritative).
  validatedAt  DateTime?
  approvedAt   DateTime?
  deprecatedAt DateTime?
  retiredAt    DateTime?

  lifecycleEvents     AiModelLifecycleEvent[]
  inferenceRecords    InferenceRecord[]
  inferenceJobs       InferenceJob[] // P6-6C — execution jobs selecting this version
  validationRuns      ValidationRun[] // P6-6F — validation-evidence runs evaluating this version (reference only; no lifecycle mutation)
  evaluationWindows   EvaluationWindow[] // P6-6G — continuous-evaluation windows monitoring this version (reference only; no lifecycle mutation)
  clinicalPerfWindows ClinicalPerfWindow[] // P6-6H — clinical-performance measurement windows for this version (reference only; no diagnostic/lifecycle authority)

  @@unique([labId, modelId, semverMajor, semverMinor, semverPatch])
  @@index([labId])
  @@index([labId, lifecycleState])
  @@index([modelId])
}

// Append-only lifecycle transition log — the deterministic audit trail. Restrict
// on delete (audit evidence, never a silent cascade). Rows of one transition
// share `eventId`. No update/delete path in the application.
model AiModelLifecycleEvent {
  id             String         @id @default(cuid())
  labId          String
  lab            Lab            @relation(fields: [labId], references: [id])
  modelVersionId String
  modelVersion   AiModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Restrict)

  fromState  AiModelLifecycleState
  toState    AiModelLifecycleState
  actorId    String? // actor; no FK
  reason     String? // structured/plain justification; NEVER PHI
  eventId    String // shared across the rows of one transition transaction
  occurredAt DateTime              @default(now())

  @@index([labId])
  @@index([labId, modelVersionId])
  @@index([modelVersionId])
}

// Immutable inference-record shell — the 6A-reserved provenance record, ADDITIVELY
// activated in 6C. The 6A-era columns (identity/lab/model-version ref/optional slide
// ref/inputDigest/requestedAt) are UNCHANGED. 6C adds — additively — the immutable
// EVIDENCE of one completed execution (deterministic-contract fields + outcome +
// result reference/digest + timing), written EXACTLY ONCE at terminalization and
// never mutated (no update/delete path in the application — the mutable job lives in
// InferenceJob; the audit trail in InferenceEvent). Slides are referenced by id ONLY
// — no PHI is copied; results are digest/reference only — no bytes, no PHI, and no
// diagnostic claim. All provenance FKs are RESTRICT: accepted inference provenance can
// never lose its subject/version/job reference via a later deletion.
model InferenceRecord {
  id             String         @id @default(cuid())
  recordUuid     String         @unique @default(uuid())
  labId          String
  lab            Lab            @relation(fields: [labId], references: [id])
  modelVersionId String
  modelVersion   AiModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Restrict)
  subjectSlideId String? // reference ONLY to DigitalSlide (labId,id); no PHI copied
  subjectSlide   DigitalSlide?  @relation(fields: [subjectSlideId], references: [id], onDelete: Restrict)

  inputDigest String? // sha256 of a redacted/reference payload; proves input class w/o PHI
  requestedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  // ── P6-6C additive immutable evidence (written once at terminalization) ──────────
  jobId String?       @unique // the execution that produced this evidence (1:1)
  job   InferenceJob? @relation(fields: [jobId], references: [id], onDelete: Restrict)

  // Deterministic execution contract (Decision 10) — reproducible from audit.
  adapterId                String? // selected adapter identity (e.g. "stub")
  adapterVersion           String? // adapter version — provenance of what ran
  engineVersion            String? // orchestration-engine version
  configDigest             String? // sha256 of the runtime configuration that materially affects execution (Guardrail 1) — immutable
  modelLifecycleStateAtRun AiModelLifecycleState? // eligibility provenance at dispatch (VALIDATION vs APPROVED)
  validationOnly           Boolean                @default(false) // immutable "not approved for clinical use" provenance (Decision 3)

  outcome      InferenceOutcome? // terminal outcome frozen onto the evidence
  resultDigest String? // sha256 of the structured output — evidence without copying content
  resultRef    String? // opaque reference/URI to the structured output; NO bytes, NO PHI, NO diagnostic narrative
  startedAt    DateTime? // execution start (provenance/timing)
  finishedAt   DateTime? // execution end (provenance/timing)
  durationMs   Int? // runtime duration (Decision 10)

  // P6-6D — downstream explainability evidence (reference only; never mutates this record).
  explainabilityGenerations ExplainabilityGeneration[]
  explainabilityArtifacts   ExplainabilityArtifact[]

  // P6-6E — downstream human-review evidence (reference only; never mutates this record).
  humanReviewRequests  HumanReviewRequest[]
  humanReviewDecisions HumanReviewDecision[]

  // P6-6G — continuous-evaluation window membership (reference only; never mutates this record).
  evaluationWindowMembers EvaluationWindowMember[]

  // P6-6H — clinical-performance window membership (reference only; never mutates this record).
  clinicalPerfWindowMembers ClinicalPerfWindowMember[]

  @@index([labId])
  @@index([labId, modelVersionId])
  @@index([jobId])
}

// ============================================================================
// Program 6 · Phase 6C — inference EXECUTION ENGINE (orchestration only; never
// clinical interpretation). A MUTABLE, lease-based execution/queue row
// (InferenceJob) mirrors the Program-5 SlideProcessingJob concurrency core; on
// terminalization it writes the immutable InferenceRecord evidence once and an
// append-only InferenceEvent audit trail. The default adapter is deterministic
// and NON-CLINICAL. Model selection is limited to eligible lifecycle states
// (VALIDATION/APPROVED); VALIDATION runs are recorded validation-only. Slides are
// referenced by id ONLY; results are digest/reference only — no bytes, no PHI, no
// diagnostic claim. All provenance FKs RESTRICT; lab-scoped tenancy throughout.
// ============================================================================

enum InferenceJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
}

enum InferenceOutcome {
  SUCCEEDED
  FAILED
  TIMED_OUT
}

// Mutable inference execution/queue row (mirrors SlideProcessingJob). Lease-based
// ownership; status transitions QUEUED → RUNNING → (SUCCEEDED | FAILED | TIMED_OUT).
// Runtime cadences/lease DURATION are policy (config), never schema — only the
// resulting expiry timestamp is stored. A raw-SQL PARTIAL UNIQUE INDEX on
// (modelVersionId, subjectSlideId, inputDigest) WHERE status IN ('QUEUED','RUNNING')
// enforces at-most-one-active inference per subject+input (Decision 5).
model InferenceJob {
  id             String         @id @default(cuid())
  jobUuid        String         @unique @default(uuid())
  labId          String
  lab            Lab            @relation(fields: [labId], references: [id])
  modelVersionId String
  modelVersion   AiModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Restrict)
  subjectSlideId String? // reference ONLY to DigitalSlide (labId,id); no PHI copied
  subjectSlide   DigitalSlide?  @relation(fields: [subjectSlideId], references: [id], onDelete: Restrict)

  inputDigest  String // sha256 of a redacted/reference payload; proves input class w/o PHI
  configDigest String? // sha256 of the runtime configuration that materially affects execution (Guardrail 1)
  adapterId    String // selected adapter identity (default deterministic stub)

  status         InferenceJobStatus @default(QUEUED)
  attempt        Int                @default(1)
  workerId       String? // logical worker identity (populated at claim)
  heartbeatAt    DateTime?
  leaseExpiresAt DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  errorCode      String? // stable classified failure code — never PHI
  errorDetail    String? // bounded diagnostic — never PHI, never a diagnostic claim

  createdById String? // actor; no FK so provenance survives user deletion
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  record InferenceRecord? // the immutable evidence written at terminalization (1:1)
  events InferenceEvent[] // append-only audit trail

  @@index([labId])
  @@index([labId, status])
  @@index([status, leaseExpiresAt]) // reclaimer scan (RUNNING jobs with an expired lease)
  @@index([modelVersionId])
}

// Append-only inference audit trail (mirrors AiModelLifecycleEvent). Exactly one
// row per accepted status transition; the rows of one transition share `eventId`.
// No update/delete path in the application. Restrict on delete (audit evidence).
model InferenceEvent {
  id    String       @id @default(cuid())
  labId String
  lab   Lab          @relation(fields: [labId], references: [id])
  jobId String
  job   InferenceJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  fromStatus InferenceJobStatus?
  toStatus   InferenceJobStatus
  actorId    String? // actor; no FK
  detail     String? // structured/bounded; NEVER PHI, NEVER a diagnostic claim
  eventId    String // shared across the rows of one transition
  occurredAt DateTime            @default(now())

  @@index([labId])
  @@index([labId, jobId])
  @@index([jobId])
}

// ============================================================================
// Program 6 · Phase 6D — EXPLAINABILITY (governed artifact architecture only;
// assists, NEVER asserts correctness). Immutable, append-only explainability
// artifacts attached to a completed (SUCCEEDED) 6C InferenceRecord by identity
// (RESTRICT); the default generator is a DETERMINISTIC, NON-CLINICAL stub. A
// single generation request creates the complete artifact set atomically under
// one shared generationUuid (Guardrail 2). Every geometry-bearing artifact
// records immutable coordinate-space provenance (Guardrail 1). Content is
// digest/reference only — NO bytes/tiles/PHI. Structured kind-specific content
// (regions/probabilities) uses tightly-validated child rows, never arbitrary
// JSON blobs. NO field asserts diagnosis/correctness/accuracy/confidence/ground
// truth; validationOnly is inherited immutably from the record. Explainability
// NEVER mutates the InferenceRecord or any 6C/6A/6B row (no support inference).
// Lab-scoped; all provenance FKs onDelete: Restrict. Distinct from SlideAnnotation
// (viewer markup) and GroundTruthLabel (6B ground truth).
// ============================================================================

enum ExplainabilityArtifactKind {
  HEATMAP
  ATTENTION_OVERLAY
  FEATURE_REGION
  PROBABILITY_DISTRIBUTION
}

enum ExplainabilityRegionType {
  BOUNDING_BOX
  POLYGON
}

// The artifact-set aggregate (Decision 12 / Guardrail 2): one deterministic
// generation request → one atomic, immutable set of artifacts sharing this
// identity. Append-only; references a SUCCEEDED InferenceRecord (service-enforced).
model ExplainabilityGeneration {
  id                String          @id @default(cuid())
  generationUuid    String          @unique @default(uuid())
  labId             String
  lab               Lab             @relation(fields: [labId], references: [id])
  inferenceRecordId String
  inferenceRecord   InferenceRecord @relation(fields: [inferenceRecordId], references: [id], onDelete: Restrict)
  subjectSlideId    String? // coordinate-space subject (from the record); reference only, no PHI
  subjectSlide      DigitalSlide?   @relation(fields: [subjectSlideId], references: [id], onDelete: Restrict)

  generatorId      String // generator identity (default deterministic stub)
  generatorVersion String
  configDigest     String? // sha256 of the runtime configuration that materially affects generation
  validationOnly   Boolean // inherited IMMUTABLY from the inference record (Decision 3/5)

  // Guardrail 1 — immutable coordinate-space provenance: interpret geometry against the originating
  // slide regardless of future viewer/slide changes.
  coordinateSpace String? // e.g. "slide-pixel"
  slideWidthPx    Int? // slide dimensions snapshot AT GENERATION time
  slideHeightPx   Int?

  eventId     String // shared deterministic event identity across the set
  createdById String? // actor; no FK
  createdAt   DateTime @default(now())

  artifacts ExplainabilityArtifact[]

  // P6-6E — human-review decisions that (optionally) consulted this generation (reference only; RESTRICT).
  humanReviewDecisions HumanReviewDecision[]

  @@index([labId])
  @@index([labId, inferenceRecordId])
  @@index([inferenceRecordId])
}

// The common immutable artifact row (Decision 2). Kind-specific content lives in the
// tightly-validated child rows below (regions / probabilities), never arbitrary JSON.
// NO diagnosis/correct/accuracy/clinicalConfidence/groundTruth/validated/approvedInterpretation
// column may exist here (Decision 3).
model ExplainabilityArtifact {
  id                String                     @id @default(cuid())
  artifactUuid      String                     @unique @default(uuid())
  labId             String
  lab               Lab                        @relation(fields: [labId], references: [id])
  generationId      String
  generation        ExplainabilityGeneration   @relation(fields: [generationId], references: [id], onDelete: Restrict)
  inferenceRecordId String
  inferenceRecord   InferenceRecord            @relation(fields: [inferenceRecordId], references: [id], onDelete: Restrict)
  kind              ExplainabilityArtifactKind

  generatorId      String
  generatorVersion String
  configDigest     String?
  contentDigest    String // sha256 of the structured content — evidence without copying
  contentRef       String? // opaque reference; NO bytes/tiles/PHI/diagnostic narrative
  validationOnly   Boolean // inherited immutably from the generation/record

  // Guardrail 1 — geometry-bearing artifacts carry coordinate-space provenance for self-containment.
  slideId         String?
  slide           DigitalSlide? @relation(fields: [slideId], references: [id], onDelete: Restrict)
  coordinateSpace String? // e.g. "slide-pixel@<w>x<h>"

  createdAt DateTime @default(now())

  regions       ExplainabilityRegion[]
  probabilities ExplainabilityProbability[]

  @@index([labId])
  @@index([labId, generationId])
  @@index([labId, inferenceRecordId])
  @@index([generationId])
}

// Feature-region / overlay geometry (Decision 7). Slide pixel space; box or polygon;
// coded categories only — NO diagnostic narrative, NO human ground-truth semantics.
// DISTINCT from SlideAnnotation and GroundTruthLabel.
model ExplainabilityRegion {
  id         String                 @id @default(cuid())
  labId      String
  lab        Lab                    @relation(fields: [labId], references: [id])
  artifactId String
  artifact   ExplainabilityArtifact @relation(fields: [artifactId], references: [id], onDelete: Restrict)

  regionType   ExplainabilityRegionType
  categoryCode String // coded region category — never a narrative or diagnosis
  geometry     Json // validated: box {x,y,w,h} (finite, non-negative) or polygon {points:[{x,y}...]} (>=3)
  weight       Float? // optional coded intensity — NOT confidence, NOT accuracy
  ordinal      Int                      @default(0) // deterministic ordering within the artifact
  createdAt    DateTime                 @default(now())

  @@index([labId])
  @@index([labId, artifactId])
  @@index([artifactId])
}

// Probability-distribution entries (Decision 6). Coded, non-diagnostic classes; finite
// values; deterministic ordering; the service enforces Σvalue = 1.0 ± tolerance. A value
// is NOT "clinical confidence"; a classCode is NOT a diagnosis.
model ExplainabilityProbability {
  id         String                 @id @default(cuid())
  labId      String
  lab        Lab                    @relation(fields: [labId], references: [id])
  artifactId String
  artifact   ExplainabilityArtifact @relation(fields: [artifactId], references: [id], onDelete: Restrict)

  classCode String // stable coded class identity — never a diagnosis/clinical conclusion
  value     Float // finite probability mass
  ordinal   Int // deterministic ordering
  createdAt DateTime @default(now())

  @@unique([labId, artifactId, classCode])
  @@index([labId])
  @@index([labId, artifactId])
  @@index([artifactId])
}

// ============================================================================
// Program 6 · Phase 6E — HUMAN REVIEW WORKFLOW (the human owns the diagnosis).
// A governed human-decision EVIDENCE layer over a completed (SUCCEEDED) 6C
// InferenceRecord — SEPARATE from, and never modifying, the authoritative clinical
// sign-out (ResultSheet/Record/AiDraft). A mutable HumanReviewRequest carries
// operational routing (PENDING→ASSIGNED→COMPLETED→CANCELLED); the immutable
// append-only HumanReviewDecision rows carry the human's ACCEPT/REJECT/MODIFY
// (change of mind = a NEW decision; the effective decision is DERIVED, never
// rewritten). The reviewer is a NON-NULL User FK (RESTRICT) taken from the
// authenticated principal — never the request body; no AI/worker/scheduler/system
// path may author a decision. MODIFY content is structured coded child rows (no
// PHI, no report narrative, no diagnosis field). Each decision snapshots what was
// reviewed (record + model version + result digest + validation-only) so it never
// depends on mutable downstream lookups (Guardrail 1). An optional explainability
// reference must belong to the SAME InferenceRecord + lab (Guardrail 2). Deliberately
// uses reviewDecision/modifiedFinding/reviewRationale terminology — never a
// clinical-authority name. Lab-scoped; all provenance FKs onDelete: Restrict.
// ============================================================================

enum HumanReviewRequestState {
  PENDING
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum HumanReviewDecisionType {
  ACCEPT
  REJECT
  MODIFY
}

// Mutable operational routing — NOT clinical truth. State transitions are audited in
// HumanReviewRequestEvent; cancellation never deletes submitted decisions; completion
// is a deterministic boundary (Guardrail 3) that a governed reopen transitions, never mutates away.
model HumanReviewRequest {
  id                String                  @id @default(cuid())
  requestUuid       String                  @unique @default(uuid())
  labId             String
  lab               Lab                     @relation(fields: [labId], references: [id])
  inferenceRecordId String
  inferenceRecord   InferenceRecord         @relation(fields: [inferenceRecordId], references: [id], onDelete: Restrict)
  state             HumanReviewRequestState @default(PENDING)
  assigneeUserId    String? // reviewer assignment (workflow only; grants no clinical authority)
  assignee          User?                   @relation("HumanReviewAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict)
  validationOnly    Boolean // inherited immutably from the inference record
  completedAt       DateTime? // deterministic completion boundary (Guardrail 3)

  createdById String? // actor/machine provenance for the workflow object; no FK
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  decisions HumanReviewDecision[]
  events    HumanReviewRequestEvent[]

  @@index([labId])
  @@index([labId, inferenceRecordId])
  @@index([labId, state])
  @@index([inferenceRecordId])
}

// Immutable, append-only human decision (Decisions 3/4/11 + Guardrail 1). No update/delete path.
model HumanReviewDecision {
  id                String             @id @default(cuid())
  decisionUuid      String             @unique @default(uuid())
  labId             String
  lab               Lab                @relation(fields: [labId], references: [id])
  requestId         String
  request           HumanReviewRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  inferenceRecordId String
  inferenceRecord   InferenceRecord    @relation(fields: [inferenceRecordId], references: [id], onDelete: Restrict)

  // Human ownership — a NON-NULL authenticated reviewer (Decision 3). RESTRICT so the identity never vanishes.
  reviewerUserId String
  reviewer       User   @relation("HumanReviewReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  reviewDecision HumanReviewDecisionType
  validationOnly Boolean // inherited immutably (Decision 7)

  // Guardrail 1 — immutable snapshot of WHAT was reviewed (no dependence on mutable downstream lookups).
  reviewedModelVersionId      String // the model version identity the reviewed inference used
  reviewedResultDigest        String? // the inference result digest at review time
  modelLifecycleStateAtReview AiModelLifecycleState? // provenance

  reviewRationale  String? // SHORT bounded rationale only — never a report narrative, never PHI (Decision 6)
  correctionDigest String? // sha256 over the structured modifiedFinding rows (when MODIFY)

  // Guardrail 2 — optional consulted explainability; must belong to the SAME record + lab (service-enforced).
  explainabilityGenerationId String?
  explainabilityGeneration   ExplainabilityGeneration? @relation(fields: [explainabilityGenerationId], references: [id], onDelete: Restrict)

  eventId     String // immutable audit identity
  submittedAt DateTime @default(now())

  modifiedFindings HumanReviewModifiedFinding[]

  // P6-6H — clinical-performance window membership (reference only; never mutates this decision).
  clinicalPerfWindowMembers ClinicalPerfWindowMember[]

  @@index([labId])
  @@index([labId, requestId])
  @@index([labId, inferenceRecordId])
  @@index([requestId])
  @@index([reviewerUserId])
}

// Structured MODIFY content (Decision 6). Coded findings only — NO PHI, NO narrative, NO diagnosis field.
model HumanReviewModifiedFinding {
  id         String              @id @default(cuid())
  labId      String
  lab        Lab                 @relation(fields: [labId], references: [id])
  decisionId String
  decision   HumanReviewDecision @relation(fields: [decisionId], references: [id], onDelete: Restrict)

  findingCode String // coded finding identity — never a diagnosis name
  valueCode   String? // coded categorical value
  valueNum    Float? // structured numeric value
  ordinal     Int // deterministic ordering
  createdAt   DateTime @default(now())

  @@index([labId])
  @@index([labId, decisionId])
  @@index([decisionId])
}

// Append-only audit of the mutable request's state changes (Decision 11). No update/delete path.
model HumanReviewRequestEvent {
  id        String             @id @default(cuid())
  labId     String
  lab       Lab                @relation(fields: [labId], references: [id])
  requestId String
  request   HumanReviewRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  fromState  HumanReviewRequestState?
  toState    HumanReviewRequestState
  actorId    String? // actor; no FK
  eventId    String // shared with the transaction that caused it
  occurredAt DateTime                 @default(now())

  @@index([labId])
  @@index([labId, requestId])
  @@index([requestId])
}

// ============================================================================
// Program 6 · Phase 6F — VALIDATION EVIDENCE (no claim beyond recorded evidence).
// A governed, IMMUTABLE validation-evidence subsystem: a ValidationRun permanently
// binds a FROZEN 6B DatasetVersion (the immutable reference corpus + ground truth)
// to a 6A AiModelVersion (the evaluated model), and records structured metrics as
// evidence attached to the MODEL VERSION. The default validator is a DETERMINISTIC,
// NON-CLINICAL stub — 6F does NOT compute real model performance, certify a model,
// or make regulatory/clinical/accuracy claims. Validation INFORMS promotion but NEVER
// performs it (NO SUPPORT LIFECYCLE PROMOTION); it mutates no 6A-6E, dataset, or
// clinical state. Each run SNAPSHOTS the dataset identity + digest + ground-truth
// digest (Guardrail 1), the model identity + artifact digest (Guardrail 2), and the
// full validation config as digests (Guardrail 5), plus metric/computation provenance
// (Guardrails 3/7), so later dataset/registry/config evolution never alters the
// evidence. Metrics are STRUCTURED child rows (never JSON blobs/narrative); every
// numeric is validated; no PHI, no slide diagnosis. Runs are append-only (revalidation
// = a NEW, fully independent evidence graph — Guardrail 8); the whole set commits
// ATOMICALLY or not at all (Guardrail 6). Lab-scoped; all provenance FKs RESTRICT.
// ============================================================================

enum ValidationMetricKind {
  CONFUSION_MATRIX
  SENSITIVITY
  SPECIFICITY
  PRECISION
  RECALL
  F_SCORE
  ROC_POINT
  CALIBRATION_POINT
  OPERATING_THRESHOLD
}

// Immutable validation-evidence aggregate. Binds a FROZEN DatasetVersion × an
// AiModelVersion (both RESTRICT) and permanently snapshots what was validated. No
// update/delete path; revalidation creates a NEW run with its own independent children.
model ValidationRun {
  id               String         @id @default(cuid())
  runUuid          String         @unique @default(uuid())
  labId            String
  lab              Lab            @relation(fields: [labId], references: [id])
  modelVersionId   String
  modelVersion     AiModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Restrict)
  datasetVersionId String
  datasetVersion   DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Restrict)

  // Guardrail 1 — dataset identity snapshot (interpretation fixed regardless of later dataset evolution).
  datasetManifestDigest String?
  groundTruthDigest     String

  // Guardrail 2 — model identity snapshot (provenance fixed regardless of later registry evolution).
  modelVersionUuid         String
  modelUuid                String
  modelArtifactDigest      String?
  adapterId                String? // where applicable (not applicable to a model-version validation → null)
  adapterVersion           String?
  modelLifecycleStateAtRun AiModelLifecycleState

  // Guardrails 3/5/7 — computation + config provenance (deterministic + traceable).
  validatorId             String
  validatorVersion        String
  computationVersion      String // Guardrail 3 — how metrics were produced
  metricSchemaVersion     String // Guardrail 7 — the metric-catalog schema version (distinct from computationVersion)
  calculationId           String // Guardrail 3/4 — deterministic calculation identifier
  configDigest            String? // Guardrail 5 — overall validation-config digest
  thresholdConfigDigest   String? // Guardrail 5 — operating-threshold config
  metricSelectionDigest   String? // Guardrail 5 — metric-selection config
  computationConfigDigest String? // Guardrail 5 — computation config

  eventId     String // immutable audit identity
  createdById String? // actor; no FK
  createdAt   DateTime @default(now())

  metrics        ValidationMetric[]
  confusionCells ValidationConfusionCell[]
  curvePoints    ValidationCurvePoint[]

  // P6-6G — continuous-evaluation windows that (optionally) compare against this run as an immutable baseline.
  evaluationWindows   EvaluationWindow[]
  // P6-6H — clinical-performance windows that (optionally) reference this run as an immutable baseline.
  clinicalPerfWindows ClinicalPerfWindow[]

  @@index([labId])
  @@index([labId, modelVersionId])
  @@index([labId, datasetVersionId])
  @@index([modelVersionId])
  @@index([datasetVersionId])
}

// A structured, validated scalar metric (Decision 4 + Guardrail 3). Coded class scope only.
model ValidationMetric {
  id    String        @id @default(cuid())
  labId String
  lab   Lab           @relation(fields: [labId], references: [id])
  runId String
  run   ValidationRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  metricKind        ValidationMetricKind
  labelClassCode    String? // coded class the metric is scoped to (null = overall) — never a diagnosis name
  value             Float? // validated finite; ratios in [0,1]
  numeratorSource   String? // Guardrail 3 — provenance of the numerator
  denominatorSource String? // Guardrail 3 — provenance of the denominator
  ordinal           Int
  createdAt         DateTime             @default(now())

  @@index([labId])
  @@index([labId, runId])
  @@index([runId])
}

// Structured confusion-matrix counts (Decision 4). Coded classes only — never a diagnosis.
model ValidationConfusionCell {
  id    String        @id @default(cuid())
  labId String
  lab   Lab           @relation(fields: [labId], references: [id])
  runId String
  run   ValidationRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  trueClassCode String // coded
  predClassCode String // coded
  count         Int // validated >= 0
  createdAt     DateTime @default(now())

  @@unique([labId, runId, trueClassCode, predClassCode])
  @@index([labId])
  @@index([labId, runId])
  @@index([runId])
}

// Structured ROC / calibration coordinates (Decision 4). Coordinates validated in [0,1].
model ValidationCurvePoint {
  id    String        @id @default(cuid())
  labId String
  lab   Lab           @relation(fields: [labId], references: [id])
  runId String
  run   ValidationRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  curveKind ValidationMetricKind // ROC_POINT | CALIBRATION_POINT
  x         Float // validated finite in [0,1]
  y         Float // validated finite in [0,1]
  threshold Float? // associated operating threshold, when applicable
  ordinal   Int // deterministic ordering
  createdAt DateTime             @default(now())

  @@index([labId])
  @@index([labId, runId])
  @@index([runId])
}

// ============================================================================
// Program 6 · Phase 6G — CONTINUOUS EVALUATION EVIDENCE (longitudinal, NOT
// autonomous). Immutable EvaluationWindows over a model version's inference stream
// (6C) record structured evidence — volume, outcome/failure/timeout rates, latency
// distributions, drift + calibration-decay (vs an optional immutable 6F ValidationRun
// baseline), confidence bins (SYNTHETIC_STUB only — 6C exposes no structured
// confidence), and ADVISORY lifecycle-review recommendations. MANUAL trigger only —
// no worker/scheduler/hook. Each window SNAPSHOTS the model identity, the explicit
// time basis + window-definition version (Guardrail 7), and the EXACT eligible
// InferenceRecord population as immutable member rows (Guardrail 1); metrics carry an
// explicit OBSERVED/SYNTHETIC_STUB/UNAVAILABLE provenance + cohort (Guardrails 2/9);
// empty/sparse windows record truthful coverage with NO invented values (Decision 7).
// The whole graph is validated + committed atomically (Guardrails 5/12); a window has
// an explicit immutable COMPLETE state and a deterministic windowSignature for
// duplicate detection (Guardrail 8). 6G INFORMS but NEVER performs lifecycle change
// (no support lifecycle mutation; no automatic retirement) and mutates no 6A-6F or
// clinical state. Lab-scoped; all provenance FKs onDelete: Restrict.
// ============================================================================

enum EvaluationEvidenceProvenance {
  OBSERVED // computed from real InferenceRecord fields
  SYNTHETIC_STUB // deterministic stub value — NOT observed production evidence
  UNAVAILABLE // could not be computed (empty/sparse/incompatible) — value is null + reason
}

enum EvaluationCohort {
  NON_VALIDATION // ordinary inference evidence (validationOnly excluded)
  VALIDATION_ONLY // validation-only inference evidence (kept separate — no silent mixing)
}

enum EvaluationCoverageStatus {
  COVERED
  SPARSE
  EMPTY
}

enum EvaluationMetricKind {
  INFERENCE_COUNT
  SUCCESS_RATE
  FAILURE_RATE
  TIMEOUT_RATE
  LATENCY_PERCENTILE
  CONFIDENCE_BIN
  DRIFT_INDICATOR
  CALIBRATION_DECAY
}

enum EvaluationRecommendationCode {
  LIFECYCLE_REVIEW_RECOMMENDED // advisory ONLY — never RETIRE/AUTO_RETIRE/RETIREMENT_APPROVED
}

enum EvaluationWindowStatus {
  COMPLETE // a visible window is always COMPLETE (written atomically) — Guardrail 12
}

// Immutable continuous-evaluation window. Append-only; no update/delete path; re-evaluation
// creates a NEW window with an independent evidence graph.
model EvaluationWindow {
  id             String         @id @default(cuid())
  windowUuid     String         @unique @default(uuid())
  labId          String
  lab            Lab            @relation(fields: [labId], references: [id])
  modelVersionId String
  modelVersion   AiModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Restrict)

  // Model identity snapshot.
  modelVersionUuid         String
  modelUuid                String
  modelLifecycleStateAtRun AiModelLifecycleState

  // Guardrail 7 — time-window integrity (interpretation fixed regardless of later policy changes).
  windowStart             DateTime
  windowEnd               DateTime
  timeBasis               String // canonical time basis, e.g. "UTC"
  windowDefinitionVersion String

  cohort EvaluationCohort

  // Optional immutable 6F baseline (same lab + model version; else UNAVAILABLE — Guardrail 3).
  baselineValidationRunId String?
  baselineValidationRun   ValidationRun?               @relation(fields: [baselineValidationRunId], references: [id], onDelete: Restrict)
  baselineCalculationId   String? // snapshot of the baseline's deterministic id
  baselineCompatibility   EvaluationEvidenceProvenance // OBSERVED when a compatible baseline is used; UNAVAILABLE otherwise

  sampleCount    Int // true number of eligible members (Decision 7)
  coverageStatus EvaluationCoverageStatus

  evaluatorId         String
  evaluatorVersion    String
  computationVersion  String
  metricSchemaVersion String
  configDigest        String?
  calculationId       String // deterministic evidence id (Guardrail 6)
  windowSignature     String // deterministic window identity for duplicate detection (Guardrail 8)
  completionState     EvaluationWindowStatus @default(COMPLETE) // Guardrail 12

  eventId     String
  createdById String? // actor; no FK
  createdAt   DateTime @default(now())

  members         EvaluationWindowMember[]
  metrics         EvaluationMetric[]
  recommendations EvaluationRecommendation[]

  @@index([labId])
  @@index([labId, modelVersionId])
  @@index([labId, windowSignature]) // Guardrail 8 — duplicate detection
  @@index([modelVersionId])
}

// Immutable membership snapshot (Guardrail 1) — the exact InferenceRecord population evaluated.
model EvaluationWindowMember {
  id                String           @id @default(cuid())
  labId             String
  lab               Lab              @relation(fields: [labId], references: [id])
  windowId          String
  window            EvaluationWindow @relation(fields: [windowId], references: [id], onDelete: Restrict)
  inferenceRecordId String
  inferenceRecord   InferenceRecord  @relation(fields: [inferenceRecordId], references: [id], onDelete: Restrict)
  ordinal           Int
  createdAt         DateTime         @default(now())

  @@unique([labId, windowId, inferenceRecordId])
  @@index([labId])
  @@index([labId, windowId])
  @@index([windowId])
}

// Structured immutable metric (Decision 8). Provenance + cohort are explicit (Guardrails 2/9);
// an UNAVAILABLE metric carries a null value + reason (never an invented number).
model EvaluationMetric {
  id       String           @id @default(cuid())
  labId    String
  lab      Lab              @relation(fields: [labId], references: [id])
  windowId String
  window   EvaluationWindow @relation(fields: [windowId], references: [id], onDelete: Restrict)

  metricKind        EvaluationMetricKind
  provenance        EvaluationEvidenceProvenance
  cohort            EvaluationCohort // Guardrail 9 — the cohort this metric was derived from
  binCode           String? // coded percentile/bin (e.g. "p50","p95", a confidence bin) — never a diagnosis
  value             Float? // validated finite; rates in [0,1]; UNAVAILABLE ⇒ null
  numeratorSource   String?
  denominatorSource String?
  unit              String?
  sampleCount       Int?
  baselineRelation  String? // coded (e.g. "delta-vs-baseline"); null when no baseline
  unavailableReason String? // required when provenance = UNAVAILABLE
  ordinal           Int
  createdAt         DateTime                     @default(now())

  recommendationEvidence EvaluationRecommendationEvidence[] // Guardrail 4 — this metric may support a recommendation

  @@index([labId])
  @@index([labId, windowId])
  @@index([windowId])
}

// Advisory lifecycle-review recommendation (Guardrail 4) — structurally SEPARATE from metrics
// (Guardrail 11). Coded LIFECYCLE_REVIEW_RECOMMENDED only; no shouldRetire / free-text.
model EvaluationRecommendation {
  id       String           @id @default(cuid())
  labId    String
  lab      Lab              @relation(fields: [labId], references: [id])
  windowId String
  window   EvaluationWindow @relation(fields: [windowId], references: [id], onDelete: Restrict)

  recommendationCode    EvaluationRecommendationCode
  ruleId                String
  ruleVersion           String
  thresholdConfigDigest String?
  coverageStatus        EvaluationCoverageStatus
  provenance            EvaluationEvidenceProvenance
  ordinal               Int
  createdAt             DateTime                     @default(now())

  evidence EvaluationRecommendationEvidence[]

  @@index([labId])
  @@index([labId, windowId])
  @@index([windowId])
}

// Recommendation → metric provenance link (Guardrail 4). Keeps supporting evidence auditable
// without recommendations becoming attributes of metrics (Guardrail 11).
model EvaluationRecommendationEvidence {
  id               String                   @id @default(cuid())
  labId            String
  lab              Lab                      @relation(fields: [labId], references: [id])
  recommendationId String
  recommendation   EvaluationRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Restrict)
  metricId         String
  metric           EvaluationMetric         @relation(fields: [metricId], references: [id], onDelete: Restrict)
  ordinal          Int
  createdAt        DateTime                 @default(now())

  @@unique([labId, recommendationId, metricId])
  @@index([labId])
  @@index([recommendationId])
  @@index([metricId])
}

// ============================================================================
// Program 6 · Phase 6H — CLINICAL PERFORMANCE MEASUREMENT EVIDENCE (measurement
// evidence ONLY; NEVER clinical validity/safety/effectiveness/regulatory/
// diagnostic-correctness). 6H measures the AI and creates NO new diagnoses.
// Immutable ClinicalPerfWindows over 6C inference + 6E human-review decisions (+
// an optional immutable 6F ValidationRun baseline) record reader agreement,
// concordance (CONSISTENCY measures — never correctness), review/turnaround
// duration, workload counts + reduction, and operational throughput. The default
// evaluator is a DETERMINISTIC, NON-CLINICAL stub. NO SUPPORT DIAGNOSTIC AUTHORITY
// (+ carried-forward no-support clinical-authorization/lifecycle-mutation) — 6H
// never creates/alters a diagnosis, sign-out, authorization, lifecycle, or any
// upstream evidence. Program-5 interaction is STRICTLY REFERENCE-ONLY coded
// operational metadata (never narrative/findings/PHI; never modified — Guardrail
// 1). Each window SNAPSHOTS the model identity + time basis + window-definition
// version and the EXACT member population (Guardrail 3); metrics carry explicit
// OBSERVED/SYNTHETIC_STUB/UNAVAILABLE provenance + cohort + source subsystem
// (Guardrail 2); empty/sparse windows are truthful. NO recommendation entity
// (Guardrail 5 — measurement only). Atomic all-or-nothing + explicit COMPLETE
// state; deterministic calculationId + windowSignature. Lab-scoped; FKs Restrict.
// The schema names measurement, NEVER authority — no clinicallyValid/FDACleared/
// diagnosticAccuracy/superiorTo/certified column exists.
// ============================================================================

enum ClinicalPerfMetricKind {
  READER_AGREEMENT // consistency between recorded decisions — NOT correctness (Decision 5)
  CONCORDANCE // consistency between governed evidence sources — NOT correctness (Decision 6)
  REVIEW_DURATION
  TURNAROUND_DURATION
  WORKLOAD_COUNT
  WORKLOAD_REDUCTION
  OPERATIONAL_THROUGHPUT
}

enum ClinicalPerfEvidenceProvenance {
  OBSERVED
  SYNTHETIC_STUB
  UNAVAILABLE
}

enum ClinicalPerfCohort {
  CLINICAL
  VALIDATION_ONLY // kept structurally separate — no silent aggregation (Decision 10)
}

enum ClinicalPerfCoverageStatus {
  COVERED
  SPARSE
  EMPTY
}

enum ClinicalPerfMemberSource {
  INFERENCE_RECORD
  HUMAN_REVIEW_DECISION
}

enum ClinicalPerfWindowStatus {
  COMPLETE // a visible window is always COMPLETE (written atomically) — Decision 9
}

// Immutable clinical-performance measurement window. Append-only; no update/delete path;
// recomputation creates a NEW window with an independent evidence graph.
model ClinicalPerfWindow {
  id             String         @id @default(cuid())
  windowUuid     String         @unique @default(uuid())
  labId          String
  lab            Lab            @relation(fields: [labId], references: [id])
  modelVersionId String
  modelVersion   AiModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Restrict)

  modelVersionUuid         String
  modelUuid                String
  modelLifecycleStateAtRun AiModelLifecycleState

  windowStart             DateTime
  windowEnd               DateTime
  timeBasis               String
  windowDefinitionVersion String

  cohort ClinicalPerfCohort

  baselineValidationRunId String?
  baselineValidationRun   ValidationRun?                 @relation(fields: [baselineValidationRunId], references: [id], onDelete: Restrict)
  baselineCalculationId   String?
  evidenceCompatibility   ClinicalPerfEvidenceProvenance // OBSERVED when sources compatible; UNAVAILABLE otherwise (Guardrail 4)
  operationalDataUsed     Boolean // whether reference-only Program-5 coded operational metadata was read (Decision 4)

  sampleCount    Int
  coverageStatus ClinicalPerfCoverageStatus

  evaluatorId         String
  evaluatorVersion    String
  computationVersion  String
  metricSchemaVersion String
  configDigest        String?
  calculationId       String
  windowSignature     String
  completionState     ClinicalPerfWindowStatus @default(COMPLETE)

  eventId     String
  createdById String? // actor; no FK
  createdAt   DateTime @default(now())

  members ClinicalPerfWindowMember[]
  metrics ClinicalPerfMetric[]

  @@index([labId])
  @@index([labId, modelVersionId])
  @@index([labId, windowSignature])
  @@index([modelVersionId])
}

// Immutable membership snapshot (Guardrail 3). Exactly one reference is set (by `source`):
// a 6C InferenceRecord or a 6E HumanReviewDecision — never a Program-5 clinical object.
model ClinicalPerfWindowMember {
  id                    String                   @id @default(cuid())
  labId                 String
  lab                   Lab                      @relation(fields: [labId], references: [id])
  windowId              String
  window                ClinicalPerfWindow       @relation(fields: [windowId], references: [id], onDelete: Restrict)
  source                ClinicalPerfMemberSource
  inferenceRecordId     String?
  inferenceRecord       InferenceRecord?         @relation(fields: [inferenceRecordId], references: [id], onDelete: Restrict)
  humanReviewDecisionId String?
  humanReviewDecision   HumanReviewDecision?     @relation(fields: [humanReviewDecisionId], references: [id], onDelete: Restrict)
  ordinal               Int
  createdAt             DateTime                 @default(now())

  @@index([labId])
  @@index([labId, windowId])
  @@index([windowId])
}

// Structured immutable measurement (Decision 7 + Guardrail 2). Coded/numeric only;
// NO JSON blobs, NO correctness/clinical/regulatory column.
model ClinicalPerfMetric {
  id       String             @id @default(cuid())
  labId    String
  lab      Lab                @relation(fields: [labId], references: [id])
  windowId String
  window   ClinicalPerfWindow @relation(fields: [windowId], references: [id], onDelete: Restrict)

  metricKind        ClinicalPerfMetricKind
  provenance        ClinicalPerfEvidenceProvenance
  cohort            ClinicalPerfCohort
  sourceSubsystem   String // coded: "6c" | "6e" | "6f" | "program5-operational"
  binCode           String?
  value             Float? // validated by kind; UNAVAILABLE ⇒ null
  numeratorSource   String?
  denominatorSource String?
  unit              String?
  sampleCount       Int?
  unavailableReason String? // required when provenance = UNAVAILABLE
  ordinal           Int
  createdAt         DateTime                       @default(now())

  @@index([labId])
  @@index([labId, windowId])
  @@index([windowId])
}

// ============================================================================
// Program 6 · Phase 6B — dataset governance (validation datasets + training-
// dataset REFERENCES). Immutable versioned datasets that REFERENCE Program-5
// slides by identity (labId, slideId[, specimenId]) and NEVER duplicate PHI;
// structured/coded ground-truth labels with append-only annotation lineage;
// inclusion/exclusion rules; immutable dataset-purpose provenance. No inference/
// training/model-linkage/validation-metrics here (dataset↔model-version is 6F).
// Ground truth is DISTINCT from the viewer SlideAnnotation. Lab-scoped; all
// provenance FKs onDelete: Restrict; reference-not-copy.
// ============================================================================

enum DatasetKind {
  VALIDATION // in-platform curated membership + ground-truth labels over Program-5 slides
  TRAINING_REFERENCE // pointer-only provenance to an EXTERNAL corpus (no membership/labels/bytes/PHI)
}

enum DatasetVersionState {
  DRAFT // membership/labels/rules/purpose mutable
  FROZEN // immutable snapshot; a correction creates a NEW version (ARCHIVED deferred)
}

// Declared PURPOSE — provenance only, NEVER used for authorization.
enum DatasetPurpose {
  ALGORITHM_VALIDATION
  REGULATORY_SUBMISSION
  INTERNAL_BENCHMARKING
  CLINICAL_QA
  RESEARCH
  DEMONSTRATION
}

enum DatasetSlideMembership {
  INCLUDED
  EXCLUDED
}

enum AnnotationMethod {
  PATHOLOGIST_ASSERTED
  CONSENSUS
  IMPORTED
}

// A logical governed dataset. `datasetUuid` is the permanent identity.
model Dataset {
  id          String      @id @default(cuid())
  datasetUuid String      @unique @default(uuid())
  labId       String
  lab         Lab         @relation(fields: [labId], references: [id])
  key         String // stable human slug (unique per lab)
  displayName String
  kind        DatasetKind
  description String?
  createdById String? // actor; no FK
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  versions           DatasetVersion[]
  trainingReferences TrainingDatasetReference[]

  @@unique([labId, key])
  @@index([labId])
}

// Immutable versioned snapshot. DRAFT mutable; FROZEN immutable (a correction is
// a NEW version). `purpose` is immutable provenance.
model DatasetVersion {
  id             String              @id @default(cuid())
  versionUuid    String              @unique @default(uuid())
  labId          String
  lab            Lab                 @relation(fields: [labId], references: [id])
  datasetId      String
  dataset        Dataset             @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  versionNumber  Int // monotonic per dataset
  state          DatasetVersionState @default(DRAFT)
  purpose        DatasetPurpose // immutable provenance — NOT authorization
  inclusionRules Json? // structured snapshot — slide/technical attributes only, NO PHI
  manifestDigest String? // sha256 over frozen membership+labels (provenance w/o copying content)
  createdById    String? // actor; no FK
  createdAt      DateTime            @default(now())
  frozenAt       DateTime?

  slides      DatasetSlide[]
  groundTruth GroundTruthLabel[]

  // P6-6F — validation runs that use this frozen version as the reference corpus (reference only; RESTRICT).
  validationRuns ValidationRun[]

  @@unique([labId, datasetId, versionNumber])
  @@index([labId])
  @@index([labId, datasetId])
  @@index([datasetId])
}

// Membership (VALIDATION kind): references a Program-5 slide by id ONLY — no PHI.
model DatasetSlide {
  id               String                 @id @default(cuid())
  labId            String
  lab              Lab                    @relation(fields: [labId], references: [id])
  datasetVersionId String
  datasetVersion   DatasetVersion         @relation(fields: [datasetVersionId], references: [id], onDelete: Restrict)
  slideId          String
  slide            DigitalSlide           @relation(fields: [slideId], references: [id], onDelete: Restrict)
  specimenId       String?
  specimen         Specimen?              @relation(fields: [specimenId], references: [id], onDelete: Restrict)
  membership       DatasetSlideMembership @default(INCLUDED)
  exclusionReason  String? // coded reason — NO PHI
  addedAt          DateTime               @default(now())

  @@unique([labId, datasetVersionId, slideId])
  @@index([labId])
  @@index([datasetVersionId])
  @@index([slideId])
}

// Structured/coded ground-truth label, frozen with the version. NO PHI.
model GroundTruthLabel {
  id                 String         @id @default(cuid())
  labId              String
  lab                Lab            @relation(fields: [labId], references: [id])
  datasetVersionId   String
  datasetVersion     DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Restrict)
  slideId            String
  slide              DigitalSlide   @relation(fields: [slideId], references: [id], onDelete: Restrict)
  labelSchemaKey     String
  labelSchemaVersion String
  labelValue         String // structured/coded — NO free-text PHI
  assertedById       String? // actor; no FK
  assertedAt         DateTime       @default(now())

  lineage AnnotationLineageEvent[]

  @@unique([labId, datasetVersionId, slideId, labelSchemaKey])
  @@index([labId])
  @@index([datasetVersionId])
  @@index([slideId])
}

// Append-only provenance for how a label was derived. NO PHI.
model AnnotationLineageEvent {
  id                 String           @id @default(cuid())
  labId              String
  lab                Lab              @relation(fields: [labId], references: [id])
  groundTruthLabelId String
  groundTruthLabel   GroundTruthLabel @relation(fields: [groundTruthLabelId], references: [id], onDelete: Restrict)
  method             AnnotationMethod
  actorId            String? // no FK
  sourceRef          String? // provenance pointer — NO PHI
  eventId            String // shared across the rows of one lineage transaction
  occurredAt         DateTime         @default(now())

  @@index([labId])
  @@index([groundTruthLabelId])
}

// Pointer-only provenance to an EXTERNAL training corpus (TRAINING_REFERENCE
// kind). No slide membership, no labels, no bytes, no PHI, no import.
model TrainingDatasetReference {
  id            String   @id @default(cuid())
  labId         String
  lab           Lab      @relation(fields: [labId], references: [id])
  datasetId     String
  dataset       Dataset  @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  descriptor    String
  provenanceUri String
  contentDigest String? // optional integrity digest of the external corpus
  createdById   String? // no FK
  createdAt     DateTime @default(now())

  @@index([labId])
  @@index([datasetId])
}

// ---- Phase 4: Revenue ----
// All monetary amounts are integers in minor units (cents). Currency is the
// lab's (Lab.currency). Never store money as a float.

// Price-list entry a bill draws from.
model Service {
  id          String     @id @default(uuid())
  labId       String
  lab         Lab        @relation(fields: [labId], references: [id])
  name        String
  code        String
  description String?
  price       Int // minor units (cents)
  active      Boolean    @default(true)
  billLines   BillLine[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Legacy enforced a unique service name; per-lab uniqueness is the tenant form.
  @@unique([labId, name])
  @@index([labId])
}

// Tax rate stored as basis points (1% = 100 bps) — integer, no floats.
model Tax {
  id              String    @id @default(uuid())
  labId           String
  lab             Lab       @relation(fields: [labId], references: [id])
  name            String
  code            String?
  rateBasisPoints Int // basis points; 1% = 100
  isDefault       Boolean   @default(false)
  billTaxes       BillTax[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Legacy enforced a unique tax name; per-lab uniqueness is the tenant form.
  @@unique([labId, name])
  @@index([labId])
}

// A bill for one lab case (Record), billed to a Client. Totals are computed at
// creation from snapshotted line/tax amounts and never recomputed from the
// live catalog.
model Bill {
  id          String     @id @default(uuid())
  labId       String
  lab         Lab        @relation(fields: [labId], references: [id])
  recordId    String
  record      Record     @relation(fields: [recordId], references: [id])
  clientId    String?
  client      Client?    @relation(fields: [clientId], references: [id])
  referenceNo String
  status      BillStatus @default(Draft)
  subtotal    Int        @default(0) // minor units (cents) — sum of line amounts
  taxTotal    Int        @default(0) // minor units (cents) — sum of applied tax amounts
  total       Int        @default(0) // minor units (cents) — subtotal + taxTotal
  amountPaid  Int        @default(0) // minor units (cents) — Σ of payments, recomputed on each payment
  dueDate     DateTime?
  viewed      Boolean    @default(false)
  lines       BillLine[]
  taxes       BillTax[]
  payments    Payment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([labId])
  @@index([recordId])
  @@index([clientId])
  @@index([status])
}

// A bill line; price + service identity are snapshotted at bill time so later
// catalog edits don't rewrite historical bills.
model BillLine {
  id          String   @id @default(uuid())
  labId       String
  lab         Lab      @relation(fields: [labId], references: [id])
  billId      String
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  serviceName String // snapshot of Service.name at bill time
  serviceCode String? // snapshot of Service.code at bill time
  description String?
  quantity    Int
  unitPrice   Int // minor units (cents) — snapshot of Service.price at bill time
  amount      Int // minor units (cents) — quantity * unitPrice
  createdAt   DateTime @default(now())

  @@index([labId])
  @@index([billId])
}

// A tax applied to a bill, snapshotted (name + rate) at bill time.
model BillTax {
  id              String   @id @default(uuid())
  labId           String
  lab             Lab      @relation(fields: [labId], references: [id])
  billId          String
  bill            Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  taxId           String?
  tax             Tax?     @relation(fields: [taxId], references: [id])
  name            String // snapshot of Tax.name
  rateBasisPoints Int // snapshot of Tax.rateBasisPoints
  amount          Int // minor units (cents) — round(subtotal * rate / 10000)
  createdAt       DateTime @default(now())

  @@index([labId])
  @@index([billId])
}

// A payment settling (part of) a bill. Multiple payments per bill = partial
// settlement. `verified` is an audit flag, not a settlement gate.
model Payment {
  id           String      @id @default(uuid())
  labId        String
  lab          Lab         @relation(fields: [labId], references: [id])
  billId       String
  bill         Bill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount       Int // minor units (cents)
  type         PaymentType
  referenceNo  String?
  bank         String?
  chequeNumber String?
  verified     Boolean     @default(false)
  datePaid     DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([labId])
  @@index([billId])
}

// ---- Phase 5: Client Portal (F2) ----
// External identity for referring doctors/labs. Completely separate from staff
// User: separate table, separate JWT (own secret + audience). Lab-scoped AND
// client-scoped — carries clientId, which the tenancy guard injects into every
// portal query so a portal user can only ever reach its own client's data.
model PortalUser {
  id                    String                 @id @default(uuid())
  labId                 String
  lab                   Lab                    @relation(fields: [labId], references: [id])
  clientId              String
  client                Client                 @relation(fields: [clientId], references: [id])
  // Auto-generated at invite time (legacy "Generated" username). Unique per lab.
  username              String?
  email                 String
  // Null until the invite is accepted (first password set via emailed token).
  // Staff never set an external user's password (Finding 2, option B).
  passwordHash          String?
  firstName             String
  lastName              String
  isActive              Boolean                @default(true)
  // 2FA is toggled on the client form; actual enrollment happens later in the
  // portal (the staff form never sees the secret).
  twoFactorEnabled      Boolean                @default(false)
  // The client's main login. Soft flag (a client may have more than one contact
  // login); the service keeps at most one primary per client.
  isPrimary             Boolean                @default(false)
  // F2 notification preferences.
  notifyByEmail         Boolean                @default(true)
  notifyInApp           Boolean                @default(true)
  lastLoginAt           DateTime?
  tokens                PortalAccessToken[]
  authAttempts          AuthAttempt[]
  changeRequests        ChangeRequest[]        @relation("ChangeRequestCreator")
  changeRequestMessages ChangeRequestMessage[] @relation("ChangeRequestMessagePortalAuthor")
  changeRequestEvents   ChangeRequestEvent[]   @relation("ChangeRequestEventPortalActor")
  threadParticipants    ThreadParticipant[]
  authoredMessages      Message[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([labId, email])
  @@unique([labId, username])
  @@index([labId])
  @@index([clientId])
}

// Single-use, time-limited credential token for staff-invite onboarding and
// password reset. Only the SHA-256 hash is stored; the raw token is emailed.
// No clientId column: it is consumed unauthenticated (system scope), never in a
// portal-scoped request, so Rule B never applies to it.
model PortalAccessToken {
  id           String          @id @default(uuid())
  labId        String
  lab          Lab             @relation(fields: [labId], references: [id])
  portalUserId String
  portalUser   PortalUser      @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  type         PortalTokenType
  tokenHash    String          @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime        @default(now())

  @@index([labId])
  @@index([portalUserId])
}

// A structured request a client raises against a record (or generally). Carries
// clientId so the tenancy guard auto-scopes portal access to the client's own
// requests. Status lifecycle Open -> InReview -> Actioned|Declined.
model ChangeRequest {
  id                    String                 @id @default(uuid())
  labId                 String
  lab                   Lab                    @relation(fields: [labId], references: [id])
  clientId              String
  client                Client                 @relation(fields: [clientId], references: [id])
  recordId              String?
  record                Record?                @relation(fields: [recordId], references: [id])
  type                  ChangeRequestType
  subject               String
  status                ChangeRequestStatus    @default(Open)
  createdByPortalUserId String
  createdByPortalUser   PortalUser             @relation("ChangeRequestCreator", fields: [createdByPortalUserId], references: [id])
  assignedToUserId      String?
  assignedToUser        User?                  @relation("ChangeRequestAssignee", fields: [assignedToUserId], references: [id])
  messages              ChangeRequestMessage[]
  events                ChangeRequestEvent[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([labId])
  @@index([clientId])
  @@index([recordId])
  @@index([status])
}

// Append-only message thread between a portal user and lab staff. Exactly one of
// authorPortalUserId / authorUserId is set per row.
model ChangeRequestMessage {
  id                 String        @id @default(uuid())
  labId              String
  lab                Lab           @relation(fields: [labId], references: [id])
  clientId           String
  client             Client        @relation(fields: [clientId], references: [id])
  changeRequestId    String
  changeRequest      ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  body               String
  authorPortalUserId String?
  authorPortalUser   PortalUser?   @relation("ChangeRequestMessagePortalAuthor", fields: [authorPortalUserId], references: [id])
  authorUserId       String?
  authorUser         User?         @relation("ChangeRequestMessageStaffAuthor", fields: [authorUserId], references: [id])
  createdAt          DateTime      @default(now())

  @@index([labId])
  @@index([clientId])
  @@index([changeRequestId])
  @@index([changeRequestId, createdAt])
}

// Append-only audit of change-request status transitions (mirrors
// ResultSheetEvent). Exactly one of byPortalUserId / byUserId is set per row.
model ChangeRequestEvent {
  id              String              @id @default(uuid())
  labId           String
  lab             Lab                 @relation(fields: [labId], references: [id])
  clientId        String
  client          Client              @relation(fields: [clientId], references: [id])
  changeRequestId String
  changeRequest   ChangeRequest       @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  status          ChangeRequestStatus
  note            String?
  byPortalUserId  String?
  byPortalUser    PortalUser?         @relation("ChangeRequestEventPortalActor", fields: [byPortalUserId], references: [id])
  byUserId        String?
  byUser          User?               @relation("ChangeRequestEventStaffActor", fields: [byUserId], references: [id])
  createdAt       DateTime            @default(now())

  @@index([labId])
  @@index([clientId])
  @@index([changeRequestId])
  @@index([changeRequestId, createdAt])
}

// ---- Patient form rebuild (legacy parity) ----

// A patient can have one or more addresses ("Add Address" on the form).
model PatientAddress {
  id         String   @id @default(uuid())
  labId      String
  lab        Lab      @relation(fields: [labId], references: [id])
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  // Optional label (e.g. Home, Work) when the source distinguishes addresses.
  label      String?
  line1      String
  line2      String?
  city       String?
  region     String?
  postalCode String?
  country    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([labId])
  @@index([patientId])
}

// A client can have one or more addresses ("Add Address" on the client form).
model ClientAddress {
  id         String   @id @default(uuid())
  labId      String
  lab        Lab      @relation(fields: [labId], references: [id])
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  line2      String?
  city       String?
  region     String?
  postalCode String?
  country    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([labId])
  @@index([clientId])
}

// Per-lab monotonic counters for human-facing identifiers (currently the
// patient registration number). Allocation is atomic via an incrementing update
// that returns the new value; the seed is set during data migration to
// max(numeric imported registrationNo) so generated numbers never collide with
// imported ones (see DATA_MIGRATION_PLAN.md).
model LabSequence {
  id        String   @id @default(uuid())
  labId     String
  lab       Lab      @relation(fields: [labId], references: [id])
  name      String // e.g. "patientRegNo"
  value     BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@unique([labId, name])
  @@index([labId])
}

// ---- Record clinical features (two forms, chosen up front) ----
// A record is EITHER a Gynecology case OR a Non-Gynecology case (Record.formType
// discriminator). Each form's clinical fields live in its own typed 1:1 model so
// invalid states are unrepresentable (no pregnancy data on a urine sample).

model GynClinicalFeatures {
  id                         String    @id @default(uuid())
  labId                      String
  lab                        Lab       @relation(fields: [labId], references: [id])
  recordId                   String    @unique
  record                     Record    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  routineCheck               Boolean   @default(false)
  previousCytology           Boolean   @default(false)
  lmp                        DateTime? // last menstrual period
  clinicalAppearanceOfCervix String?
  nowPregnant                Boolean   @default(false)
  pregnancies                Int?
  leucorrhea                 String?
  menopause                  Boolean   @default(false)
  dateOfMenopause            DateTime?
  lengthOfCycle              String?
  pelvicAbnormalities        String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([labId])
}

model NonGynClinicalFeatures {
  id                String   @id @default(uuid())
  labId             String
  lab               Lab      @relation(fields: [labId], references: [id])
  recordId          String   @unique
  record            Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  sampleDescription String?
  natureAndSource   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([labId])
}

// General file attached to a record ("Attach File" row action). STUB — the
// actual upload/serving is deferred to Phase 6 file storage.
model RecordAttachment {
  id         String   @id @default(uuid())
  labId      String
  lab        Lab      @relation(fields: [labId], references: [id])
  recordId   String
  record     Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  storageUrl String
  filename   String?
  kind       String?
  createdAt  DateTime @default(now())

  @@index([labId])
  @@index([recordId])
}

// Slide (Gyn) / Vial (NonGyn) specimen images. STUB — actual upload/serving is
// deferred to Phase 6 file storage; the label is derived from Record.formType.
model SpecimenImage {
  id         String   @id @default(uuid())
  labId      String
  lab        Lab      @relation(fields: [labId], references: [id])
  specimenId String
  specimen   Specimen @relation(fields: [specimenId], references: [id], onDelete: Cascade)
  storageUrl String
  caption    String?
  createdAt  DateTime @default(now())

  @@index([labId])
  @@index([specimenId])
}

// ─── Messaging (Phase 6) ─────────────────────────────────────────────────────
// Threads carry messages between staff (INTERNAL) or staff↔client (CLIENT).
// Lab-scoped via labId; participants gate read access.

model Thread {
  id               String              @id @default(cuid())
  labId            String
  type             ThreadType          @default(INTERNAL)
  subject          String?
  clientId         String?
  client           Client?             @relation(fields: [clientId], references: [id])
  participants     ThreadParticipant[]
  messages         Message[]
  typingIndicators TypingIndicator[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  lab              Lab                 @relation(fields: [labId], references: [id])

  @@index([labId])
  @@index([clientId])
  @@index([labId, updatedAt])
}

// Ephemeral "user is typing" signal, one row per (thread, user), refreshed on
// each keystroke burst and expiring ~5s later. Rows are upserted and read with
// an expiry filter, so stale indicators simply age out.
model TypingIndicator {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime // typing indicators expire after 5 seconds

  @@unique([threadId, userId])
  @@index([threadId])
}

model ThreadParticipant {
  id           String      @id @default(cuid())
  threadId     String
  thread       Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  portalUserId String?
  portalUser   PortalUser? @relation(fields: [portalUserId], references: [id])
  joinedAt     DateTime    @default(now())

  @@index([threadId])
  @@index([userId])
  @@index([portalUserId])
}

model Message {
  id                 String      @id @default(cuid())
  threadId           String
  thread             Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  body               String
  authorUserId       String?
  authorUser         User?       @relation(fields: [authorUserId], references: [id])
  authorPortalUserId String?
  authorPortalUser   PortalUser? @relation(fields: [authorPortalUserId], references: [id])
  readAt             DateTime? // set when the recipient reads the message
  deliveredAt        DateTime? // set when the message is fetched by the recipient
  createdAt          DateTime    @default(now())

  @@index([threadId])
  @@index([threadId, createdAt])
}

enum ThreadType {
  INTERNAL
  CLIENT
}

// ─── Appointments (Phase 6) ──────────────────────────────────────────────────
// Scheduled patient/client visits: specimen collections, callbacks, consults and
// follow-ups. Lab-scoped via labId; optionally linked to a patient/client and an
// assigned staff member.

model Appointment {
  id          String            @id @default(cuid())
  labId       String
  lab         Lab               @relation(fields: [labId], references: [id])
  patientId   String?
  patient     Patient?          @relation(fields: [patientId], references: [id])
  clientId    String?
  client      Client?           @relation(fields: [clientId], references: [id])
  title       String            @default("")
  type        AppointmentType   @default(COLLECTION)
  status      AppointmentStatus @default(SCHEDULED)
  scheduledAt DateTime
  duration    Int               @default(30)
  location    String?
  doctorName  String?
  notes       String?

  assignedUserId String?
  assignedUser   User?   @relation("AppointmentAssignee", fields: [assignedUserId], references: [id])

  // Link back to the recall that triggered this appointment.
  recallRecordId String?
  recallRecord   RecallRecord? @relation(fields: [recallRecordId], references: [id])

  // Lifecycle outcomes.
  checkedInAt        DateTime?
  completedAt        DateTime?
  resultRecordId     String?
  noShowAt           DateTime?
  cancellationReason String?
  reminderSentAt     DateTime?

  createdById String?
  createdBy   User?    @relation("AppointmentCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([labId])
  @@index([labId, scheduledAt])
  @@index([patientId])
  @@index([clientId])
}

enum AppointmentType {
  COLLECTION
  CALLBACK
  CONSULTATION
  FOLLOWUP
  // Spec values (the module standardized on these; legacy values kept for
  // pre-existing rows).
  SpecimenCollection
  FollowUp
  RecallVisit
  Consultation
  Other
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELLED
  // Spec values.
  Scheduled
  Confirmed
  CheckedIn
  Completed
  NoShow
  Cancelled
  Rescheduled
}

// ─── System Health (internal) ────────────────────────────────────────────────
// Audit trail of automated-maintenance runs (superuser dashboard + nightly cron).
// Global (not lab-scoped): maintenance operates across every lab.

model MaintenanceLog {
  id       String   @id @default(cuid())
  ranAt    DateTime @default(now())
  ranBy    String? // userId, or 'system' for the cron run
  duration Int // ms
  results  Json // { flagged, archived, missedClosed, ... }
  notes    String?

  @@index([ranAt])
}

// ─── Form Setup (Path A: UI config layer over hardcoded clinical features) ────
// Configures labels/ordering/print-grouping of the existing GynClinicalFeatures
// + NonGynClinicalFeatures columns. Never alters those columns — fieldKey maps
// to an existing Prisma column name.

model FormConfig {
  id          String              @id @default(cuid())
  labId       String
  lab         Lab                 @relation(fields: [labId], references: [id])
  formType    RequisitionFormType
  fields      FormFieldConfig[]
  printGroups FormPrintGroup[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([labId, formType])
  @@index([labId])
}

model FormFieldConfig {
  id               String          @id @default(cuid())
  labId            String
  formConfigId     String
  formConfig       FormConfig      @relation(fields: [formConfigId], references: [id], onDelete: Cascade)
  fieldKey         String
  label            String
  fieldType        FormFieldType   @default(TEXT)
  showWhenPrinting Boolean         @default(true)
  printGroupId     String?
  printGroup       FormPrintGroup? @relation(fields: [printGroupId], references: [id])
  sortOrder        Int             @default(0)
  enabled          Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([formConfigId, fieldKey])
  @@index([labId])
}

model FormPrintGroup {
  id           String            @id @default(cuid())
  labId        String
  formConfigId String
  formConfig   FormConfig        @relation(fields: [formConfigId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int               @default(0)
  fields       FormFieldConfig[]
  createdAt    DateTime          @default(now())

  @@index([labId])
}

enum FormFieldType {
  TEXT
  CHECKBOX
}

// ─── Notifications (Phase 6) ──────────────────────────────────────────────────
// Per-user, lab-scoped in-app notifications. Created internally by services when
// lifecycle events occur (never via a public create endpoint); read/marked-read
// by the owning user.
model Notification {
  id         String           @id @default(cuid())
  labId      String
  lab        Lab              @relation(fields: [labId], references: [id])
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  type       NotificationType
  title      String
  body       String
  read       Boolean          @default(false)
  readAt     DateTime?
  archived   Boolean          @default(false)
  archivedAt DateTime?
  link       String? // e.g. /records/xxx or /authorizer
  entityId   String? // recordId, changeRequestId etc
  entityType String? // 'record', 'changerequest', 'appointment'
  createdAt  DateTime         @default(now())

  @@index([labId, userId])
  @@index([labId, userId, read])
  @@index([labId, userId, archived])
}

enum NotificationType {
  RECORD_SUBMITTED
  RECORD_RESULTED
  RECORD_APPROVED
  RECORD_FAILED
  AUTHORIZATION_NEEDED
  CHANGE_REQUEST_RECEIVED
  CHANGE_REQUEST_REPLIED
  PAYMENT_RECEIVED
  APPOINTMENT_REMINDER
  SYSTEM_ALERT
  // Platform billing: a recurring lab invoice was generated/issued for the lab.
  INVOICE_ISSUED
}

// Per-user delivery preferences for in-app notifications (Settings > General >
// Notification). One row per user; missing row = all channels default-on for
// in-app, off for email. Categories mirror the notification inbox grouping.
model UserNotificationPreference {
  id            String   @id @default(cuid())
  labId         String
  lab           Lab      @relation(fields: [labId], references: [id])
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  recordsInApp  Boolean  @default(true)
  recordsEmail  Boolean  @default(false)
  requestsInApp Boolean  @default(true)
  requestsEmail Boolean  @default(false)
  paymentsInApp Boolean  @default(true)
  paymentsEmail Boolean  @default(false)
  systemInApp   Boolean  @default(true)
  systemEmail   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([labId])
}

// ─── Phase 7: HR / Payroll ───────────────────────────────────────────────────

enum EmploymentType {
  FullTime
  PartTime
  Contract
}

enum PayAdviceStatus {
  Draft
  Issued
  Paid
}

enum PayrollRunStatus {
  Draft
  Processing
  Completed
}

// A department/team within the lab. managerId links to a staff User (optional).
model Department {
  id          String     @id @default(uuid())
  labId       String
  lab         Lab        @relation(fields: [labId], references: [id])
  name        String
  description String?
  managerId   String?
  manager     User?      @relation("DepartmentManager", fields: [managerId], references: [id])
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([labId])
  @@index([managerId])
}

// HR record for a staff member. One Employee per User (1:1). salary is the
// MONTHLY basic in minor units (cents).
model Employee {
  id                    String               @id @default(uuid())
  labId                 String
  lab                   Lab                  @relation(fields: [labId], references: [id])
  userId                String               @unique
  user                  User                 @relation("EmployeeUser", fields: [userId], references: [id])
  departmentId          String?
  department            Department?          @relation(fields: [departmentId], references: [id])
  employeeNo            String
  jobTitle              String
  employmentType        EmploymentType       @default(FullTime)
  startDate             DateTime
  endDate               DateTime?
  salary                Int                  @default(0) // monthly basic, minor units (cents)
  bankName              String?
  bankAccount           String?
  bankBranch            String?
  trn                   String? // Tax Registration Number
  nis                   String? // National Insurance Scheme #
  nht                   String? // National Housing Trust #
  emergencyContactName  String?
  emergencyContactPhone String?
  address               String?
  isActive              Boolean              @default(true)
  isFixedSalary         Boolean              @default(true) // false = hourly (hours entered per run)
  payAdvices            PayAdvice[]
  clockEvents           ClockEvent[]
  timesheets            Timesheet[]
  shiftAssignments      ShiftAssignment[]
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]
  overtimeRecords       OvertimeRecord[]
  payrollEntries        PayrollEntry[]
  productivityMetrics   ProductivityMetric[]
  performanceReviews    PerformanceReview[]
  performanceGoals      PerformanceGoal[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([labId, employeeNo])
  @@index([labId])
  @@index([departmentId])
}

// A payroll batch for one period (YYYY-MM). Processing generates one PayAdvice
// per active employee and rolls up the totals.
model PayrollRun {
  id              String           @id @default(uuid())
  labId           String
  lab             Lab              @relation(fields: [labId], references: [id])
  period          String // YYYY-MM
  status          PayrollRunStatus @default(Draft)
  totalGross      Int              @default(0)
  totalDeductions Int              @default(0)
  totalNet        Int              @default(0)
  employeeCount   Int              @default(0)
  payrollDate     DateTime?
  runNumber       Int              @default(0) // sequential per lab, assigned at process time
  integrityHash   String? // SHA-256 over the run's canonical content (tamper-evidence)
  processedAt     DateTime?
  processedById   String?
  processedBy     User?            @relation("PayrollProcessor", fields: [processedById], references: [id])
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?            @relation("PayrollApprover", fields: [approvedById], references: [id])
  approvalNotes   String?
  payAdvices      PayAdvice[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([labId, period])
  @@index([labId])
}

// A single employee's pay slip for a period. All money fields are minor units.
model PayAdvice {
  id              String          @id @default(uuid())
  labId           String
  lab             Lab             @relation(fields: [labId], references: [id])
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollRunId    String?
  payrollRun      PayrollRun?     @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  period          String // YYYY-MM
  basicPay        Int             @default(0)
  hoursWorked     Int             @default(0)
  overtime        Int             @default(0)
  allowances      Int             @default(0)
  commission      Int             @default(0)
  bonus           Int             @default(0)
  grossPay        Int             @default(0)
  nis             Int             @default(0)
  nht             Int             @default(0)
  edTax           Int             @default(0)
  paye            Int             @default(0)
  pension         Int             @default(0)
  reimbursement   Int             @default(0)
  otherDeductions Int             @default(0)
  netPay          Int             @default(0)
  // Year-to-date running totals (through this advice's period).
  ytdGross        Int             @default(0)
  ytdNis          Int             @default(0)
  ytdNht          Int             @default(0)
  ytdEdTax        Int             @default(0)
  ytdPaye         Int             @default(0)
  ytdPension      Int             @default(0)
  ytdLoanBalance  Int             @default(0)
  status          PayAdviceStatus @default(Draft)
  issuedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([labId])
  @@index([employeeId])
  @@index([payrollRunId])
}

// ─── Result Templates ────────────────────────────────────────────────────────
// Reusable cytology report templates (Bethesda categories) that pre-populate
// result-sheet narrative/findings during entry.

enum TemplateCategory {
  Cervical
  Endometrial
  Respiratory
  Urinary
  Breast
  Thyroid
  Other
}

model ResultTemplate {
  id               String           @id @default(cuid())
  labId            String
  lab              Lab              @relation(fields: [labId], references: [id])
  name             String
  category         TemplateCategory @default(Cervical)
  shortCode        String?
  description      String?
  isActive         Boolean          @default(true)
  usageCount       Int              @default(0)
  specimenAdequacy String?
  generalCategory  String?
  interpretation   String?
  recommendation   String?
  additionalNotes  String?
  findings         Json? // [{ key, value }]
  createdById      String?
  createdBy        User?            @relation("ResultTemplateCreator", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([labId, name])
  @@unique([labId, shortCode])
  @@index([labId])
  @@index([category])
}

// ─── Bethesda System (TBS 2014) — structured cervical cytology classification ─

enum SpecimenAdequacy {
  Satisfactory
  Unsatisfactory
}

enum GeneralCategory {
  NILM // Negative for Intraepithelial Lesion or Malignancy
  EpithelialAbnormality
  OtherMalignancy
}

enum SquamousCategory {
  ASC // Atypical Squamous Cells
  LSIL
  HSIL
  SCC // Squamous Cell Carcinoma
}

enum ASCSubtype {
  ASCUS // of undetermined significance
  ASCH // cannot exclude HSIL
}

// Inferred (spec truncated) from TBS 2014 glandular categories.
enum GlandularCategory {
  AGC // Atypical Glandular Cells
  AGC_FavorNeoplastic
  AIS // Endocervical Adenocarcinoma in situ
  Adenocarcinoma
  Other
}

// Inferred (spec truncated): ancillary HPV testing result.
enum HPVResult {
  Positive
  Negative
  NotPerformed
}

// Inferred (spec truncated): structured management recommendations.
enum BethesdaRecommendation {
  RoutineScreening
  RepeatIn1Year
  HPVReflexTesting
  Colposcopy
  UrgentColposcopy
  EndocervicalSampling
  RepeatSpecimen
  ClinicalCorrelation
}

model BethesdaResult {
  id       String @id @default(cuid())
  labId    String
  lab      Lab    @relation(fields: [labId], references: [id])
  recordId String @unique
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  specimenAdequacy     SpecimenAdequacy
  unsatisfactoryReason String?

  generalCategory GeneralCategory?

  organisms          String[]
  otherNonNeoplastic String[]

  squamousCategory SquamousCategory?
  ascSubtype       ASCSubtype?

  glandularCategory GlandularCategory?
  glandularSubtype  String?

  otherMalignancy String?

  hpvResult   HPVResult?
  hpvGenotype String?

  recommendation      BethesdaRecommendation?
  recommendationNotes String?

  generatedNarrative String?

  reportedById String?
  reportedBy   User?    @relation("BethesdaReporter", fields: [reportedById], references: [id])
  reportedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([labId])
}

// ─── TAT (Turnaround Time) monitoring & breach alerts ────────────────────────

enum TATAlertLevel {
  Approaching
  Breached
}

enum TATAlertStatus {
  Open
  Acknowledged
  Resolved
}

// Per-lab TAT thresholds. specimenType null = default (applies to all types).
// urgentThresholdHours applies when the record is urgent or its Bethesda
// classification is high-grade (HSIL/SCC/AGUS/malignant).
model TATConfig {
  id                   String     @id @default(cuid())
  labId                String
  lab                  Lab        @relation(fields: [labId], references: [id])
  name                 String
  specimenType         String?
  thresholdHours       Int
  warningHours         Int        @default(24)
  urgentThresholdHours Int?
  isActive             Boolean    @default(true)
  alerts               TATAlert[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([labId])
}

// A detected TAT event for a record. One row per (record, level); auto-resolved
// when the record is authorized.
model TATAlert {
  id               String         @id @default(cuid())
  labId            String
  lab              Lab            @relation(fields: [labId], references: [id])
  recordId         String
  record           Record         @relation(fields: [recordId], references: [id], onDelete: Cascade)
  level            TATAlertLevel
  status           TATAlertStatus @default(Open)
  thresholdHours   Int
  elapsedHours     Int
  dueAt            DateTime
  configId         String?
  config           TATConfig?     @relation(fields: [configId], references: [id])
  notifiedAt       DateTime?
  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?          @relation("TATAcknowledger", fields: [acknowledgedById], references: [id])
  resolvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([recordId, level])
  @@index([labId])
  @@index([labId, status])
}

// ─── Feature Management — superuser-controlled per-lab feature flags ──────────

// Feature keys, grouped by tier. Tier 1 (Standard/core) features are always on
// and NOT stored here (enforced in code). Only tier 2-5 keys are persisted.
enum FeatureKey {
  // Tier 2 — Clinical
  TAT_ALERTS
  PRIOR_HISTORY
  BETHESDA_SYSTEM
  ABNORMAL_ESCALATION
  CASE_ASSIGNMENT
  QC_MODULE

  // Tier 3 — Operational
  VOICE_TO_TEXT
  RESULT_TEMPLATES
  BATCH_AUTHORIZATION
  REQUISITION_TRACKING
  SLIDE_LABEL_PRINTING
  ANCILLARY_ORDERS
  SCREENING_BATCHES

  // Tier 4 — Compliance
  BETHESDA_ANALYTICS
  CORRELATION_TRACKING
  PROFICIENCY_TESTING
  REAGENT_TRACKING
  PATIENT_RECALL
  REPORT_CENTER
  APPOINTMENTS
  QUALITY_GOVERNANCE

  // Tier 5 — Enterprise
  WSI_VIEWER
  AI_SCREENING
  TELECONSULTATION
  LOINC_SNOMED
  HL7_FHIR
  OPERATIONS_HUB
  ENTERPRISE_ADMINISTRATION
  ENTERPRISE_CASE_MGMT

  // Tier 6 — Workforce
  WORKFORCE_MANAGEMENT
}

// One row per (lab, feature). Toggle history is not retained — each toggle
// overwrites isEnabled/enabledAt/enabledBy with the latest state and actor.
model LabFeature {
  id          String     @id @default(cuid())
  labId       String
  lab         Lab        @relation(fields: [labId], references: [id])
  featureKey  FeatureKey
  tier        Int // 1-5
  isEnabled   Boolean    @default(false)
  enabledAt   DateTime?
  enabledById String?
  enabledBy   User?      @relation("LabFeatureToggler", fields: [enabledById], references: [id])
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([labId, featureKey])
  @@index([labId])
}

// ─── Abnormal Result Escalation (Tier 2 Clinical) ────────────────────────────

enum EscalationSeverity {
  Abnormal // LSIL, ASCUS, AGC — notify physician, flag for review
  HighGrade // HSIL, ASC-H, AIS, AGC-favor-neoplastic — urgent review required
  Malignant // SCC, Adenocarcinoma, other malignancy — immediate escalation
}

enum EscalationTrigger {
  BethesdaClassification // triggered by a Bethesda result
  NarrativeKeyword // triggered by keyword match on the narrative
  ManualFlag // manually escalated by staff
}

enum EscalationStatus {
  Pending // created, not yet reviewed
  Acknowledged
  UnderReview
  Resolved
  Dismissed // false positive, dismissed by senior pathologist
}

// An automatically- or manually-raised escalation for an abnormal/malignant
// result. Created by EscalationService.evaluateRecord regardless of the
// ABNORMAL_ESCALATION UI feature flag (clinical safety); only the management UI
// is gated. At most one OPEN escalation (Pending/Acknowledged/UnderReview) is
// kept per record — the trigger is idempotent.
model EscalationRecord {
  id       String             @id @default(cuid())
  labId    String
  lab      Lab                @relation(fields: [labId], references: [id])
  recordId String
  record   Record             @relation(fields: [recordId], references: [id], onDelete: Cascade)
  severity EscalationSeverity
  trigger  EscalationTrigger
  status   EscalationStatus   @default(Pending)

  // Who needs to act (senior pathologist).
  assignedToId String?
  assignedTo   User?   @relation("EscalationAssignee", fields: [assignedToId], references: [id])

  // Referring physician notification.
  physicianNotifiedAt  DateTime?
  physicianNotifiedVia String? // "portal" | "in-app"

  // Review tracking.
  reviewedById String?
  reviewedBy   User?     @relation("EscalationReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNotes  String?

  // Auto-resolved when the record is re-authorized NILM or manually closed.
  resolvedAt     DateTime?
  resolvedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId, status])
  @@index([recordId])
}

// Per-pathologist daily/weekly throughput targets (Case Assignment & Workload
// Balancing, Tier 2). One row per (lab, user).
model WorkloadTarget {
  id           String  @id @default(cuid())
  labId        String
  lab          Lab     @relation(fields: [labId], references: [id])
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id])
  dailyTarget  Int     @default(20)
  weeklyTarget Int     @default(100)
  isActive     Boolean @default(true)

  @@unique([labId, userId])
  @@index([labId])
}

// ─── Quality Control (Tier 2 Clinical) ───────────────────────────────────────

enum QCCheckType {
  SlidePreparation // slide quality check
  StainingQuality // stain consistency check
  FixationAdequacy // fixation quality
  CellularityCheck // adequate cell count
  EquipmentCalibration // equipment performance
  ReagentCheck // reagent lot quality
  ExternalQC // external quality control slide
}

enum QCResult {
  Pass
  Fail
  Marginal // borderline — flag for review but don't fail
}

enum EquipmentType {
  Stainer
  Centrifuge
  Microscope
  Processor
  Scanner
  Other
}

enum AlertStatus {
  Open
  Acknowledged
  Resolved
}

// A single quality-control check — standalone or linked to a record.
model QCCheck {
  id               String      @id @default(cuid())
  labId            String
  lab              Lab         @relation(fields: [labId], references: [id])
  recordId         String?
  record           Record?     @relation(fields: [recordId], references: [id])
  checkType        QCCheckType
  result           QCResult
  performedById    String
  performedBy      User        @relation(fields: [performedById], references: [id])
  equipmentId      String?
  equipment        Equipment?  @relation(fields: [equipmentId], references: [id])
  batchId          String? // staining batch reference
  notes            String?
  failureReason    String? // required when result = Fail
  correctiveAction String? // what was done to fix it
  performedAt      DateTime    @default(now())
  createdAt        DateTime    @default(now())

  failureAlert QCFailureAlert?

  @@index([labId, performedAt])
  @@index([recordId])
}

// Lab instruments that QC checks are performed against.
model Equipment {
  id              String        @id @default(cuid())
  labId           String
  lab             Lab           @relation(fields: [labId], references: [id])
  name            String // e.g. "Stainer Unit 1", "Centrifuge A"
  type            EquipmentType
  serialNumber    String?
  lastServiceDate DateTime?
  isActive        Boolean       @default(true)
  qcChecks        QCCheck[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([labId, name])
}

// Raised automatically when a QC check fails; tracked to resolution.
model QCFailureAlert {
  id           String      @id @default(cuid())
  labId        String
  lab          Lab         @relation(fields: [labId], references: [id])
  qcCheckId    String      @unique
  qcCheck      QCCheck     @relation(fields: [qcCheckId], references: [id], onDelete: Cascade)
  status       AlertStatus @default(Open)
  assignedToId String?
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime    @default(now())

  @@index([labId, status])
}

// ─── Requisition Tracking (Tier 3 Operational) — physical form chain of custody ─

enum TrackingStage {
  Pending // not yet received
  FormReceived // paper form received at front desk
  BenchReceived // specimen received at bench
  Verified // form verified against specimen
  Processing // in processing
  Filed // form filed, complete
  Rejected // rejected (wrong patient, damaged, etc.)
}

enum FormCondition {
  Good
  Damaged
  Incomplete
  Illegible
}

// One-to-one custody record for a requisition's paper form. Auto-created (stage
// Pending) when a requisition is created.
model RequisitionTracking {
  id            String      @id @default(cuid())
  labId         String
  lab           Lab         @relation(fields: [labId], references: [id])
  requisitionId String      @unique
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  // Physical form receipt.
  formReceivedAt     DateTime?
  formReceivedById   String?
  formReceivedBy     User?         @relation("FormReceiver", fields: [formReceivedById], references: [id])
  formCondition      FormCondition @default(Good)
  formConditionNotes String?

  // Specimen bench receipt.
  benchReceivedAt   DateTime?
  benchReceivedById String?
  benchReceivedBy   User?     @relation("BenchReceiver", fields: [benchReceivedById], references: [id])

  // Verification.
  verifiedAt        DateTime?
  verifiedById      String?
  verifiedBy        User?     @relation("FormVerifier", fields: [verifiedById], references: [id])
  verificationNotes String?

  // Filing.
  filedAt      DateTime?
  filedById    String?
  filedBy      User?     @relation("FormFiler", fields: [filedById], references: [id])
  fileLocation String? // e.g. "Cabinet A, Drawer 3"

  // Barcode / QR.
  barcodeScanned Boolean @default(false)
  barcodeValue   String?

  currentStage TrackingStage @default(Pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId, currentStage])
}

// Append-only audit of every stage transition.
model TrackingEvent {
  id             String        @id @default(cuid())
  labId          String
  lab            Lab           @relation(fields: [labId], references: [id])
  requisitionId  String
  requisition    Requisition   @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  stage          TrackingStage
  performedById  String
  performedBy    User          @relation("TrackingEventActor", fields: [performedById], references: [id])
  notes          String?
  scannedBarcode String?
  performedAt    DateTime      @default(now())

  @@index([requisitionId])
  @@index([labId, performedAt])
}

// ─── Cyto-Histo Correlation Tracking (Tier 4 Compliance) ─────────────────────

enum HistologySource {
  Internal // histology also done at this lab
  External // done at another lab
  Unknown
}

enum CorrelationResult {
  Concordant // cytology and histology agree
  MinorDiscordant // slight difference, clinically acceptable
  MajorDiscordant // significant difference, requires review
  Unresolved // histology not yet received
}

// Links a cytology case to its histology follow-up and tracks concordance —
// a CAP/ISO accreditation requirement.
model CorrelationCase {
  id        String  @id @default(cuid())
  labId     String
  lab       Lab     @relation(fields: [labId], references: [id])
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  // Cytology side.
  cytologyRecordId   String
  cytologyRecord     Record   @relation("CytologyRecord", fields: [cytologyRecordId], references: [id])
  cytologyDate       DateTime
  cytologyDiagnosis  String
  cytologyBethesdaId String?

  // Histology side.
  histologyRecordId  String?
  histologyDate      DateTime?
  histologyDiagnosis String?
  histologySource    HistologySource @default(Internal)
  externalLabName    String?

  // Correlation result.
  correlationResult CorrelationResult?
  discordanceReason String?
  reviewRequired    Boolean            @default(false)
  reviewedById      String?
  reviewedBy        User?              @relation("CorrelationReviewer", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  reviewNotes       String?

  // Clinical outcome.
  clinicalOutcome  String?
  followUpRequired Boolean @default(false)

  createdById String?
  createdBy   User?    @relation("CorrelationCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([labId, cytologyDate])
  @@index([patientId])
}

// ─── Proficiency Testing (Tier 4 Compliance) — blind-review competency ───────

enum ProfTestType {
  Internal // created by the lab
  CAP // College of American Pathologists survey
  CLIA // CLIA proficiency test
  External // other external program
}

enum ProfTestStatus {
  Draft // being set up
  Active // pathologists can respond
  Grading // responses locked, being graded
  Completed // graded and scores released
  Archived
}

enum CaseDifficulty {
  Easy
  Standard
  Difficult
  Expert
}

enum ConfidenceLevel {
  Low
  Moderate
  High
}

model ProficiencyTest {
  id           String                @id @default(cuid())
  labId        String
  lab          Lab                   @relation(fields: [labId], references: [id])
  name         String
  description  String?
  testType     ProfTestType          @default(Internal)
  status       ProfTestStatus        @default(Draft)
  startDate    DateTime
  endDate      DateTime
  passingScore Int                   @default(80) // percentage
  createdById  String?
  createdBy    User?                 @relation("ProfTestCreator", fields: [createdById], references: [id])
  cases        ProficiencyCase[]
  responses    ProficiencyResponse[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([labId, name])
}

model ProficiencyCase {
  id         String          @id @default(cuid())
  labId      String
  lab        Lab             @relation(fields: [labId], references: [id])
  testId     String
  test       ProficiencyTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  caseNumber Int // 1, 2, 3... within the test

  // De-identified case info (no patient name).
  specimenType    String
  clinicalHistory String?
  imageUrl        String?

  // Expected answer (hidden from reviewers).
  expectedDiagnosis String
  expectedBethesda  String?
  difficulty        CaseDifficulty @default(Standard)

  responses ProficiencyResponse[]
  createdAt DateTime              @default(now())
}

model ProficiencyResponse {
  id          String          @id @default(cuid())
  labId       String
  lab         Lab             @relation(fields: [labId], references: [id])
  testId      String
  test        ProficiencyTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  caseId      String
  case        ProficiencyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  responderId String
  responder   User            @relation("ProfResponder", fields: [responderId], references: [id])

  diagnosis      String
  bethesdaAnswer String?
  confidence     ConfidenceLevel @default(Moderate)
  notes          String?

  isCorrect   Boolean?
  score       Int?
  gradedAt    DateTime?
  gradedById  String?
  submittedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([caseId, responderId])
}

// ─── Reagent / Stain Lot Tracking (Tier 4 Compliance) ────────────────────────

enum ReagentStatus {
  Active // in use
  Quarantined // suspected problem — do not use
  Depleted // used up
  Expired // past expiry date
  Recalled // manufacturer recall
}

model ReagentLot {
  id            String        @id @default(cuid())
  labId         String
  lab           Lab           @relation(fields: [labId], references: [id])
  name          String // e.g. "Papanicolaou Stain"
  manufacturer  String?
  catalogNumber String?
  lotNumber     String // the actual lot/batch number
  expiryDate    DateTime?
  receivedDate  DateTime      @default(now())
  openedDate    DateTime?
  status        ReagentStatus @default(Active)
  quantity      Float?
  unit          String?
  storageTemp   String?
  notes         String?

  usages      ReagentUsage[]
  createdById String?
  createdBy   User?          @relation("ReagentCreator", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([labId, lotNumber])
  @@index([labId, status])
}

model ReagentUsage {
  id           String     @id @default(cuid())
  labId        String
  lab          Lab        @relation(fields: [labId], references: [id])
  reagentLotId String
  reagentLot   ReagentLot @relation(fields: [reagentLotId], references: [id], onDelete: Cascade)
  recordId     String?
  record       Record?    @relation(fields: [recordId], references: [id])
  batchId      String?
  usedById     String
  usedBy       User       @relation("ReagentUser", fields: [usedById], references: [id])
  quantityUsed Float?
  usedAt       DateTime   @default(now())
  notes        String?

  @@index([reagentLotId])
  @@index([recordId])
}

// ─── Patient Recall Management (Tier 4 Compliance) ───────────────────────────

enum RecallStatus {
  Pending // not yet due
  Due // past dueDate, not yet completed
  Overdue // significantly past dueDate (> 3 months)
  Completed // patient returned for follow-up
  Cancelled // cancelled by clinician
  Declined // patient declined recall
}

// A scheduled follow-up for a patient, derived from a triggering cytology result.
model RecallRecord {
  id        String  @id @default(cuid())
  labId     String
  lab       Lab     @relation(fields: [labId], references: [id])
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  // Triggering result.
  triggerRecordId  String
  triggerRecord    Record   @relation(fields: [triggerRecordId], references: [id], onDelete: Cascade)
  triggerDiagnosis String
  triggerDate      DateTime

  // Recall schedule.
  recallIntervalMonths Int
  dueDate              DateTime

  // Status tracking.
  status           RecallStatus @default(Pending)
  reminderSentAt   DateTime?
  reminderSentById String?

  // Completion.
  completedAt       DateTime?
  completedRecordId String?

  // Client notification.
  clientNotifiedAt DateTime?
  clientId         String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@unique([labId, triggerRecordId])
  @@index([labId, dueDate])
  @@index([patientId])
}

// ─── Digital Pathology — enums (Program 5A · P5-1A) ──────────────────────────
enum SlideAvailabilityStatus {
  DRAFT // no published derivative generation yet (or intake/processing in progress)
  PUBLISHED // a sealed+verified generation is authoritative, OR a legacy external slide
  ARCHIVED // withdrawn from clinical use; provenance retained
}

enum IngestionStatus {
  UPLOADING
  UPLOADED
  VERIFIED // sourceChecksum computed + verified
  FAILED
}

enum ProcessingJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
}

enum GenerationStatus {
  PROCESSING
  QC_PENDING
  QC_FAILED
  READY // sealed + verified; NOT yet clinically published
  PUBLISHED
  SUPERSEDED
  ARCHIVED
  FAILED
}

enum TileSourceType {
  IMAGE
  DZI
  IIIF
  DICOMWEB
}

enum SlideSourceKind {
  EXTERNAL_URL
  UPLOAD
  WATCH_FOLDER
  SCANNER
  DICOM
}

enum SlideAssetRole {
  DZI_DESCRIPTOR
  TILE_PYRAMID
  LABEL
  MACRO
  THUMBNAIL
  MANIFEST // P5-3B.0 — the persisted canonical manifest bytes; sha256(bytes) == DerivativeGeneration.derivativeManifestChecksum. Single-per-sealed-generation is a sealing invariant (not a DB constraint).
}

// ─── Whole Slide Imaging (Tier 5 — Enterprise) ───────────────────────────────
// Program 5A extends this from a URL-referenced slide into the root of the digital
// pathology asset aggregate. `DigitalSlide` = the long-lived CLINICAL identity of a
// slide; ingestion → processing job → derivative generation → asset are its
// replaceable operational history (aggregate children). `Record` owns the clinical
// relationship (accession/diagnosis/workflow); the slide owns the digital-asset
// lifecycle. WSI viewability derives from a genuinely published, sealed, verified generation via the
// authenticated delivery boundary — NOT from legacy `slideUrl`. Historical URL-only rows may remain
// retained but are non-viewable (P5-4 Phase B). The column is kept for compatibility/dual-read.
model DigitalSlide {
  id       String @id @default(cuid())
  labId    String
  lab      Lab    @relation(fields: [labId], references: [id])
  recordId String
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade) // clinical anchor; deletion policy unchanged in P5-1A

  // Optional specimen anchor (P5-1). Nullable by design — record-only slides remain
  // valid. The specimen must belong to the same record + tenant (a service invariant).
  specimenId String?
  specimen   Specimen? @relation(fields: [specimenId], references: [id], onDelete: SetNull)

  // Legacy source (retained for backward compatibility / dual-read).
  slideUrl String
  format   String @default("image") // legacy container hint; superseded by tileSourceType

  // Acquisition metadata (intrinsic to the source image).
  tileSourceType TileSourceType? // backfilled from `format`; NOT NULL after backfill (Phase C)
  sourceKind     SlideSourceKind? // backfilled EXTERNAL_URL; NOT NULL after backfill (Phase C)
  storageKey     String? // in-platform private source object key (null for legacy external)
  objectivePower Float?
  mpp            Float? // microns per pixel
  sourceWidth    Int?
  sourceHeight   Int?
  magnification  String? // existing free-text (kept)
  stain          String?
  scanner        String?
  fileSizeBytes  Int?

  // Clinical availability + publication provenance (Refinement 3).
  availabilityStatus    SlideAvailabilityStatus? // backfilled PUBLISHED; NOT NULL after backfill (Phase C)
  publishedGenerationId String?                  @unique
  publishedGeneration   DerivativeGeneration?    @relation("SlidePublished", fields: [publishedGenerationId], references: [id])
  publishedAt           DateTime?
  publishedById         String?

  uploadedById String?
  uploadedAt   DateTime @default(now())

  ingestions                SlideIngestion[]
  generations               DerivativeGeneration[]     @relation("SlideGenerations")
  annotations               SlideAnnotation[]
  publications              GenerationPublication[] // P5-4 — append-only publication provenance for this slide
  deliverySessions          DeliverySession[] // P5-5 — short-lived authenticated viewing capabilities
  inferenceRecords          InferenceRecord[] // P6-6A — inference-record shell references (reference only; no PHI)
  inferenceJobs             InferenceJob[] // P6-6C — inference execution jobs referencing this slide (reference only; no PHI)
  explainabilityGenerations ExplainabilityGeneration[] // P6-6D — coordinate-space subject of explainability sets (reference only; no PHI)
  explainabilityArtifacts   ExplainabilityArtifact[] // P6-6D — geometry-bearing explainability artifacts (reference only; no PHI)
  datasetSlides             DatasetSlide[] // P6-6B — dataset membership references (reference only; no PHI)
  groundTruthLabels         GroundTruthLabel[] // P6-6B — ground-truth labels referencing this slide
  dicomMetadata             SlideDicomMetadata? // P5C-C1 — optional DICOM WSI identity/conformance (1:1; only DICOM-sourced slides)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId])
  @@index([recordId])
  @@index([specimenId])
  @@index([labId, availabilityStatus])
  @@index([labId, publishedGenerationId]) // Refinement 1 (operational lookup)
  @@index([labId, uploadedAt]) // P5-5: primary ordered browse/search path (newest/oldest, tenant-scoped)
}

// A point annotation on a slide, positioned in normalized image coordinates
// (0..1) so overlays track the image across pan/zoom.
model SlideAnnotation {
  id      String       @id @default(cuid())
  labId   String
  lab     Lab          @relation(fields: [labId], references: [id])
  slideId String
  slide   DigitalSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)

  x     Float
  y     Float
  label String
  color String @default("#4F46E5")

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([labId])
  @@index([slideId])
}

// ─── Digital Pathology — asset aggregate (Program 5A · P5-1A) ────────────────
// Ingestion → ProcessingJob → DerivativeGeneration → SlideAsset. A job processes
// exactly one ingestion; a generation is an immutable, sealed tiling result; an
// asset belongs to exactly one generation (no cross-generation sharing).

// One intake of a source object for a slide (+ source integrity).
model SlideIngestion {
  id      String       @id @default(cuid())
  labId   String
  lab     Lab          @relation(fields: [labId], references: [id])
  slideId String
  slide   DigitalSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)

  sourceKind       SlideSourceKind
  status           IngestionStatus @default(UPLOADING)
  sourceChecksum   String? // immutable once VERIFIED (service invariant)
  sourceObjectKey  String? // private storage key of the uploaded original
  originalFilename String?
  sizeBytes        Int?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs SlideProcessingJob[]

  @@index([labId])
  @@index([slideId])
  @@index([labId, sourceChecksum]) // duplicate-upload lookup
}

// One tiling attempt against an ingestion (executed by a background worker; system actor).
model SlideProcessingJob {
  id          String         @id @default(cuid())
  labId       String
  lab         Lab            @relation(fields: [labId], references: [id])
  ingestionId String // Refinement 2 — a job processes exactly one ingestion
  ingestion   SlideIngestion @relation(fields: [ingestionId], references: [id], onDelete: Cascade)

  status         ProcessingJobStatus @default(QUEUED)
  idempotencyKey String?
  attempt        Int                 @default(1)
  startedAt      DateTime?
  finishedAt     DateTime?
  errorCode      String?
  errorDetail    String?

  // P5-3B.0 — lease-based ownership (populated at claim time by the worker in P5-3B.1). Lease DURATION
  // is policy and lives outside the schema; only the resulting expiry timestamp is stored. `workerId`
  // is a LOGICAL worker identity (not necessarily a hostname/container id).
  heartbeatAt    DateTime?
  leaseExpiresAt DateTime?
  workerId       String?

  generation DerivativeGeneration?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // P5-3B.0 migration adds a raw-SQL PARTIAL UNIQUE INDEX on (ingestionId) WHERE status IN
  // ('QUEUED','RUNNING') — the DB backstop for "at most one active job per ingestion".

  @@unique([labId, idempotencyKey])
  @@index([labId])
  @@index([ingestionId])
  @@index([labId, status])
  @@index([status, leaseExpiresAt]) // P5-3B.0 — reclaimer scan (RUNNING jobs with an expired lease)
}

// One immutable, sealed derivative pyramid produced by a job. Publishable only when its
// derivativeManifestChecksum is sealed + verified. `id` is the derivativeGenerationId.
model DerivativeGeneration {
  id      String             @id @default(cuid())
  labId   String
  lab     Lab                @relation(fields: [labId], references: [id])
  slideId String
  slide   DigitalSlide       @relation("SlideGenerations", fields: [slideId], references: [id], onDelete: Cascade)
  jobId   String             @unique
  job     SlideProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  status                     GenerationStatus @default(PROCESSING)
  tileSourceType             TileSourceType
  tiledWidth                 Int?
  tiledHeight                Int?
  tileSize                   Int?
  levelCount                 Int?
  derivativeManifestChecksum String? // whole-pyramid fingerprint (P5-0 §7); sealed+verified before publish
  sealed                     Boolean          @default(false)
  verified                   Boolean          @default(false)
  sealedAt                   DateTime?
  // P5-3B.3B — timestamp when INDEPENDENT VERIFICATION reached a terminal verdict (READY or QC_FAILED);
  // NOT merely "when verified=true was set" (a QC_FAILED verdict also stamps it). Null until a verdict.
  verifiedAt                 DateTime?
  publishedAt                DateTime?
  // P5-4 — when this generation CEASED to be the published generation for its slide. publishedAt is never
  // cleared, so (publishedAt, supersededAt) records the full authority window: began → ended.
  supersededAt               DateTime?

  assets            SlideAsset[]
  verifications     GenerationVerification[] // P5-3B.3B — append-only verification provenance
  publications      GenerationPublication[] // P5-4 — append-only publication/supersession provenance
  deliverySessions  DeliverySession[] // P5-5 — short-lived viewing capabilities bound to this generation
  publishedForSlide DigitalSlide?            @relation("SlidePublished")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // P5-1A migration adds a raw-SQL PARTIAL UNIQUE INDEX on (slideId) WHERE status='PUBLISHED'
  // to enforce "at most one published generation per slide" (Prisma cannot express the WHERE).

  @@index([labId])
  @@index([slideId])
  @@index([slideId, status])
}

// One generated object within a generation (tile pyramid, descriptor, label, macro, thumbnail).
model SlideAsset {
  id           String               @id @default(cuid())
  labId        String
  lab          Lab                  @relation(fields: [labId], references: [id])
  generationId String // single FK — an asset belongs to exactly one generation (no cross-generation sharing)
  generation   DerivativeGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  role       SlideAssetRole
  storageKey String
  checksum   String?
  sizeBytes  Int?
  purgedAt   DateTime? // heavy assets may be GC'd while the generation's provenance metadata is retained

  createdAt DateTime @default(now())

  @@index([labId])
  @@index([generationId])
  @@index([generationId, role])
}

// P5-3B.3B — the verification-event vocabulary. Deliberately DISTINCT from GenerationStatus: a record
// describes the verification event (did integrity verification PASS or FAIL), not the generation's
// workflow state. A transient/RETRYABLE result is a non-event and writes NO row.
enum VerificationOutcome {
  PASSED
  FAILED
}

// P5-3B.3B — append-only independent-verification provenance. One generation → many attempts (normal
// Program 5A flow produces a single terminal verdict; the model preserves an audit trail for a future
// explicit re-verification workflow without rewriting history). The QC_PENDING → READY|QC_FAILED
// transition and the matching row here commit in ONE transaction (P5-3B.3B-ii). Restrict on delete: this
// is audit evidence, NOT generation-owned runtime data — a later retention/GC checkpoint decides when its
// deletion is permitted, never a silent cascade.
model GenerationVerification {
  id           String               @id @default(cuid())
  labId        String
  lab          Lab                  @relation(fields: [labId], references: [id])
  generationId String
  generation   DerivativeGeneration @relation(fields: [generationId], references: [id], onDelete: Restrict)

  outcome          VerificationOutcome
  reasons          Json // ordered [{code, detail}] — the frozen B.3A taxonomy in deterministic order; [] for PASSED
  manifestChecksum String // the sealed fingerprint this attempt certified against
  verifierVersion  String // the B.3A verification logic/taxonomy version that produced the outcome
  verifiedAt       DateTime            @default(now())

  createdAt DateTime @default(now())

  @@index([labId])
  @@index([generationId])
  @@index([generationId, outcome])
}

// P5-4 — the publication-event vocabulary.
enum PublicationAction {
  PUBLISHED // a READY generation became the authoritative/live generation for its slide
  SUPERSEDED // a previously-published generation was retired by a newer publication
}

// P5-4 — append-only publication provenance. Every row of ONE publication transaction (the new PUBLISHED
// row, plus a SUPERSEDED row if a prior generation was replaced) shares a `publicationEventId`, so the
// full replacement is reconstructable without relying on timestamp coincidence. Restrict on delete: this
// is clinical audit history, NOT disposable runtime data — a later retention/GC checkpoint decides when
// its deletion is permitted, never a silent cascade.
model GenerationPublication {
  id                 String               @id @default(cuid())
  publicationEventId String // shared by all rows written in ONE publication transaction
  labId              String
  lab                Lab                  @relation(fields: [labId], references: [id])
  slideId            String
  slide              DigitalSlide         @relation(fields: [slideId], references: [id], onDelete: Restrict)
  generationId       String
  generation         DerivativeGeneration @relation(fields: [generationId], references: [id], onDelete: Restrict)

  action      PublicationAction
  actorUserId String? // the actor who performed the publication; populated by the later HTTP layer (no FK)
  at          DateTime // the shared publication-event instant (matches the generation/slide publishedAt|supersededAt)

  createdAt DateTime @default(now())

  @@index([labId])
  @@index([slideId])
  @@index([generationId])
  @@index([publicationEventId])
  @@index([slideId, at])
}

// P5-5 — explicit viewing capabilities. These are SECURITY scopes, so they are a closed schema enum (never
// a free-form string): a new capability requires an intentional schema/security review, not arbitrary text.
enum DeliveryScope {
  DESCRIPTOR // the DZI descriptor
  TILES // the tile pyramid
  ASSOCIATED_IMAGES // label / macro / thumbnail
  MANIFEST // the canonical manifest bytes
}

// P5-5 — a short-lived, generation-bound viewing capability issued to an already-authenticated staff
// principal. The DATABASE is authoritative for validity (revokedAt IS NULL AND expiresAt > now), scopes,
// actor, lab, slide, and the bound generation — never client-supplied claims. Only the SHA-256 hash of the
// opaque 256-bit bearer token is stored; the raw token exists solely in the issuance response + on the
// client. This is operational capability state, NOT clinical audit history — hence normal operational FK
// lifecycle (Cascade to slide/generation), while labId stays Restrict per tenancy convention.
model DeliverySession {
  id           String               @id @default(cuid())
  labId        String
  lab          Lab                  @relation(fields: [labId], references: [id])
  slideId      String
  slide        DigitalSlide         @relation(fields: [slideId], references: [id], onDelete: Cascade)
  generationId String
  generation   DerivativeGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  actorUserId String // the authenticated staff principal (plain id, no FK — actor identity survives user deletion)
  tokenHash   String          @unique // SHA-256(rawToken); the raw capability is NEVER persisted
  scopes      DeliveryScope[]

  issuedAt  DateTime
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([labId])
  @@index([actorUserId])
  @@index([slideId])
  @@index([generationId])
  @@index([expiresAt])
  @@index([labId, expiresAt]) // later cleanup / per-lab expiry scans
}

// ─── AI Screening (Tier 5 — Enterprise) ──────────────────────────────────────
// Pre-screening results that flag abnormal cells before pathologist review.
// One result per record; findings/confidence are surfaced in the result-entry
// and authorization workflow, and tracked for AI-vs-pathologist agreement.
enum AIScreenStatus {
  Pending // not yet screened
  Processing // AI analysis in progress
  Completed // results available
  Failed // screening failed
  Skipped // manually skipped
}

enum AIConfidence {
  High // >= 90%
  Medium // 70-89%
  Low // < 70%
}

model AIScreeningResult {
  id       String @id @default(cuid())
  labId    String
  lab      Lab    @relation(fields: [labId], references: [id])
  recordId String @unique
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  status          AIScreenStatus @default(Pending)
  confidence      Float? // 0-100
  confidenceLevel AIConfidence?

  // Findings
  findings       Json? // array of { region, finding, confidence }
  primaryFinding String? // main AI diagnosis
  flaggedAreas   Int     @default(0)

  // Performance tracking
  agreedWithAI    Boolean?
  pathologistNote String?

  processedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("AIScreeningReviewer", fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId])
  @@index([labId, status])
}

// ─── Teleconsultation (Tier 5 — Enterprise) ──────────────────────────────────
// Request a second opinion from an external consultant. The case is shared
// de-identified via a single-use, unguessable access token; the consultant
// responds through a public (token-authenticated) endpoint.
enum ConsultUrgency {
  Routine // 7 days
  Priority // 48 hours
  Urgent // 24 hours
}

enum ConsultStatus {
  Pending // sent, awaiting response
  Viewed // consultant viewed the case
  InProgress // consultant is working on it
  Responded // consultant has responded
  Accepted // lab accepted the opinion
  Declined // lab declined the opinion
  Expired // token expired, no response
}

enum ConsultAgreement {
  FullAgreement
  PartialAgreement
  Disagreement
}

model ConsultRequest {
  id       String @id @default(cuid())
  labId    String
  lab      Lab    @relation(fields: [labId], references: [id])
  recordId String
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("ConsultRequester", fields: [requestedById], references: [id])

  // External consultant
  consultantName        String
  consultantEmail       String
  consultantInstitution String?

  // Case details (de-identified)
  clinicalSummary  String
  specificQuestion String
  urgency          ConsultUrgency @default(Routine)

  // Shared materials
  sharedNarrative Boolean @default(true)
  sharedBethesda  Boolean @default(true)
  sharedImages    Boolean @default(false)

  // Response
  status              ConsultStatus     @default(Pending)
  consultantResponse  String?
  consultantDiagnosis String?
  agreementLevel      ConsultAgreement?
  respondedAt         DateTime?

  // Access token for the external consultant.
  accessToken    String   @unique @default(cuid())
  tokenExpiresAt DateTime

  dueDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([labId, status])
  @@index([recordId])
}

// ─── LOINC / SNOMED Coding (Tier 5 — Enterprise) ─────────────────────────────
// Standardized medical coding on results for billing + EMR interoperability.
enum CodeSystem {
  LOINC
  SNOMED_CT
  ICD10
  CPT
}

enum CodingType {
  Procedure // what test was done
  Diagnosis // what was found
  Specimen // specimen type
  Finding // specific finding
}

// A lab's coding dictionary entry (LOINC/SNOMED/ICD10/CPT).
model MedicalCode {
  id         String     @id @default(cuid())
  labId      String
  lab        Lab        @relation(fields: [labId], references: [id])
  system     CodeSystem
  code       String
  display    String
  category   String?
  isActive   Boolean    @default(true)
  usageCount Int        @default(0)

  recordCodings RecordCoding[]
  createdAt     DateTime       @default(now())

  @@unique([labId, system, code])
  @@index([labId, system])
}

// A code assigned to a specific record.
model RecordCoding {
  id       String      @id @default(cuid())
  labId    String
  lab      Lab         @relation(fields: [labId], references: [id])
  recordId String
  record   Record      @relation(fields: [recordId], references: [id], onDelete: Cascade)
  codeId   String
  code     MedicalCode @relation(fields: [codeId], references: [id])
  codeType CodingType

  assignedById String?
  assignedBy   User?    @relation(fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())
  notes        String?

  @@unique([recordId, codeId])
  @@index([recordId])
  @@index([labId])
}

// ─── HL7 / FHIR Integration (Tier 5 — Enterprise) ────────────────────────────
// Send authorized results to hospital EMRs as FHIR R4 DiagnosticReport
// resources. Sandbox endpoints build + store the payload without POSTing.
enum EMRSystem {
  Epic
  Cerner
  Meditech
  Allscripts
  Generic
}

enum FHIRAuthType {
  Bearer
  OAuth2
  APIKey
  None
}

enum TransmissionStatus {
  Pending
  Sending
  Success
  Failed
  Retrying
}

model FHIREndpoint {
  id           String       @id @default(cuid())
  labId        String
  lab          Lab          @relation(fields: [labId], references: [id])
  name         String
  baseUrl      String
  system       EMRSystem    @default(Epic)
  authType     FHIRAuthType @default(Bearer)
  authToken    String? // encrypt in production
  clientId     String?
  clientSecret String?
  isActive     Boolean      @default(true)
  isSandbox    Boolean      @default(true)

  lastTestedAt   DateTime?
  lastTestStatus String?

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  transmissions FHIRTransmission[]

  @@unique([labId, name])
  @@index([labId])
}

model FHIRTransmission {
  id         String       @id @default(cuid())
  labId      String
  lab        Lab          @relation(fields: [labId], references: [id])
  endpointId String
  endpoint   FHIREndpoint @relation(fields: [endpointId], references: [id])
  recordId   String
  record     Record       @relation(fields: [recordId], references: [id], onDelete: Cascade)

  status         TransmissionStatus @default(Pending)
  fhirResourceId String?
  fhirPayload    Json
  responseCode   Int?
  responseBody   String?
  errorMessage   String?
  retryCount     Int                @default(0)
  transmittedAt  DateTime?
  createdAt      DateTime           @default(now())

  @@index([labId, status])
  @@index([recordId])
}

// ─── Tier 6: Workforce Management ─────────────────────────────────────────────
model ClockEvent {
