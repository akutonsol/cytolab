  labId       String
  name        String
  description String?
  icon        String?
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  articles    KbArticle[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([labId])
