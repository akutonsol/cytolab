// Cytolab 2.0 — Prisma schema
// Phase 1: auth & identity (Lab, Account, Workspace, User, Role, Permission, AuthAttempt)
// Phase 2: lab intake (Patient, ClientType, Client, Requisition, Record, Specimen, Therapy, RecordStatusEvent)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Enums ----

enum Gender {
  Male
  Female
}

enum ClientTypeEnum {
  Doctor
  Laboratory
}

enum SpecimenType {
  // Gynecology specimen types.
  ENDOCERV_ASP
  CERV_SCRAP
  VAG_POOL
  // Non-gynecology specimen types.
  URINE
  CSF
  PLEURAL_FLD
  BREAST_ASP
  JOINT_ASP
  SYNOVIAL_FLD
  OTHER
  SPUTUM
  BRONCHIAL_WASH
  THYROID_FNA
  LYMPH_NODE
  BONE_MARROW
  SKIN_SCRAPING
}

enum RecordStatus {
  Pending
  Submitted
  Processing
  Partial
  Completed
  // Record has a result sheet but is not yet authorized (between Completed and
  // Approved).
  Resulted
  Approved
  Billed
  Paid
  OnHold
  Disabled
  Failed
  Viewed
}

enum RequisitionStatus {
  Pending
  Active
  Partial
  Completed
  Disabled
}

// Cytology test CLASS on a requisition line — orthogonal to SpecimenType
// (which is the specimen material). Legacy Gynecology/Nongynecology toggle.
enum RequisitionFormType {
  Gynecology
  NonGynecology
}

enum ResultSheetEventType {
  Authorized
  Deauthorized
  Reauthorized
  // F4 AI-assist audit trail (assistive only — never an authorization).
  AiDrafted
  AiAccepted
}

// Legacy authorizer_enum: a staff authorizer's professional designation, stamped
// on released reports next to their name (e.g. "Dr. Jane Doe — CYTOLOGIST").
enum AuthorizerDesignation {
  Pathologist
  Cytologist
}

// Legacy payment_type_enum.
enum PaymentType {
  Cash
  Cheque
  CreditCard
  DebitCard
  BankTransfer
}

enum BillStatus {
  Draft
  Issued
  PartiallyPaid
  Paid
}

// ---- Phase 5: Client Portal (F2) ----

enum ChangeRequestType {
  DemographicsCorrection
  AddTest
  CancelRequest
  GeneralQuery
}

enum ChangeRequestStatus {
  Open
  InReview
  Actioned
  Declined
}

// Credential token kind: initial invite (set first password) or password reset.
enum PortalTokenType {
  Invite
  Reset
}

// ---- F1: Multi-lab tenancy (every tenant-owned model carries labId) ----

model Lab {
  id                     String                   @id @default(uuid())
  name                   String
  slug                   String                   @unique
  logoUrl                String?
  // Branding shown on rendered report PDFs (Phase 3.5).
  address                String?
  phone                  String?
  email                  String?
  currency               String                   @default("JMD")
  isActive               Boolean                  @default(true)
  // Analytics targets. targetTatDays: expected turnaround (Submitted->Approved);
  // monthlyVolumeTarget: expected specimens/month (null -> derived from history).
  targetTatDays          Int                      @default(3)
  monthlyVolumeTarget    Int?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  accounts               Account[]
  users                  User[]
  workspaces             Workspace[]
  patients               Patient[]
  clientTypes            ClientType[]
  clients                Client[]
  requisitions           Requisition[]
  records                Record[]
  specimens              Specimen[]
  requisitionLines       RequisitionLine[]
  recordStatusEvents     RecordStatusEvent[]
  therapies              Therapy[]
  cabinets               Cabinet[]
  codeSheets             CodeSheet[]
  codeFindings           CodeFinding[]
  labCodes               LabCode[]
  aiSettings             LabAiSettings?
  aiDrafts               AiDraft[]
  resultSheets           ResultSheet[]
  resultEntries          ResultEntry[]
  resultLines            ResultLine[]
  reports                Report[]
  resultSheetEvents      ResultSheetEvent[]
  services               Service[]
  taxes                  Tax[]
  bills                  Bill[]
  billLines              BillLine[]
  billTaxes              BillTax[]
  payments               Payment[]
  portalUsers            PortalUser[]
  portalAccessTokens     PortalAccessToken[]
  changeRequests         ChangeRequest[]
  changeRequestMessages  ChangeRequestMessage[]
  changeRequestEvents    ChangeRequestEvent[]
  patientAddresses       PatientAddress[]
  clientAddresses        ClientAddress[]
  sequences              LabSequence[]
  gynClinicalFeatures    GynClinicalFeatures[]
  nonGynClinicalFeatures NonGynClinicalFeatures[]
  specimenImages         SpecimenImage[]
  recordAttachments      RecordAttachment[]
  threads                Thread[]
  appointments           Appointment[]
  formConfigs            FormConfig[]
  notifications          Notification[]
  departments            Department[]
  employees              Employee[]
  payrollRuns            PayrollRun[]
  payAdvices             PayAdvice[]
  resultTemplates        ResultTemplate[]
  bethesdaResults        BethesdaResult[]
  tatConfigs             TATConfig[]
  tatAlerts              TATAlert[]
  features               LabFeature[]
  escalations            EscalationRecord[]
  workloadTargets        WorkloadTarget[]
  qcChecks               QCCheck[]
  equipment              Equipment[]
  qcFailureAlerts        QCFailureAlert[]
  requisitionTrackings   RequisitionTracking[]
  trackingEvents         TrackingEvent[]
  correlationCases       CorrelationCase[]
  proficiencyTests       ProficiencyTest[]
  proficiencyCases       ProficiencyCase[]
  proficiencyResponses   ProficiencyResponse[]
  reagentLots            ReagentLot[]
  reagentUsages          ReagentUsage[]
  recalls                RecallRecord[]
  digitalSlides          DigitalSlide[]
  slideAnnotations       SlideAnnotation[]
  aiScreenings           AIScreeningResult[]
  consultRequests        ConsultRequest[]
  medicalCodes           MedicalCode[]
  recordCodings          RecordCoding[]
  fhirEndpoints          FHIREndpoint[]
  fhirTransmissions      FHIRTransmission[]
}

model Account {
  labId      String
  lab        Lab         @relation(fields: [labId], references: [id])
  id         String      @id @default(uuid())
  name       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  users      User[]
  workspaces Workspace[]
}

model Workspace {
  id           String        @id @default(uuid())
  labId        String
  lab          Lab           @relation(fields: [labId], references: [id])
  name         String
  accountId    String
  account      Account       @relation(fields: [accountId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  requisitions Requisition[]
  records      Record[]
  clients      Client[]

  @@index([accountId])
}

model User {
  id                     String                 @id @default(uuid())
  labId                  String
  lab                    Lab                    @relation(fields: [labId], references: [id])
  email                  String
  passwordHash           String
  firstName              String
  lastName               String
  // Authorizer signature image for rendered reports (Phase 3.5). Typed name
  // (firstName lastName) is the fallback when this is absent.
  signatureUrl           String?
  // Professional designation for staff who authorize result sheets (legacy
  // Authorizer.type). Null for non-authorizer staff; rendered on the report.
  authorizerDesignation  AuthorizerDesignation?
  isActive               Boolean                @default(true)
  accountId              String
  account                Account                @relation(fields: [accountId], references: [id])
  workspaceId            String?
  workspace              Workspace?             @relation(fields: [workspaceId], references: [id])
  roles                  UserRole[]
  authAttempts           AuthAttempt[]
  recordStatusEvents     RecordStatusEvent[]
  authorizedResultSheets ResultSheet[]          @relation("ResultSheetAuthorizer")
  authoredReports        Report[]               @relation("ReportAuthor")
  resultSheetEvents      ResultSheetEvent[]
  aiDraftsCreated        AiDraft[]              @relation("AiDraftCreatedBy")
  aiDraftsAccepted       AiDraft[]              @relation("AiDraftAcceptedBy")
  aiScreeningsReviewed   AIScreeningResult[]    @relation("AIScreeningReviewer")
  consultRequests        ConsultRequest[]       @relation("ConsultRequester")
  recordCodings          RecordCoding[]
  assignedChangeRequests ChangeRequest[]        @relation("ChangeRequestAssignee")
  changeRequestMessages  ChangeRequestMessage[] @relation("ChangeRequestMessageStaffAuthor")
  changeRequestEvents    ChangeRequestEvent[]   @relation("ChangeRequestEventStaffActor")
  threadParticipants     ThreadParticipant[]
  authoredMessages       Message[]
  assignedAppointments   Appointment[]          @relation("AppointmentAssignee")
  createdAppointments    Appointment[]          @relation("AppointmentCreator")
  notifications          Notification[]
  typingIndicators       TypingIndicator[]
  // HR / Payroll (Phase 7)
  employeeProfile        Employee?              @relation("EmployeeUser")
  managedDepartments     Department[]           @relation("DepartmentManager")
  processedPayrollRuns   PayrollRun[]           @relation("PayrollProcessor")
  approvedPayrollRuns    PayrollRun[]           @relation("PayrollApprover")
  resultTemplates        ResultTemplate[]       @relation("ResultTemplateCreator")
  bethesdaResults        BethesdaResult[]       @relation("BethesdaReporter")
  acknowledgedTatAlerts  TATAlert[]             @relation("TATAcknowledger")
  toggledFeatures        LabFeature[]           @relation("LabFeatureToggler")
  escalationsAssigned    EscalationRecord[]     @relation("EscalationAssignee")
  escalationsReviewed    EscalationRecord[]     @relation("EscalationReviewer")
  assignedRecords        Record[]               @relation("RecordAssignee")
  workloadTarget         WorkloadTarget?
  qcChecks               QCCheck[]
  formsReceived          RequisitionTracking[]  @relation("FormReceiver")
  benchReceived          RequisitionTracking[]  @relation("BenchReceiver")
  formsVerified          RequisitionTracking[]  @relation("FormVerifier")
  formsFiled             RequisitionTracking[]  @relation("FormFiler")
  trackingEvents         TrackingEvent[]        @relation("TrackingEventActor")
  correlationsReviewed   CorrelationCase[]      @relation("CorrelationReviewer")
  correlationsCreated    CorrelationCase[]      @relation("CorrelationCreator")
  proficiencyTests       ProficiencyTest[]      @relation("ProfTestCreator")
  proficiencyResponses   ProficiencyResponse[]  @relation("ProfResponder")
  reagentLotsCreated     ReagentLot[]           @relation("ReagentCreator")
  reagentUsages          ReagentUsage[]         @relation("ReagentUser")
  clockEventEdits        ClockEvent[]           @relation("ClockEventEditor")
  timesheetsReviewed     Timesheet[]            @relation("TimesheetReviewer")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([labId, email])
  @@index([accountId])
  @@index([labId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  // When true, holders bypass all permission checks (the permissions guard
  // checks this flag, not a hardcoded role name) — legacy super_role parity, so
  // a lab can have multiple named super roles.
  isSuperRole Boolean          @default(false)
  // Legacy User/Workspace role toggle. Workspace-CONSTRAINED enforcement is
  // deferred (future RBAC) — the column only preserves the scope and lets the
  // admin UI show the selector. All roles are User-scoped today.
  scope       RoleScope        @default(User)
  users       UserRole[]
  permissions RolePermission[]
}

enum RoleScope {
  User
  Workspace
}

model Permission {
  id    String           @id @default(uuid())
  code  String           @unique
  label String
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuthAttempt {
  id           String      @id @default(uuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  // Set for portal logins so portal lockouts never conflate with staff lockouts
  // even when a portal email collides with a staff email in the same lab.
  portalUserId String?
  portalUser   PortalUser? @relation(fields: [portalUserId], references: [id])
  portal       Boolean     @default(false)
  email        String
  ip           String?
  success      Boolean
  createdAt    DateTime    @default(now())

  @@index([email, createdAt])
  @@index([portal, email, createdAt])
}

// ---- Phase 2: Lab Intake ----

model Patient {
  id               String           @id @default(uuid())
  labId            String
  lab              Lab              @relation(fields: [labId], references: [id])
  registrationNo   String
  firstName        String
  lastName         String
  middleName       String?
  // Age is DERIVED from dateOfBirth (read-only), never stored — see DATA_MIGRATION_PLAN.md.
  phoneNumber      String?
  bloodGroup       String?
  gender           Gender?
  height           Float?
  weight           Float?
  email            String?
  dateOfBirth      DateTime?
  identityToken    String?
  motherMaidenName String?
  // Nullable stub — actual upload/serving deferred to Phase 6 file storage.
  avatarUrl        String?
  clientId         String?
  client           Client?          @relation(fields: [clientId], references: [id])
  addresses        PatientAddress[]
  records          Record[]
  appointments     Appointment[]
  correlationCases CorrelationCase[]
  recalls          RecallRecord[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([labId, registrationNo])
  @@index([labId])
  @@index([clientId])
}

model ClientType {
  id        String         @id @default(uuid())
  labId     String
  lab       Lab            @relation(fields: [labId], references: [id])
  name      String
  type      ClientTypeEnum
  clients   Client[]
  createdAt DateTime       @default(now())

  @@index([labId])
}

model Client {
  id                    String                 @id @default(uuid())
  labId                 String
  lab                   Lab                    @relation(fields: [labId], references: [id])
  firstName             String
  lastName              String
  officeName            String?
  // Client account number (legacy AC#, e.g. CYLB-577071) — lab-code prefix +
  // seeded LabSequence counter; imported verbatim. Nullable at the column level
  // but always set on create.
  accountNo             String?
  // Supports the patient form's "choose client by name OR email" search.
  email                 String?
  phoneNumber           String?
  mobileNumber          String?
  officeNumber          String?
  faxNumber             String?
  // Active/blocked toggles from the legacy Client form.
  active                Boolean                @default(true)
  blocked               Boolean                @default(false)
  // Nullable stub — actual upload/serving deferred to Phase 6 file storage.
  avatarUrl             String?
  // The client's assigned lab code/region (legacy "Labcode" dropdown). Closes
  // the Phase 3 "LabCode <-> Client" tracked debt.
  labCodeId             String?
  labCode               LabCode?               @relation(fields: [labCodeId], references: [id])
  // Optional workspace the client belongs to (legacy "Workspace" section).
  workspaceId           String?
  workspace             Workspace?             @relation(fields: [workspaceId], references: [id])
  clientTypeId          String?
  clientType            ClientType?            @relation(fields: [clientTypeId], references: [id])
  patients              Patient[]
  requisitions          Requisition[]
  records               Record[]
  specimens             Specimen[]
  cabinets              Cabinet[]
  bills                 Bill[]
  addresses             ClientAddress[]
  portalUsers           PortalUser[]
  changeRequests        ChangeRequest[]
  changeRequestMessages ChangeRequestMessage[]
  changeRequestEvents   ChangeRequestEvent[]
  threads               Thread[]
  appointments          Appointment[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([labId, accountNo])
  @@index([labCodeId])
  @@index([workspaceId])
  @@index([labId])
}

model Requisition {
  id           String            @id @default(uuid())
  labId        String
  lab          Lab               @relation(fields: [labId], references: [id])
  // Human-facing requisition number (legacy Ref#, e.g. 1460). Auto-generated
  // per lab via a seeded LabSequence; imported verbatim during migration.
  // Nullable at the column level (survives existing rows) but always set on
  // create — mirrors PortalUser.username.
  referenceNo  String?
  status       RequisitionStatus @default(Pending)
  // Batch total = Σ line costs, in minor units (cents). Never a float.
  amount       Int               @default(0)
  clientId     String?
  client       Client?           @relation(fields: [clientId], references: [id])
  workspaceId  String?
  workspace    Workspace?        @relation(fields: [workspaceId], references: [id])
  lines        RequisitionLine[]
  dateReceived DateTime?
  tracking       RequisitionTracking?
  trackingEvents TrackingEvent[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([labId, referenceNo])
  @@index([labId])
  @@index([clientId])
}

model RequisitionLine {
  id            String              @id @default(uuid())
  labId         String
  lab           Lab                 @relation(fields: [labId], references: [id])
  requisitionId String
  requisition   Requisition         @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  // Cytology test class (Gyn/NonGyn), separate from the specimen material.
  formType      RequisitionFormType @default(Gynecology)
  isUrgent      Boolean             @default(false)
  // Cached fulfillment flag: true once the linked record reaches Completed+.
  // The parent requisition's Partial/Completed status is recomputed from these.
  isCompleted   Boolean             @default(false)
  notes         String?
  // Line cost in minor units (cents). Never a float.
  amount        Int                 @default(0)
  recordId      String?
  record        Record?             @relation(fields: [recordId], references: [id])

  @@index([labId])
  @@index([requisitionId])
  @@index([recordId])
}

model Record {
  id                String                  @id @default(uuid())
  labId             String
  lab               Lab                     @relation(fields: [labId], references: [id])
  // Internal, stable system id (never human-edited). Generated at create.
  identifier        String
  // Human-facing case number (legacy Lab No., e.g. CBL26-06-465). Generated per
  // lab via a MONTHLY-reset LabSequence; imported verbatim. Nullable at the
  // column level (survives existing rows) but always set on create.
  labNumber         String?
  // Which clinical form this case uses — the discriminator for which
  // *ClinicalFeatures relation applies. Reuses RequisitionFormType (flows
  // requisition-line -> record); one shared enum.
  formType          RequisitionFormType?
  // Referring/requesting doctor (free-text on the record form).
  doctor            String?
  clinicalDiagnosis String?
  specimenDate      DateTime?
  urgent            Boolean                 @default(false)
  medicalEntry      String?
  billed            Boolean                 @default(false)
  status            RecordStatus            @default(Pending)
  dateStatus        DateTime?
  patientId         String
  patient           Patient                 @relation(fields: [patientId], references: [id])
  clientId          String?
  client            Client?                 @relation(fields: [clientId], references: [id])
  workspaceId       String?
  workspace         Workspace?              @relation(fields: [workspaceId], references: [id])
  specimens         Specimen[]
  statusHistory     RecordStatusEvent[]
  requisitionLines  RequisitionLine[]
  therapy           Therapy?
  gynFeatures       GynClinicalFeatures?
  nonGynFeatures    NonGynClinicalFeatures?
  resultSheets      ResultSheet[]
  bethesdaResult    BethesdaResult?
  tatAlerts         TATAlert[]
  escalations       EscalationRecord[]
  qcChecks          QCCheck[]
  cytologyCorrelations CorrelationCase[]    @relation("CytologyRecord")
  reagentUsages     ReagentUsage[]
  recalls           RecallRecord[]
  digitalSlides     DigitalSlide[]
  aiScreening       AIScreeningResult?
  consultRequests   ConsultRequest[]
  codings           RecordCoding[]
  fhirTransmissions FHIRTransmission[]
  // Case assignment (Tier 2 — workload balancing). Fields are unconditional in
  // the schema; only the UI is feature-gated.
  assignedToId      String?
  assignedTo        User?                   @relation("RecordAssignee", fields: [assignedToId], references: [id])
  assignedAt        DateTime?
  assignedById      String?
  bills             Bill[]
  changeRequests    ChangeRequest[]
  attachments       RecordAttachment[]
  cabinetId         String?
  cabinet           Cabinet?                @relation(fields: [cabinetId], references: [id])
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([labId, identifier])
  @@unique([labId, labNumber])
  @@index([labId])
  @@index([patientId])
  @@index([clientId])
  @@index([cabinetId])
  @@index([status])
}

// Append-only status history — feeds the client portal (F2) status timeline
model RecordStatusEvent {
  id        String       @id @default(uuid())
  labId     String
  lab       Lab          @relation(fields: [labId], references: [id])
  recordId  String
  record    Record       @relation(fields: [recordId], references: [id], onDelete: Cascade)
  status    RecordStatus
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  notes     String?
  createdAt DateTime     @default(now())

  @@index([labId])
  @@index([recordId])
  @@index([recordId, createdAt])
}

model Specimen {
  id            String          @id @default(uuid())
  labId         String
  lab           Lab             @relation(fields: [labId], references: [id])
  label         String?
  vialColour    String?
  antiserumA    String?
  antiserumB    String?
  rhSolution    String?
  type          SpecimenType
  bloodGroup    String?
  recordId      String
  record        Record          @relation(fields: [recordId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?         @relation(fields: [clientId], references: [id])
  dateReceived  DateTime?
  resultEntries ResultEntry[]
  images        SpecimenImage[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([labId])
  @@index([recordId])
}

model Therapy {
  id        String  @id @default(uuid())
  labId     String
  lab       Lab     @relation(fields: [labId], references: [id])
  recordId  String  @unique
  record    Record  @relation(fields: [recordId], references: [id], onDelete: Cascade)
  hormone   Boolean @default(false)
  radiation Boolean @default(false)
  surgical  Boolean @default(false)
  other     String?

  @@index([labId])
}

// ---- Phase 3: Results & Coding ----

// A named, colored filing folder linked to a Client. Its contents are that
// client's specimen records (automatic-by-client: records where clientId =
// cabinet.clientId), NOT the legacy per-record Record.cabinetId assignment,
// which is now deprecated (kept as a column, no longer written/read here).
// `identifier` holds the reference code CB{accountNo}-{RAND4}, generated when a
// client is linked.
model Cabinet {
  id         String   @id @default(uuid())
  labId      String
  lab        Lab      @relation(fields: [labId], references: [id])
  label      String
  identifier String?
  color      String?
  // The linked client. At most one cabinet per client (nullable → many unlinked
  // cabinets allowed, since Postgres treats NULLs as distinct).
  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id])
  records    Record[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([labId, clientId])
  @@index([labId])
  @@index([clientId])
}

// Reference list of diagnostic code sheets.
model CodeSheet {
  id           String   @id @default(uuid())
  labId        String
  lab          Lab      @relation(fields: [labId], references: [id])
  abbreviation String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([labId])
}

// Reference list of code findings (independent of CodeSheet, per legacy).
model CodeFinding {
  id           String   @id @default(uuid())
  labId        String
  lab          Lab      @relation(fields: [labId], references: [id])
  abbreviation String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([labId])
}

// Lab/region code.
model LabCode {
  id        String   @id @default(uuid())
  labId     String
  lab       Lab      @relation(fields: [labId], references: [id])
  code      String
  region    String?
  clients   Client[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Legacy enforced a unique code; per-lab uniqueness is the multi-tenant form.
  @@unique([labId, code])
  @@index([labId])
}

// A record's result sheet: filled with entries/lines, then authorized.
// Authorization (who/when) is the gate that allows a report to be released.
model ResultSheet {
  id             String             @id @default(uuid())
  labId          String
  lab            Lab                @relation(fields: [labId], references: [id])
  recordId       String
  record         Record             @relation(fields: [recordId], references: [id], onDelete: Cascade)
  // External uploaded result sheet (stub — populated when Phase 6 file storage
  // lands; the in-system entry path uses resultEntries below).
  fileUrl        String?
  viewed         Boolean            @default(false)
  // Authorization gate (Phase 3 critical rule): set by a user holding
  // resultsheet:authorize. Editing entries resets these (re-authorization required).
  authorized     Boolean            @default(false)
  authorizedAt   DateTime?
  authorizedById String?
  authorizedBy   User?              @relation("ResultSheetAuthorizer", fields: [authorizedById], references: [id])
  // Human-owned working narrative the Authorizer edits and signs. An accepted AI
  // draft (F4) is copied here; at report release this becomes Report.content.
  // Owned by the human — the AiDraft keeps the provenance separately.
  narrative      String?
  resultEntries  ResultEntry[]
  reports        Report[]
  events         ResultSheetEvent[]
  aiDrafts       AiDraft[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([labId])
  @@index([recordId])
}

// Append-only audit of authorization state changes (authorize / de-authorize on
// edit / re-authorize). The live gate stays on ResultSheet; this is the history,
// and will feed the client portal (F2) report timeline.
model ResultSheetEvent {
  id            String               @id @default(uuid())
  labId         String
  lab           Lab                  @relation(fields: [labId], references: [id])
  resultSheetId String
  resultSheet   ResultSheet          @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)
  type          ResultSheetEventType
  userId        String?
  user          User?                @relation(fields: [userId], references: [id])
  createdAt     DateTime             @default(now())

  @@index([labId])
  @@index([resultSheetId])
  @@index([resultSheetId, createdAt])
}

model ResultEntry {
  id            String       @id @default(uuid())
  labId         String
  lab           Lab          @relation(fields: [labId], references: [id])
  resultSheetId String
  resultSheet   ResultSheet  @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)
  specimenId    String?
  specimen      Specimen?    @relation(fields: [specimenId], references: [id])
  resultLines   ResultLine[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([labId])
  @@index([resultSheetId])
}

model ResultLine {
  id              String      @id @default(uuid())
  labId           String
  lab             Lab         @relation(fields: [labId], references: [id])
  resultEntryId   String
  resultEntry     ResultEntry @relation(fields: [resultEntryId], references: [id], onDelete: Cascade)
  abbreviation    String?
  result          String?
  findings        String?
  abnormalFinding Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([labId])
  @@index([resultEntryId])
}

// A released pathology report. Only created from an authorized result sheet.
model Report {
  id                  String      @id @default(uuid())
  labId               String
  lab                 Lab         @relation(fields: [labId], references: [id])
  resultSheetId       String
  resultSheet         ResultSheet @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)
  authorizerReference String?
  content             String?
  signature           String?
  digitalSignature    String?
  medicalEntry        String?
  writtenById         String?
  writtenBy           User?       @relation("ReportAuthor", fields: [writtenById], references: [id])
  releasedAt          DateTime    @default(now())
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([labId])
  @@index([resultSheetId])
}

// ---- F4: AI-assisted reporting ----
// AI is strictly ASSISTIVE. Nothing here authorizes or bypasses the auth gate;
// every AI call is best-effort and degrades gracefully. See docs/F4_AI_REPORTING_DESIGN.md.

// Per-lab AI configuration. Off by default (opt-in, compliance-gated).
model LabAiSettings {
  id              String          @id @default(uuid())
  labId           String          @unique
  lab             Lab             @relation(fields: [labId], references: [id])
  enabled         Boolean         @default(false)
  houseStyle      String? // lab's narrative template / style guidance
  redactionPolicy RedactionPolicy @default(Strict)
  model           String? // optional model override; else the server default
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

enum RedactionPolicy {
  Strict // clinical data only — NO demographics
  Standard // adds de-identified sex + age BAND (never DOB / exact age)
}

// Provenance record for every AI generation, kept forever. Never overwritten:
// a result sheet accumulates drafts over time.
model AiDraft {
  id              String          @id @default(uuid())
  labId           String
  lab             Lab             @relation(fields: [labId], references: [id])
  resultSheetId   String
  resultSheet     ResultSheet     @relation(fields: [resultSheetId], references: [id], onDelete: Cascade)
  kind            AiDraftKind
  status          AiDraftStatus   @default(Generated)
  // What the model produced: narrative text, or a JSON string for codes/consistency.
  output          String
  // Provenance
  model           String // exact model id used
  promptVersion   String // e.g. "narrative-v1" — bumped when the prompt changes
  redactionPolicy RedactionPolicy // policy snapshot applied at generation
  inputDigest     String // sha256 of the exact redacted payload (proves input class w/o storing PHI)
  createdById     String?
  createdBy       User?           @relation("AiDraftCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())
  // Human review (Narrative kind): the edited final text + diff at acceptance.
  finalText       String?
  editedDiff      Json? // structured diff: AI output -> finalText
  acceptedAt      DateTime?
  acceptedById    String?
  acceptedBy      User?           @relation("AiDraftAcceptedBy", fields: [acceptedById], references: [id])

  @@index([labId])
  @@index([resultSheetId])
}

enum AiDraftKind {
  Narrative
  CodeSuggestion
  ConsistencyCheck
}

enum AiDraftStatus {
  Generated
  Accepted
  Rejected
  Superseded
}

// ---- Phase 4: Revenue ----
// All monetary amounts are integers in minor units (cents). Currency is the
// lab's (Lab.currency). Never store money as a float.

// Price-list entry a bill draws from.
model Service {
  id          String     @id @default(uuid())
  labId       String
  lab         Lab        @relation(fields: [labId], references: [id])
  name        String
  code        String
  description String?
  price       Int // minor units (cents)
  active      Boolean    @default(true)
  billLines   BillLine[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Legacy enforced a unique service name; per-lab uniqueness is the tenant form.
  @@unique([labId, name])
  @@index([labId])
}

// Tax rate stored as basis points (1% = 100 bps) — integer, no floats.
model Tax {
  id              String    @id @default(uuid())
  labId           String
  lab             Lab       @relation(fields: [labId], references: [id])
  name            String
  code            String?
  rateBasisPoints Int // basis points; 1% = 100
  isDefault       Boolean   @default(false)
  billTaxes       BillTax[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Legacy enforced a unique tax name; per-lab uniqueness is the tenant form.
  @@unique([labId, name])
  @@index([labId])
}

// A bill for one lab case (Record), billed to a Client. Totals are computed at
// creation from snapshotted line/tax amounts and never recomputed from the
// live catalog.
model Bill {
  id          String     @id @default(uuid())
  labId       String
  lab         Lab        @relation(fields: [labId], references: [id])
  recordId    String
  record      Record     @relation(fields: [recordId], references: [id])
  clientId    String?
  client      Client?    @relation(fields: [clientId], references: [id])
  referenceNo String
  status      BillStatus @default(Draft)
  subtotal    Int        @default(0) // minor units (cents) — sum of line amounts
  taxTotal    Int        @default(0) // minor units (cents) — sum of applied tax amounts
  total       Int        @default(0) // minor units (cents) — subtotal + taxTotal
  amountPaid  Int        @default(0) // minor units (cents) — Σ of payments, recomputed on each payment
  dueDate     DateTime?
  viewed      Boolean    @default(false)
  lines       BillLine[]
  taxes       BillTax[]
  payments    Payment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([labId])
  @@index([recordId])
  @@index([clientId])
  @@index([status])
}

// A bill line; price + service identity are snapshotted at bill time so later
// catalog edits don't rewrite historical bills.
model BillLine {
  id          String   @id @default(uuid())
  labId       String
  lab         Lab      @relation(fields: [labId], references: [id])
  billId      String
  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  serviceName String // snapshot of Service.name at bill time
  serviceCode String? // snapshot of Service.code at bill time
  description String?
  quantity    Int
  unitPrice   Int // minor units (cents) — snapshot of Service.price at bill time
  amount      Int // minor units (cents) — quantity * unitPrice
  createdAt   DateTime @default(now())

  @@index([labId])
  @@index([billId])
}

// A tax applied to a bill, snapshotted (name + rate) at bill time.
model BillTax {
  id              String   @id @default(uuid())
  labId           String
  lab             Lab      @relation(fields: [labId], references: [id])
  billId          String
  bill            Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  taxId           String?
  tax             Tax?     @relation(fields: [taxId], references: [id])
  name            String // snapshot of Tax.name
  rateBasisPoints Int // snapshot of Tax.rateBasisPoints
  amount          Int // minor units (cents) — round(subtotal * rate / 10000)
  createdAt       DateTime @default(now())

  @@index([labId])
  @@index([billId])
}

// A payment settling (part of) a bill. Multiple payments per bill = partial
// settlement. `verified` is an audit flag, not a settlement gate.
model Payment {
  id           String      @id @default(uuid())
  labId        String
  lab          Lab         @relation(fields: [labId], references: [id])
  billId       String
  bill         Bill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount       Int // minor units (cents)
  type         PaymentType
  referenceNo  String?
  bank         String?
  chequeNumber String?
  verified     Boolean     @default(false)
  datePaid     DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([labId])
  @@index([billId])
}

// ---- Phase 5: Client Portal (F2) ----
// External identity for referring doctors/labs. Completely separate from staff
// User: separate table, separate JWT (own secret + audience). Lab-scoped AND
// client-scoped — carries clientId, which the tenancy guard injects into every
// portal query so a portal user can only ever reach its own client's data.
model PortalUser {
  id                    String                 @id @default(uuid())
  labId                 String
  lab                   Lab                    @relation(fields: [labId], references: [id])
  clientId              String
  client                Client                 @relation(fields: [clientId], references: [id])
  // Auto-generated at invite time (legacy "Generated" username). Unique per lab.
  username              String?
  email                 String
  // Null until the invite is accepted (first password set via emailed token).
  // Staff never set an external user's password (Finding 2, option B).
  passwordHash          String?
  firstName             String
  lastName              String
  isActive              Boolean                @default(true)
  // 2FA is toggled on the client form; actual enrollment happens later in the
  // portal (the staff form never sees the secret).
  twoFactorEnabled      Boolean                @default(false)
  // The client's main login. Soft flag (a client may have more than one contact
  // login); the service keeps at most one primary per client.
  isPrimary             Boolean                @default(false)
  // F2 notification preferences.
  notifyByEmail         Boolean                @default(true)
  notifyInApp           Boolean                @default(true)
  lastLoginAt           DateTime?
  tokens                PortalAccessToken[]
  authAttempts          AuthAttempt[]
  changeRequests        ChangeRequest[]        @relation("ChangeRequestCreator")
  changeRequestMessages ChangeRequestMessage[] @relation("ChangeRequestMessagePortalAuthor")
  changeRequestEvents   ChangeRequestEvent[]   @relation("ChangeRequestEventPortalActor")
  threadParticipants    ThreadParticipant[]
  authoredMessages      Message[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([labId, email])
  @@unique([labId, username])
  @@index([labId])
  @@index([clientId])
}

// Single-use, time-limited credential token for staff-invite onboarding and
// password reset. Only the SHA-256 hash is stored; the raw token is emailed.
// No clientId column: it is consumed unauthenticated (system scope), never in a
// portal-scoped request, so Rule B never applies to it.
model PortalAccessToken {
  id           String          @id @default(uuid())
  labId        String
  lab          Lab             @relation(fields: [labId], references: [id])
  portalUserId String
  portalUser   PortalUser      @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  type         PortalTokenType
  tokenHash    String          @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime        @default(now())

  @@index([labId])
  @@index([portalUserId])
}

// A structured request a client raises against a record (or generally). Carries
// clientId so the tenancy guard auto-scopes portal access to the client's own
// requests. Status lifecycle Open -> InReview -> Actioned|Declined.
model ChangeRequest {
  id                    String                 @id @default(uuid())
  labId                 String
  lab                   Lab                    @relation(fields: [labId], references: [id])
  clientId              String
  client                Client                 @relation(fields: [clientId], references: [id])
  recordId              String?
  record                Record?                @relation(fields: [recordId], references: [id])
  type                  ChangeRequestType
  subject               String
  status                ChangeRequestStatus    @default(Open)
  createdByPortalUserId String
  createdByPortalUser   PortalUser             @relation("ChangeRequestCreator", fields: [createdByPortalUserId], references: [id])
  assignedToUserId      String?
  assignedToUser        User?                  @relation("ChangeRequestAssignee", fields: [assignedToUserId], references: [id])
  messages              ChangeRequestMessage[]
  events                ChangeRequestEvent[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([labId])
  @@index([clientId])
  @@index([recordId])
  @@index([status])
}

// Append-only message thread between a portal user and lab staff. Exactly one of
// authorPortalUserId / authorUserId is set per row.
model ChangeRequestMessage {
  id                 String        @id @default(uuid())
  labId              String
  lab                Lab           @relation(fields: [labId], references: [id])
  clientId           String
  client             Client        @relation(fields: [clientId], references: [id])
  changeRequestId    String
  changeRequest      ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  body               String
  authorPortalUserId String?
  authorPortalUser   PortalUser?   @relation("ChangeRequestMessagePortalAuthor", fields: [authorPortalUserId], references: [id])
  authorUserId       String?
  authorUser         User?         @relation("ChangeRequestMessageStaffAuthor", fields: [authorUserId], references: [id])
  createdAt          DateTime      @default(now())

  @@index([labId])
  @@index([clientId])
  @@index([changeRequestId])
  @@index([changeRequestId, createdAt])
}

// Append-only audit of change-request status transitions (mirrors
// ResultSheetEvent). Exactly one of byPortalUserId / byUserId is set per row.
model ChangeRequestEvent {
  id              String              @id @default(uuid())
  labId           String
  lab             Lab                 @relation(fields: [labId], references: [id])
  clientId        String
  client          Client              @relation(fields: [clientId], references: [id])
  changeRequestId String
  changeRequest   ChangeRequest       @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  status          ChangeRequestStatus
  note            String?
  byPortalUserId  String?
  byPortalUser    PortalUser?         @relation("ChangeRequestEventPortalActor", fields: [byPortalUserId], references: [id])
  byUserId        String?
  byUser          User?               @relation("ChangeRequestEventStaffActor", fields: [byUserId], references: [id])
  createdAt       DateTime            @default(now())

  @@index([labId])
  @@index([clientId])
  @@index([changeRequestId])
  @@index([changeRequestId, createdAt])
}

// ---- Patient form rebuild (legacy parity) ----

// A patient can have one or more addresses ("Add Address" on the form).
model PatientAddress {
  id         String   @id @default(uuid())
  labId      String
  lab        Lab      @relation(fields: [labId], references: [id])
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  // Optional label (e.g. Home, Work) when the source distinguishes addresses.
  label      String?
  line1      String
  line2      String?
  city       String?
  region     String?
  postalCode String?
  country    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([labId])
  @@index([patientId])
}

// A client can have one or more addresses ("Add Address" on the client form).
model ClientAddress {
  id         String   @id @default(uuid())
  labId      String
  lab        Lab      @relation(fields: [labId], references: [id])
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  line2      String?
  city       String?
  region     String?
  postalCode String?
  country    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([labId])
  @@index([clientId])
}

// Per-lab monotonic counters for human-facing identifiers (currently the
// patient registration number). Allocation is atomic via an incrementing update
// that returns the new value; the seed is set during data migration to
// max(numeric imported registrationNo) so generated numbers never collide with
// imported ones (see DATA_MIGRATION_PLAN.md).
model LabSequence {
  id        String   @id @default(uuid())
  labId     String
  lab       Lab      @relation(fields: [labId], references: [id])
  name      String // e.g. "patientRegNo"
  value     BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@unique([labId, name])
  @@index([labId])
}

// ---- Record clinical features (two forms, chosen up front) ----
// A record is EITHER a Gynecology case OR a Non-Gynecology case (Record.formType
// discriminator). Each form's clinical fields live in its own typed 1:1 model so
// invalid states are unrepresentable (no pregnancy data on a urine sample).

model GynClinicalFeatures {
  id                         String    @id @default(uuid())
  labId                      String
  lab                        Lab       @relation(fields: [labId], references: [id])
  recordId                   String    @unique
  record                     Record    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  routineCheck               Boolean   @default(false)
  previousCytology           Boolean   @default(false)
  lmp                        DateTime? // last menstrual period
  clinicalAppearanceOfCervix String?
  nowPregnant                Boolean   @default(false)
  pregnancies                Int?
  leucorrhea                 String?
  menopause                  Boolean   @default(false)
  dateOfMenopause            DateTime?
  lengthOfCycle              String?
  pelvicAbnormalities        String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([labId])
}

model NonGynClinicalFeatures {
  id                String   @id @default(uuid())
  labId             String
  lab               Lab      @relation(fields: [labId], references: [id])
  recordId          String   @unique
  record            Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  sampleDescription String?
  natureAndSource   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([labId])
}

// General file attached to a record ("Attach File" row action). STUB — the
// actual upload/serving is deferred to Phase 6 file storage.
model RecordAttachment {
  id         String   @id @default(uuid())
  labId      String
  lab        Lab      @relation(fields: [labId], references: [id])
  recordId   String
  record     Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  storageUrl String
  filename   String?
  kind       String?
  createdAt  DateTime @default(now())

  @@index([labId])
  @@index([recordId])
}

// Slide (Gyn) / Vial (NonGyn) specimen images. STUB — actual upload/serving is
// deferred to Phase 6 file storage; the label is derived from Record.formType.
model SpecimenImage {
  id         String   @id @default(uuid())
  labId      String
  lab        Lab      @relation(fields: [labId], references: [id])
  specimenId String
  specimen   Specimen @relation(fields: [specimenId], references: [id], onDelete: Cascade)
  storageUrl String
  caption    String?
  createdAt  DateTime @default(now())

  @@index([labId])
  @@index([specimenId])
}

// ─── Messaging (Phase 6) ─────────────────────────────────────────────────────
// Threads carry messages between staff (INTERNAL) or staff↔client (CLIENT).
// Lab-scoped via labId; participants gate read access.

model Thread {
  id               String              @id @default(cuid())
  labId            String
  type             ThreadType          @default(INTERNAL)
  subject          String?
  clientId         String?
  client           Client?             @relation(fields: [clientId], references: [id])
  participants     ThreadParticipant[]
  messages         Message[]
  typingIndicators TypingIndicator[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  lab              Lab                 @relation(fields: [labId], references: [id])

  @@index([labId])
  @@index([clientId])
  @@index([labId, updatedAt])
}

// Ephemeral "user is typing" signal, one row per (thread, user), refreshed on
// each keystroke burst and expiring ~5s later. Rows are upserted and read with
// an expiry filter, so stale indicators simply age out.
model TypingIndicator {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime // typing indicators expire after 5 seconds

  @@unique([threadId, userId])
  @@index([threadId])
}

model ThreadParticipant {
  id           String      @id @default(cuid())
  threadId     String
  thread       Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  portalUserId String?
  portalUser   PortalUser? @relation(fields: [portalUserId], references: [id])
  joinedAt     DateTime    @default(now())

  @@index([threadId])
  @@index([userId])
  @@index([portalUserId])
}

model Message {
  id                 String      @id @default(cuid())
  threadId           String
  thread             Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  body               String
  authorUserId       String?
  authorUser         User?       @relation(fields: [authorUserId], references: [id])
  authorPortalUserId String?
  authorPortalUser   PortalUser? @relation(fields: [authorPortalUserId], references: [id])
  readAt             DateTime? // set when the recipient reads the message
  deliveredAt        DateTime? // set when the message is fetched by the recipient
  createdAt          DateTime    @default(now())

  @@index([threadId])
  @@index([threadId, createdAt])
}

enum ThreadType {
  INTERNAL
  CLIENT
}

// ─── Appointments (Phase 6) ──────────────────────────────────────────────────
// Scheduled patient/client visits: specimen collections, callbacks, consults and
// follow-ups. Lab-scoped via labId; optionally linked to a patient/client and an
// assigned staff member.

model Appointment {
  id             String            @id @default(cuid())
  labId          String
  lab            Lab               @relation(fields: [labId], references: [id])
  patientId      String?
  patient        Patient?          @relation(fields: [patientId], references: [id])
  clientId       String?
  client         Client?           @relation(fields: [clientId], references: [id])
  title          String            @default("")
  type           AppointmentType   @default(COLLECTION)
  status         AppointmentStatus @default(SCHEDULED)
  scheduledAt    DateTime
  duration       Int               @default(30)
  location       String?
  doctorName     String?
  notes          String?

  assignedUserId String?
  assignedUser   User?             @relation("AppointmentAssignee", fields: [assignedUserId], references: [id])

  // Link back to the recall that triggered this appointment.
  recallRecordId String?
  recallRecord   RecallRecord?     @relation(fields: [recallRecordId], references: [id])

  // Lifecycle outcomes.
  checkedInAt        DateTime?
  completedAt        DateTime?
  resultRecordId     String?
  noShowAt           DateTime?
  cancellationReason String?
  reminderSentAt     DateTime?

  createdById String?
  createdBy   User?    @relation("AppointmentCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([labId])
  @@index([labId, scheduledAt])
  @@index([patientId])
  @@index([clientId])
}

enum AppointmentType {
  COLLECTION
  CALLBACK
  CONSULTATION
  FOLLOWUP
  // Spec values (the module standardized on these; legacy values kept for
  // pre-existing rows).
  SpecimenCollection
  FollowUp
  RecallVisit
  Consultation
  Other
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELLED
  // Spec values.
  Scheduled
  Confirmed
  CheckedIn
  Completed
  NoShow
  Cancelled
  Rescheduled
}

// ─── System Health (internal) ────────────────────────────────────────────────
// Audit trail of automated-maintenance runs (superuser dashboard + nightly cron).
// Global (not lab-scoped): maintenance operates across every lab.

model MaintenanceLog {
  id       String   @id @default(cuid())
  ranAt    DateTime @default(now())
  ranBy    String? // userId, or 'system' for the cron run
  duration Int // ms
  results  Json // { flagged, archived, missedClosed, ... }
  notes    String?

  @@index([ranAt])
}

// ─── Form Setup (Path A: UI config layer over hardcoded clinical features) ────
// Configures labels/ordering/print-grouping of the existing GynClinicalFeatures
// + NonGynClinicalFeatures columns. Never alters those columns — fieldKey maps
// to an existing Prisma column name.

model FormConfig {
  id          String              @id @default(cuid())
  labId       String
  lab         Lab                 @relation(fields: [labId], references: [id])
  formType    RequisitionFormType
  fields      FormFieldConfig[]
  printGroups FormPrintGroup[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([labId, formType])
  @@index([labId])
}

model FormFieldConfig {
  id               String          @id @default(cuid())
  labId            String
  formConfigId     String
  formConfig       FormConfig      @relation(fields: [formConfigId], references: [id], onDelete: Cascade)
  fieldKey         String
  label            String
  fieldType        FormFieldType   @default(TEXT)
  showWhenPrinting Boolean         @default(true)
  printGroupId     String?
  printGroup       FormPrintGroup? @relation(fields: [printGroupId], references: [id])
  sortOrder        Int             @default(0)
  enabled          Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([formConfigId, fieldKey])
  @@index([labId])
}

model FormPrintGroup {
  id           String            @id @default(cuid())
  labId        String
  formConfigId String
  formConfig   FormConfig        @relation(fields: [formConfigId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int               @default(0)
  fields       FormFieldConfig[]
  createdAt    DateTime          @default(now())

  @@index([labId])
}

enum FormFieldType {
  TEXT
  CHECKBOX
}

// ─── Notifications (Phase 6) ──────────────────────────────────────────────────
// Per-user, lab-scoped in-app notifications. Created internally by services when
// lifecycle events occur (never via a public create endpoint); read/marked-read
// by the owning user.
model Notification {
  id         String           @id @default(cuid())
  labId      String
  lab        Lab              @relation(fields: [labId], references: [id])
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  type       NotificationType
  title      String
  body       String
  read       Boolean          @default(false)
  readAt     DateTime?
  link       String? // e.g. /records/xxx or /authorizer
  entityId   String? // recordId, changeRequestId etc
  entityType String? // 'record', 'changerequest', 'appointment'
  createdAt  DateTime         @default(now())

  @@index([labId, userId])
  @@index([labId, userId, read])
}

enum NotificationType {
  RECORD_SUBMITTED
  RECORD_RESULTED
  RECORD_APPROVED
  RECORD_FAILED
  AUTHORIZATION_NEEDED
  CHANGE_REQUEST_RECEIVED
  CHANGE_REQUEST_REPLIED
  PAYMENT_RECEIVED
  APPOINTMENT_REMINDER
  SYSTEM_ALERT
}

// ─── Phase 7: HR / Payroll ───────────────────────────────────────────────────

enum EmploymentType {
  FullTime
  PartTime
  Contract
}

enum PayAdviceStatus {
  Draft
  Issued
  Paid
}

enum PayrollRunStatus {
  Draft
  Processing
  Completed
}

// A department/team within the lab. managerId links to a staff User (optional).
model Department {
  id          String     @id @default(uuid())
  labId       String
  lab         Lab        @relation(fields: [labId], references: [id])
  name        String
  description String?
  managerId   String?
  manager     User?      @relation("DepartmentManager", fields: [managerId], references: [id])
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([labId])
  @@index([managerId])
}

// HR record for a staff member. One Employee per User (1:1). salary is the
// MONTHLY basic in minor units (cents).
model Employee {
  id                    String         @id @default(uuid())
  labId                 String
  lab                   Lab            @relation(fields: [labId], references: [id])
  userId                String         @unique
  user                  User           @relation("EmployeeUser", fields: [userId], references: [id])
  departmentId          String?
  department            Department?    @relation(fields: [departmentId], references: [id])
  employeeNo            String
  jobTitle              String
  employmentType        EmploymentType @default(FullTime)
  startDate             DateTime
  endDate               DateTime?
  salary                Int            @default(0) // monthly basic, minor units (cents)
  bankName              String?
  bankAccount           String?
  bankBranch            String?
  trn                   String? // Tax Registration Number
  nis                   String? // National Insurance Scheme #
  nht                   String? // National Housing Trust #
  emergencyContactName  String?
  emergencyContactPhone String?
  address               String?
  isActive              Boolean        @default(true)
  isFixedSalary         Boolean        @default(true) // false = hourly (hours entered per run)
  payAdvices            PayAdvice[]
  clockEvents           ClockEvent[]
  timesheets            Timesheet[]
  shiftAssignments      ShiftAssignment[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@unique([labId, employeeNo])
  @@index([labId])
  @@index([departmentId])
}

// A payroll batch for one period (YYYY-MM). Processing generates one PayAdvice
// per active employee and rolls up the totals.
model PayrollRun {
  id              String           @id @default(uuid())
  labId           String
  lab             Lab              @relation(fields: [labId], references: [id])
  period          String // YYYY-MM
  status          PayrollRunStatus @default(Draft)
  totalGross      Int              @default(0)
  totalDeductions Int              @default(0)
  totalNet        Int              @default(0)
  employeeCount   Int              @default(0)
  payrollDate     DateTime?
  runNumber       Int              @default(0) // sequential per lab, assigned at process time
  integrityHash   String? // SHA-256 over the run's canonical content (tamper-evidence)
  processedAt     DateTime?
  processedById   String?
  processedBy     User?            @relation("PayrollProcessor", fields: [processedById], references: [id])
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?            @relation("PayrollApprover", fields: [approvedById], references: [id])
  approvalNotes   String?
  payAdvices      PayAdvice[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([labId, period])
  @@index([labId])
}

// A single employee's pay slip for a period. All money fields are minor units.
model PayAdvice {
  id              String          @id @default(uuid())
  labId           String
  lab             Lab             @relation(fields: [labId], references: [id])
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollRunId    String?
  payrollRun      PayrollRun?     @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  period          String // YYYY-MM
  basicPay        Int             @default(0)
  hoursWorked     Int             @default(0)
  overtime        Int             @default(0)
  allowances      Int             @default(0)
  commission      Int             @default(0)
  bonus           Int             @default(0)
  grossPay        Int             @default(0)
  nis             Int             @default(0)
  nht             Int             @default(0)
  edTax           Int             @default(0)
  paye            Int             @default(0)
  pension         Int             @default(0)
  reimbursement   Int             @default(0)
  otherDeductions Int             @default(0)
  netPay          Int             @default(0)
  // Year-to-date running totals (through this advice's period).
  ytdGross        Int             @default(0)
  ytdNis          Int             @default(0)
  ytdNht          Int             @default(0)
  ytdEdTax        Int             @default(0)
  ytdPaye         Int             @default(0)
  ytdPension      Int             @default(0)
  ytdLoanBalance  Int             @default(0)
  status          PayAdviceStatus @default(Draft)
  issuedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([labId])
  @@index([employeeId])
  @@index([payrollRunId])
}

// ─── Result Templates ────────────────────────────────────────────────────────
// Reusable cytology report templates (Bethesda categories) that pre-populate
// result-sheet narrative/findings during entry.

enum TemplateCategory {
  Cervical
  Endometrial
  Respiratory
  Urinary
  Breast
  Thyroid
  Other
}

model ResultTemplate {
  id               String           @id @default(cuid())
  labId            String
  lab              Lab              @relation(fields: [labId], references: [id])
  name             String
  category         TemplateCategory @default(Cervical)
  shortCode        String?
  description      String?
  isActive         Boolean          @default(true)
  usageCount       Int              @default(0)
  specimenAdequacy String?
  generalCategory  String?
  interpretation   String?
  recommendation   String?
  additionalNotes  String?
  findings         Json? // [{ key, value }]
  createdById      String?
  createdBy        User?            @relation("ResultTemplateCreator", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([labId, name])
  @@unique([labId, shortCode])
  @@index([labId])
  @@index([category])
}

// ─── Bethesda System (TBS 2014) — structured cervical cytology classification ─

enum SpecimenAdequacy {
  Satisfactory
  Unsatisfactory
}

enum GeneralCategory {
  NILM // Negative for Intraepithelial Lesion or Malignancy
  EpithelialAbnormality
  OtherMalignancy
}

enum SquamousCategory {
  ASC // Atypical Squamous Cells
  LSIL
  HSIL
  SCC // Squamous Cell Carcinoma
}

enum ASCSubtype {
  ASCUS // of undetermined significance
  ASCH // cannot exclude HSIL
}

// Inferred (spec truncated) from TBS 2014 glandular categories.
enum GlandularCategory {
  AGC // Atypical Glandular Cells
  AGC_FavorNeoplastic
  AIS // Endocervical Adenocarcinoma in situ
  Adenocarcinoma
  Other
}

// Inferred (spec truncated): ancillary HPV testing result.
enum HPVResult {
  Positive
  Negative
  NotPerformed
}

// Inferred (spec truncated): structured management recommendations.
enum BethesdaRecommendation {
  RoutineScreening
  RepeatIn1Year
  HPVReflexTesting
  Colposcopy
  UrgentColposcopy
  EndocervicalSampling
  RepeatSpecimen
  ClinicalCorrelation
}

model BethesdaResult {
  id       String @id @default(cuid())
  labId    String
  lab      Lab    @relation(fields: [labId], references: [id])
  recordId String @unique
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  specimenAdequacy     SpecimenAdequacy
  unsatisfactoryReason String?

  generalCategory GeneralCategory?

  organisms          String[]
  otherNonNeoplastic String[]

  squamousCategory SquamousCategory?
  ascSubtype       ASCSubtype?

  glandularCategory GlandularCategory?
  glandularSubtype  String?

  otherMalignancy String?

  hpvResult   HPVResult?
  hpvGenotype String?

  recommendation      BethesdaRecommendation?
  recommendationNotes String?

  generatedNarrative String?

  reportedById String?
  reportedBy   User?    @relation("BethesdaReporter", fields: [reportedById], references: [id])
  reportedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([labId])
}

// ─── TAT (Turnaround Time) monitoring & breach alerts ────────────────────────

enum TATAlertLevel {
  Approaching
  Breached
}

enum TATAlertStatus {
  Open
  Acknowledged
  Resolved
}

// Per-lab TAT thresholds. specimenType null = default (applies to all types).
// urgentThresholdHours applies when the record is urgent or its Bethesda
// classification is high-grade (HSIL/SCC/AGUS/malignant).
model TATConfig {
  id                   String     @id @default(cuid())
  labId                String
  lab                  Lab        @relation(fields: [labId], references: [id])
  name                 String
  specimenType         String?
  thresholdHours       Int
  warningHours         Int        @default(24)
  urgentThresholdHours Int?
  isActive             Boolean    @default(true)
  alerts               TATAlert[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([labId])
}

// A detected TAT event for a record. One row per (record, level); auto-resolved
// when the record is authorized.
model TATAlert {
  id               String         @id @default(cuid())
  labId            String
  lab              Lab            @relation(fields: [labId], references: [id])
  recordId         String
  record           Record         @relation(fields: [recordId], references: [id], onDelete: Cascade)
  level            TATAlertLevel
  status           TATAlertStatus @default(Open)
  thresholdHours   Int
  elapsedHours     Int
  dueAt            DateTime
  configId         String?
  config           TATConfig?     @relation(fields: [configId], references: [id])
  notifiedAt       DateTime?
  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?          @relation("TATAcknowledger", fields: [acknowledgedById], references: [id])
  resolvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([recordId, level])
  @@index([labId])
  @@index([labId, status])
}

// ─── Feature Management — superuser-controlled per-lab feature flags ──────────

// Feature keys, grouped by tier. Tier 1 (Standard/core) features are always on
// and NOT stored here (enforced in code). Only tier 2-5 keys are persisted.
enum FeatureKey {
  // Tier 2 — Clinical
  TAT_ALERTS
  PRIOR_HISTORY
  BETHESDA_SYSTEM
  ABNORMAL_ESCALATION
  CASE_ASSIGNMENT
  QC_MODULE

  // Tier 3 — Operational
  VOICE_TO_TEXT
  RESULT_TEMPLATES
  BATCH_AUTHORIZATION
  REQUISITION_TRACKING
  SLIDE_LABEL_PRINTING

  // Tier 4 — Compliance
  BETHESDA_ANALYTICS
  CORRELATION_TRACKING
  PROFICIENCY_TESTING
  REAGENT_TRACKING
  PATIENT_RECALL
  REPORT_CENTER
  APPOINTMENTS

  // Tier 5 — Enterprise
  WSI_VIEWER
  AI_SCREENING
  TELECONSULTATION
  LOINC_SNOMED
  HL7_FHIR

  // Tier 6 — Workforce
  WORKFORCE_MANAGEMENT
}

// One row per (lab, feature). Toggle history is not retained — each toggle
// overwrites isEnabled/enabledAt/enabledBy with the latest state and actor.
model LabFeature {
  id          String     @id @default(cuid())
  labId       String
  lab         Lab        @relation(fields: [labId], references: [id])
  featureKey  FeatureKey
  tier        Int // 1-5
  isEnabled   Boolean    @default(false)
  enabledAt   DateTime?
  enabledById String?
  enabledBy   User?      @relation("LabFeatureToggler", fields: [enabledById], references: [id])
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([labId, featureKey])
  @@index([labId])
}

// ─── Abnormal Result Escalation (Tier 2 Clinical) ────────────────────────────

enum EscalationSeverity {
  Abnormal // LSIL, ASCUS, AGC — notify physician, flag for review
  HighGrade // HSIL, ASC-H, AIS, AGC-favor-neoplastic — urgent review required
  Malignant // SCC, Adenocarcinoma, other malignancy — immediate escalation
}

enum EscalationTrigger {
  BethesdaClassification // triggered by a Bethesda result
  NarrativeKeyword // triggered by keyword match on the narrative
  ManualFlag // manually escalated by staff
}

enum EscalationStatus {
  Pending // created, not yet reviewed
  Acknowledged
  UnderReview
  Resolved
  Dismissed // false positive, dismissed by senior pathologist
}

// An automatically- or manually-raised escalation for an abnormal/malignant
// result. Created by EscalationService.evaluateRecord regardless of the
// ABNORMAL_ESCALATION UI feature flag (clinical safety); only the management UI
// is gated. At most one OPEN escalation (Pending/Acknowledged/UnderReview) is
// kept per record — the trigger is idempotent.
model EscalationRecord {
  id       String             @id @default(cuid())
  labId    String
  lab      Lab                @relation(fields: [labId], references: [id])
  recordId String
  record   Record             @relation(fields: [recordId], references: [id], onDelete: Cascade)
  severity EscalationSeverity
  trigger  EscalationTrigger
  status   EscalationStatus   @default(Pending)

  // Who needs to act (senior pathologist).
  assignedToId String?
  assignedTo   User?   @relation("EscalationAssignee", fields: [assignedToId], references: [id])

  // Referring physician notification.
  physicianNotifiedAt  DateTime?
  physicianNotifiedVia String? // "portal" | "in-app"

  // Review tracking.
  reviewedById String?
  reviewedBy   User?     @relation("EscalationReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNotes  String?

  // Auto-resolved when the record is re-authorized NILM or manually closed.
  resolvedAt     DateTime?
  resolvedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId, status])
  @@index([recordId])
}

// Per-pathologist daily/weekly throughput targets (Case Assignment & Workload
// Balancing, Tier 2). One row per (lab, user).
model WorkloadTarget {
  id           String  @id @default(cuid())
  labId        String
  lab          Lab     @relation(fields: [labId], references: [id])
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id])
  dailyTarget  Int     @default(20)
  weeklyTarget Int     @default(100)
  isActive     Boolean @default(true)

  @@unique([labId, userId])
  @@index([labId])
}

// ─── Quality Control (Tier 2 Clinical) ───────────────────────────────────────

enum QCCheckType {
  SlidePreparation // slide quality check
  StainingQuality // stain consistency check
  FixationAdequacy // fixation quality
  CellularityCheck // adequate cell count
  EquipmentCalibration // equipment performance
  ReagentCheck // reagent lot quality
  ExternalQC // external quality control slide
}

enum QCResult {
  Pass
  Fail
  Marginal // borderline — flag for review but don't fail
}

enum EquipmentType {
  Stainer
  Centrifuge
  Microscope
  Processor
  Scanner
  Other
}

enum AlertStatus {
  Open
  Acknowledged
  Resolved
}

// A single quality-control check — standalone or linked to a record.
model QCCheck {
  id               String      @id @default(cuid())
  labId            String
  lab              Lab         @relation(fields: [labId], references: [id])
  recordId         String?
  record           Record?     @relation(fields: [recordId], references: [id])
  checkType        QCCheckType
  result           QCResult
  performedById    String
  performedBy      User        @relation(fields: [performedById], references: [id])
  equipmentId      String?
  equipment        Equipment?  @relation(fields: [equipmentId], references: [id])
  batchId          String? // staining batch reference
  notes            String?
  failureReason    String? // required when result = Fail
  correctiveAction String? // what was done to fix it
  performedAt      DateTime    @default(now())
  createdAt        DateTime    @default(now())

  failureAlert QCFailureAlert?

  @@index([labId, performedAt])
  @@index([recordId])
}

// Lab instruments that QC checks are performed against.
model Equipment {
  id              String        @id @default(cuid())
  labId           String
  lab             Lab           @relation(fields: [labId], references: [id])
  name            String // e.g. "Stainer Unit 1", "Centrifuge A"
  type            EquipmentType
  serialNumber    String?
  lastServiceDate DateTime?
  isActive        Boolean       @default(true)
  qcChecks        QCCheck[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([labId, name])
}

// Raised automatically when a QC check fails; tracked to resolution.
model QCFailureAlert {
  id           String      @id @default(cuid())
  labId        String
  lab          Lab         @relation(fields: [labId], references: [id])
  qcCheckId    String      @unique
  qcCheck      QCCheck     @relation(fields: [qcCheckId], references: [id], onDelete: Cascade)
  status       AlertStatus @default(Open)
  assignedToId String?
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime    @default(now())

  @@index([labId, status])
}

// ─── Requisition Tracking (Tier 3 Operational) — physical form chain of custody ─

enum TrackingStage {
  Pending // not yet received
  FormReceived // paper form received at front desk
  BenchReceived // specimen received at bench
  Verified // form verified against specimen
  Processing // in processing
  Filed // form filed, complete
  Rejected // rejected (wrong patient, damaged, etc.)
}

enum FormCondition {
  Good
  Damaged
  Incomplete
  Illegible
}

// One-to-one custody record for a requisition's paper form. Auto-created (stage
// Pending) when a requisition is created.
model RequisitionTracking {
  id            String      @id @default(cuid())
  labId         String
  lab           Lab         @relation(fields: [labId], references: [id])
  requisitionId String      @unique
  requisition   Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  // Physical form receipt.
  formReceivedAt     DateTime?
  formReceivedById   String?
  formReceivedBy     User?         @relation("FormReceiver", fields: [formReceivedById], references: [id])
  formCondition      FormCondition @default(Good)
  formConditionNotes String?

  // Specimen bench receipt.
  benchReceivedAt   DateTime?
  benchReceivedById String?
  benchReceivedBy   User?     @relation("BenchReceiver", fields: [benchReceivedById], references: [id])

  // Verification.
  verifiedAt        DateTime?
  verifiedById      String?
  verifiedBy        User?     @relation("FormVerifier", fields: [verifiedById], references: [id])
  verificationNotes String?

  // Filing.
  filedAt      DateTime?
  filedById    String?
  filedBy      User?     @relation("FormFiler", fields: [filedById], references: [id])
  fileLocation String? // e.g. "Cabinet A, Drawer 3"

  // Barcode / QR.
  barcodeScanned Boolean @default(false)
  barcodeValue   String?

  currentStage TrackingStage @default(Pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId, currentStage])
}

// Append-only audit of every stage transition.
model TrackingEvent {
  id             String        @id @default(cuid())
  labId          String
  lab            Lab           @relation(fields: [labId], references: [id])
  requisitionId  String
  requisition    Requisition   @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  stage          TrackingStage
  performedById  String
  performedBy    User          @relation("TrackingEventActor", fields: [performedById], references: [id])
  notes          String?
  scannedBarcode String?
  performedAt    DateTime      @default(now())

  @@index([requisitionId])
  @@index([labId, performedAt])
}

// ─── Cyto-Histo Correlation Tracking (Tier 4 Compliance) ─────────────────────

enum HistologySource {
  Internal // histology also done at this lab
  External // done at another lab
  Unknown
}

enum CorrelationResult {
  Concordant // cytology and histology agree
  MinorDiscordant // slight difference, clinically acceptable
  MajorDiscordant // significant difference, requires review
  Unresolved // histology not yet received
}

// Links a cytology case to its histology follow-up and tracks concordance —
// a CAP/ISO accreditation requirement.
model CorrelationCase {
  id        String  @id @default(cuid())
  labId     String
  lab       Lab     @relation(fields: [labId], references: [id])
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  // Cytology side.
  cytologyRecordId   String
  cytologyRecord     Record  @relation("CytologyRecord", fields: [cytologyRecordId], references: [id])
  cytologyDate       DateTime
  cytologyDiagnosis  String
  cytologyBethesdaId String?

  // Histology side.
  histologyRecordId  String?
  histologyDate      DateTime?
  histologyDiagnosis String?
  histologySource    HistologySource @default(Internal)
  externalLabName    String?

  // Correlation result.
  correlationResult CorrelationResult?
  discordanceReason String?
  reviewRequired    Boolean            @default(false)
  reviewedById      String?
  reviewedBy        User?              @relation("CorrelationReviewer", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  reviewNotes       String?

  // Clinical outcome.
  clinicalOutcome  String?
  followUpRequired Boolean @default(false)

  createdById String?
  createdBy   User?    @relation("CorrelationCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([labId, cytologyDate])
  @@index([patientId])
}

// ─── Proficiency Testing (Tier 4 Compliance) — blind-review competency ───────

enum ProfTestType {
  Internal // created by the lab
  CAP // College of American Pathologists survey
  CLIA // CLIA proficiency test
  External // other external program
}

enum ProfTestStatus {
  Draft // being set up
  Active // pathologists can respond
  Grading // responses locked, being graded
  Completed // graded and scores released
  Archived
}

enum CaseDifficulty {
  Easy
  Standard
  Difficult
  Expert
}

enum ConfidenceLevel {
  Low
  Moderate
  High
}

model ProficiencyTest {
  id           String                @id @default(cuid())
  labId        String
  lab          Lab                   @relation(fields: [labId], references: [id])
  name         String
  description  String?
  testType     ProfTestType          @default(Internal)
  status       ProfTestStatus        @default(Draft)
  startDate    DateTime
  endDate      DateTime
  passingScore Int                   @default(80) // percentage
  createdById  String?
  createdBy    User?                 @relation("ProfTestCreator", fields: [createdById], references: [id])
  cases        ProficiencyCase[]
  responses    ProficiencyResponse[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([labId, name])
}

model ProficiencyCase {
  id         String          @id @default(cuid())
  labId      String
  lab        Lab             @relation(fields: [labId], references: [id])
  testId     String
  test       ProficiencyTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  caseNumber Int // 1, 2, 3... within the test

  // De-identified case info (no patient name).
  specimenType    String
  clinicalHistory String?
  imageUrl        String?

  // Expected answer (hidden from reviewers).
  expectedDiagnosis String
  expectedBethesda  String?
  difficulty        CaseDifficulty @default(Standard)

  responses ProficiencyResponse[]
  createdAt DateTime              @default(now())
}

model ProficiencyResponse {
  id          String          @id @default(cuid())
  labId       String
  lab         Lab             @relation(fields: [labId], references: [id])
  testId      String
  test        ProficiencyTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  caseId      String
  case        ProficiencyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  responderId String
  responder   User            @relation("ProfResponder", fields: [responderId], references: [id])

  diagnosis      String
  bethesdaAnswer String?
  confidence     ConfidenceLevel @default(Moderate)
  notes          String?

  isCorrect   Boolean?
  score       Int?
  gradedAt    DateTime?
  gradedById  String?
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([caseId, responderId])
}

// ─── Reagent / Stain Lot Tracking (Tier 4 Compliance) ────────────────────────

enum ReagentStatus {
  Active // in use
  Quarantined // suspected problem — do not use
  Depleted // used up
  Expired // past expiry date
  Recalled // manufacturer recall
}

model ReagentLot {
  id            String        @id @default(cuid())
  labId         String
  lab           Lab           @relation(fields: [labId], references: [id])
  name          String // e.g. "Papanicolaou Stain"
  manufacturer  String?
  catalogNumber String?
  lotNumber     String // the actual lot/batch number
  expiryDate    DateTime?
  receivedDate  DateTime      @default(now())
  openedDate    DateTime?
  status        ReagentStatus @default(Active)
  quantity      Float?
  unit          String?
  storageTemp   String?
  notes         String?

  usages      ReagentUsage[]
  createdById String?
  createdBy   User?          @relation("ReagentCreator", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([labId, lotNumber])
  @@index([labId, status])
}

model ReagentUsage {
  id           String     @id @default(cuid())
  labId        String
  lab          Lab        @relation(fields: [labId], references: [id])
  reagentLotId String
  reagentLot   ReagentLot @relation(fields: [reagentLotId], references: [id], onDelete: Cascade)
  recordId     String?
  record       Record?    @relation(fields: [recordId], references: [id])
  batchId      String?
  usedById     String
  usedBy       User       @relation("ReagentUser", fields: [usedById], references: [id])
  quantityUsed Float?
  usedAt       DateTime   @default(now())
  notes        String?

  @@index([reagentLotId])
  @@index([recordId])
}

// ─── Patient Recall Management (Tier 4 Compliance) ───────────────────────────

enum RecallStatus {
  Pending // not yet due
  Due // past dueDate, not yet completed
  Overdue // significantly past dueDate (> 3 months)
  Completed // patient returned for follow-up
  Cancelled // cancelled by clinician
  Declined // patient declined recall
}

// A scheduled follow-up for a patient, derived from a triggering cytology result.
model RecallRecord {
  id        String  @id @default(cuid())
  labId     String
  lab       Lab     @relation(fields: [labId], references: [id])
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  // Triggering result.
  triggerRecordId  String
  triggerRecord    Record   @relation(fields: [triggerRecordId], references: [id], onDelete: Cascade)
  triggerDiagnosis String
  triggerDate      DateTime

  // Recall schedule.
  recallIntervalMonths Int
  dueDate              DateTime

  // Status tracking.
  status           RecallStatus @default(Pending)
  reminderSentAt   DateTime?
  reminderSentById String?

  // Completion.
  completedAt       DateTime?
  completedRecordId String?

  // Client notification.
  clientNotifiedAt DateTime?
  clientId         String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@unique([labId, triggerRecordId])
  @@index([labId, dueDate])
  @@index([patientId])
}

// ─── Whole Slide Imaging (Tier 5 — Enterprise) ───────────────────────────────
// A digital whole-slide image attached to a record for remote review. The image
// is referenced by URL (external tile server / object store); OpenSeadragon
// renders it. A record may carry more than one slide (e.g. different stains);
// the viewer/record-detail use the most recent.
model DigitalSlide {
  id       String @id @default(cuid())
  labId    String
  lab      Lab    @relation(fields: [labId], references: [id])
  recordId String
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  // Source image. `format` is the container/protocol (image, dzi, svs, …).
  slideUrl      String
  format        String  @default("image")
  magnification String?
  stain         String?
  scanner       String?
  fileSizeBytes Int?

  uploadedById String?
  uploadedAt   DateTime @default(now())

  annotations SlideAnnotation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId])
  @@index([recordId])
}

// A point annotation on a slide, positioned in normalized image coordinates
// (0..1) so overlays track the image across pan/zoom.
model SlideAnnotation {
  id      String       @id @default(cuid())
  labId   String
  lab     Lab          @relation(fields: [labId], references: [id])
  slideId String
  slide   DigitalSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)

  x     Float
  y     Float
  label String
  color String @default("#4F46E5")

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([labId])
  @@index([slideId])
}

// ─── AI Screening (Tier 5 — Enterprise) ──────────────────────────────────────
// Pre-screening results that flag abnormal cells before pathologist review.
// One result per record; findings/confidence are surfaced in the result-entry
// and authorization workflow, and tracked for AI-vs-pathologist agreement.
enum AIScreenStatus {
  Pending // not yet screened
  Processing // AI analysis in progress
  Completed // results available
  Failed // screening failed
  Skipped // manually skipped
}

enum AIConfidence {
  High // >= 90%
  Medium // 70-89%
  Low // < 70%
}

model AIScreeningResult {
  id       String @id @default(cuid())
  labId    String
  lab      Lab    @relation(fields: [labId], references: [id])
  recordId String @unique
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  status          AIScreenStatus @default(Pending)
  confidence      Float? // 0-100
  confidenceLevel AIConfidence?

  // Findings
  findings       Json? // array of { region, finding, confidence }
  primaryFinding String? // main AI diagnosis
  flaggedAreas   Int     @default(0)

  // Performance tracking
  agreedWithAI    Boolean?
  pathologistNote String?

  processedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("AIScreeningReviewer", fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([labId])
  @@index([labId, status])
}

// ─── Teleconsultation (Tier 5 — Enterprise) ──────────────────────────────────
// Request a second opinion from an external consultant. The case is shared
// de-identified via a single-use, unguessable access token; the consultant
// responds through a public (token-authenticated) endpoint.
enum ConsultUrgency {
  Routine // 7 days
  Priority // 48 hours
  Urgent // 24 hours
}

enum ConsultStatus {
  Pending // sent, awaiting response
  Viewed // consultant viewed the case
  InProgress // consultant is working on it
  Responded // consultant has responded
  Accepted // lab accepted the opinion
  Declined // lab declined the opinion
  Expired // token expired, no response
}

enum ConsultAgreement {
  FullAgreement
  PartialAgreement
  Disagreement
}

model ConsultRequest {
  id       String @id @default(cuid())
  labId    String
  lab      Lab    @relation(fields: [labId], references: [id])
  recordId String
  record   Record @relation(fields: [recordId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("ConsultRequester", fields: [requestedById], references: [id])

  // External consultant
  consultantName        String
  consultantEmail       String
  consultantInstitution String?

  // Case details (de-identified)
  clinicalSummary  String
  specificQuestion String
  urgency          ConsultUrgency @default(Routine)

  // Shared materials
  sharedNarrative Boolean @default(true)
  sharedBethesda  Boolean @default(true)
  sharedImages    Boolean @default(false)

  // Response
  status              ConsultStatus     @default(Pending)
  consultantResponse  String?
  consultantDiagnosis String?
  agreementLevel      ConsultAgreement?
  respondedAt         DateTime?

  // Access token for the external consultant.
  accessToken    String   @unique @default(cuid())
  tokenExpiresAt DateTime

  dueDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([labId, status])
  @@index([recordId])
}

// ─── LOINC / SNOMED Coding (Tier 5 — Enterprise) ─────────────────────────────
// Standardized medical coding on results for billing + EMR interoperability.
enum CodeSystem {
  LOINC
  SNOMED_CT
  ICD10
  CPT
}

enum CodingType {
  Procedure // what test was done
  Diagnosis // what was found
  Specimen // specimen type
  Finding // specific finding
}

// A lab's coding dictionary entry (LOINC/SNOMED/ICD10/CPT).
model MedicalCode {
  id       String     @id @default(cuid())
  labId    String
  lab      Lab        @relation(fields: [labId], references: [id])
  system   CodeSystem
  code     String
  display  String
  category String?
  isActive Boolean    @default(true)
  usageCount Int      @default(0)

  recordCodings RecordCoding[]
  createdAt     DateTime       @default(now())

  @@unique([labId, system, code])
  @@index([labId, system])
}

// A code assigned to a specific record.
model RecordCoding {
  id       String      @id @default(cuid())
  labId    String
  lab      Lab         @relation(fields: [labId], references: [id])
  recordId String
  record   Record      @relation(fields: [recordId], references: [id], onDelete: Cascade)
  codeId   String
  code     MedicalCode @relation(fields: [codeId], references: [id])
  codeType CodingType

  assignedById String?
  assignedBy   User?    @relation(fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())
  notes        String?

  @@unique([recordId, codeId])
  @@index([recordId])
  @@index([labId])
}

// ─── HL7 / FHIR Integration (Tier 5 — Enterprise) ────────────────────────────
// Send authorized results to hospital EMRs as FHIR R4 DiagnosticReport
// resources. Sandbox endpoints build + store the payload without POSTing.
enum EMRSystem {
  Epic
  Cerner
  Meditech
  Allscripts
  Generic
}

enum FHIRAuthType {
  Bearer
  OAuth2
  APIKey
  None
}

enum TransmissionStatus {
  Pending
  Sending
  Success
  Failed
  Retrying
}

model FHIREndpoint {
  id           String       @id @default(cuid())
  labId        String
  lab          Lab          @relation(fields: [labId], references: [id])
  name         String
  baseUrl      String
  system       EMRSystem    @default(Epic)
  authType     FHIRAuthType @default(Bearer)
  authToken    String? // encrypt in production
  clientId     String?
  clientSecret String?
  isActive     Boolean      @default(true)
  isSandbox    Boolean      @default(true)

  lastTestedAt   DateTime?
  lastTestStatus String?

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  transmissions FHIRTransmission[]

  @@unique([labId, name])
  @@index([labId])
}

model FHIRTransmission {
  id         String       @id @default(cuid())
  labId      String
  lab        Lab          @relation(fields: [labId], references: [id])
  endpointId String
  endpoint   FHIREndpoint @relation(fields: [endpointId], references: [id])
  recordId   String
  record     Record       @relation(fields: [recordId], references: [id], onDelete: Cascade)

  status         TransmissionStatus @default(Pending)
  fhirResourceId String?
  fhirPayload    Json
  responseCode   Int?
  responseBody   String?
  errorMessage   String?
  retryCount     Int                @default(0)
  transmittedAt  DateTime?
  createdAt      DateTime           @default(now())

  @@index([labId, status])
  @@index([recordId])
}

// ─── Tier 6: Workforce Management ─────────────────────────────────────────────
model ClockEvent {
  id         String         @id @default(cuid())
  labId      String
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id])
  type       ClockEventType
  timestamp  DateTime       @default(now())
  method     ClockMethod    @default(Desktop)
  location   String?
  ipAddress  String?
  deviceId   String?
  notes      String?
  editedAt   DateTime?
  editedById String?
  editedBy   User?          @relation("ClockEventEditor", fields: [editedById], references: [id])
  editReason String?
  createdAt  DateTime       @default(now())

  @@index([employeeId, timestamp])
  @@index([labId, timestamp])
}

model Timesheet {
  id            String           @id @default(cuid())
  labId         String
  employeeId    String
  employee      Employee         @relation(fields: [employeeId], references: [id])
  periodStart   DateTime
  periodEnd     DateTime
  status        TimesheetStatus  @default(Draft)
  regularHours  Float            @default(0)
  overtimeHours Float            @default(0)
  totalHours    Float            @default(0)
  submittedAt   DateTime?
  reviewedById  String?
  reviewedBy    User?            @relation("TimesheetReviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  approvedAt    DateTime?
  notes         String?
  entries       TimesheetEntry[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([labId, employeeId, periodStart])
  @@index([labId])
}

model TimesheetEntry {
  id            String    @id @default(cuid())
  timesheetId   String
  timesheet     Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  date          DateTime
  clockIn       DateTime?
  clockOut      DateTime?
  breakMinutes  Int       @default(0)
  regularHours  Float     @default(0)
  overtimeHours Float     @default(0)
  shift         ShiftType @default(Morning)
  notes         String?

  @@index([timesheetId])
}

model Shift {
  id          String            @id @default(cuid())
  labId       String
  name        String
  startTime   String
  endTime     String
  type        ShiftType
  color       String            @default("#4F46E5")
  isActive    Boolean           @default(true)
  assignments ShiftAssignment[]

  @@unique([labId, name])
  @@index([labId])
}

model ShiftAssignment {
  id          String                @id @default(cuid())
  labId       String
  employeeId  String
  employee    Employee              @relation(fields: [employeeId], references: [id])
  shiftId     String
  shift       Shift                 @relation(fields: [shiftId], references: [id])
  date        DateTime
  status      ShiftAssignmentStatus @default(Scheduled)
  notes       String?
  createdById String?

  @@index([employeeId, date])
  @@index([labId, date])
}

enum ClockEventType {
  ClockIn
  ClockOut
  BreakStart
  BreakEnd
  LunchStart
  LunchEnd
}

enum ClockMethod {
  Desktop
  Mobile
  Tablet
  Kiosk
  QRCode
}

enum TimesheetStatus {
  Draft
  Submitted
  UnderReview
  Approved
  Rejected
  PayrollLocked
}

enum ShiftType {
  Morning
  Evening
  Night
  Weekend
  Holiday
}

enum ShiftAssignmentStatus {
  Scheduled
  Confirmed
  Completed
  Absent
  Late
}
