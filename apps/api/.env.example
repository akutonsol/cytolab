# --- App ---
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# --- Database ---
# Development (no SSL required locally)
DATABASE_URL=postgresql://cytolab:cytolab@localhost:5432/cytolab?schema=public

# Production (SSL REQUIRED — the API fails hard on boot without sslmode=require):
# DATABASE_URL="postgresql://cytolab_api:STRONG_PASSWORD@your-host:5432/cytolab?sslmode=require"
# DATABASE_MIGRATION_URL="postgresql://cytolab_migrate:STRONG_PASSWORD@your-host:5432/cytolab?sslmode=require"

# Separate migration URL used by `prisma migrate deploy` (privileged cytolab_migrate
# user). In dev it can point at the same connection as DATABASE_URL.
DATABASE_MIGRATION_URL=postgresql://cytolab:cytolab@localhost:5432/cytolab?schema=public

# --- Auth (staff) ---
# JWT_SECRET and JWT_PORTAL_SECRET MUST be at least 32 characters (≥256-bit when
# random). The API fails hard on boot if either is shorter. Generate with:
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production-min-32-chars-openssl-rand-hex-32
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# --- PHI encryption (REQUIRED) ---
# 32-byte AES-256-GCM key as 64 hex chars. The API fails hard on boot if this is
# missing or malformed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this key requires a decrypt-with-old / re-encrypt-with-new pass — do
# NOT change it in place. See docs/SECURITY.md.
ENCRYPTION_KEY=

# --- Session / cookie policy ---
SESSION_IDLE_MINUTES=15
SESSION_MAX_HOURS=12
# Force the Secure flag on auth cookies (auto-on when NODE_ENV=production).
COOKIE_SECURE=false
# CORS allow-list (comma-separated). Credentialed CORS is restricted to these
# origins — never reflect arbitrary origins in production. Defaults to the local
# web app if unset.
ALLOWED_ORIGINS=http://localhost:3000

# --- Auth (client portal — SEPARATE secrets so a portal token can never be
#     verified against staff endpoints, and vice versa) ---
# Minimum 32 characters (see JWT_SECRET note above) — API fails hard on boot if
# shorter. Protects external client/consultant access to PHI. openssl rand -hex 32
JWT_PORTAL_SECRET=change-me-portal-min-32-chars-openssl-rand-hex-32
JWT_PORTAL_EXPIRES_IN=15m
JWT_PORTAL_REFRESH_SECRET=change-me-portal-too
JWT_PORTAL_REFRESH_EXPIRES_IN=7d
# Base URL of the client portal web app (for invite / password-reset links).
PORTAL_WEB_URL=http://localhost:3001

# --- Redis (sessions/cache, optional in dev) ---
REDIS_URL=redis://localhost:6379

# --- Mail (dev uses MailHog from docker-compose) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@cytolab.local

# --- F4 AI-assisted reporting (optional; feature is off per-lab by default) ---
# Anthropic API key. If unset, AI assist is unavailable and the workflow proceeds
# unaffected (graceful degradation). Never commit a real key.
ANTHROPIC_API_KEY=

# --- Google Sheets Backup ---
# Sheet ID from the URL:
# docs.google.com/spreadsheets/d/{SHEET_ID}/edit
# If unset, the backup service is disabled (POST /system/backup returns skipped).
BACKUP_SHEET_ID=

# For local development only (GCP uses Application Default Credentials).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Google Cloud Storage (Phase 6) ---
# Create a GCS bucket and set this to enable cloud file storage.
# Without this, files are stored as base64 in the database.
STORAGE_BUCKET=
