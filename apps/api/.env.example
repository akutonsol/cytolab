# --- App ---
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# --- Database ---
DATABASE_URL=postgresql://cytolab:cytolab@localhost:5432/cytolab?schema=public

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# --- Redis (sessions/cache, optional in dev) ---
REDIS_URL=redis://localhost:6379

# --- Mail (dev uses MailHog from docker-compose) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@cytolab.local
