# --- App ---
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# --- Database ---
DATABASE_URL=postgresql://cytolab:cytolab@localhost:5432/cytolab?schema=public

# --- Auth (staff) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d

# --- Auth (client portal — SEPARATE secrets so a portal token can never be
#     verified against staff endpoints, and vice versa) ---
JWT_PORTAL_SECRET=change-me-portal
JWT_PORTAL_EXPIRES_IN=15m
JWT_PORTAL_REFRESH_SECRET=change-me-portal-too
JWT_PORTAL_REFRESH_EXPIRES_IN=7d
# Base URL of the client portal web app (for invite / password-reset links).
PORTAL_WEB_URL=http://localhost:3001

# --- Redis (sessions/cache, optional in dev) ---
REDIS_URL=redis://localhost:6379

# --- Mail (dev uses MailHog from docker-compose) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@cytolab.local

# --- F4 AI-assisted reporting (optional; feature is off per-lab by default) ---
# Anthropic API key. If unset, AI assist is unavailable and the workflow proceeds
# unaffected (graceful degradation). Never commit a real key.
ANTHROPIC_API_KEY=
